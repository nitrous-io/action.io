#!/bin/bash
#
# This deploys the application to heroku and run necessary migration stuffs

[ -n "$DEBUG" ] && set -o xtrace
set -o errexit
shopt -s nullglob

NO_COLOR="\x1b[0m"
OK_COLOR="\x1b[32;01m"
ERROR_COLOR="\x1b[31;01m"
WARN_COLOR="\x1b[33;01m"

ENV=$1
if [[ $ENV ]]; then
  if [ "$ENV" == "production" ]; then
    REMOTE="production"
    APP="action"
  elif [ "$ENV" == "staging" ]; then
    REMOTE="production"
    APP="action-staging"
  else
    echo -e "${ERROR_COLOR}--> INVALID ENV: $ENV!............${NO_COLOR}"
    exit 1
  fi
else
  REMOTE="production"
  APP="action"
fi

# get the parent directory of where this script is
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ] ; do SOURCE="$(readlink "$SOURCE")"; done
DIR="$( cd -P "$( dirname "$SOURCE" )/.." && pwd )"

# Change into that directory
cd $DIR

# if an argument is defined, we only accept --no-tag and do an early exit if
# encounter anything else
echo -e "${OK_COLOR}--> ADDING GIT TAG!............${NO_COLOR}"
TAG=`date +"%d%m%Y%H%M%S"`
USER=`git config user.name`.chomp
MSG="${USER} BUILT VERSION ${TAG} OF NITROUS.IO"

echo -e "${OK_COLOR}--> CHECKING NEW TAG TO GIT ${TAG}${NO_COLOR}"
git tag -m "${MSG}" ${TAG}
echo -e "${OK_COLOR}--> PUSHING NEW TAG TO GIT ${TAG}${NO_COLOR}"
git push origin ${TAG}

echo -e "${OK_COLOR}--> DEPLOY!............${NO_COLOR}"
git push -f $REMOTE master

echo -e "${OK_COLOR}--> MIGRATE!............${NO_COLOR}"
heroku run rake db:migrate -a $APP

echo -e "${OK_COLOR}--> RESTART!............${NO_COLOR}"
heroku restart -a $APP
