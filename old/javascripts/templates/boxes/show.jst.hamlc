#nav
  .main-menu
    %ul.nav(data-bind='foreach: mainMenu.items')
      %li.dropdown
        %a.dropdown-toggle(data-toggle='dropdown')
          %span(data-bind='text: name')
        %ul.dropdown-menu(data-bind='foreach: items')

          / ko if: name() === '---'
          %li.divider
          / /ko
          / ko ifnot: name() === '---'
          %li
            %a(data-bind='attr: { href: href }, click: action' target='_blank')
              %span.pull-right(data-bind='text: keyLabel')
              %span(data-bind='text: name')
          / /ko

  .secondary-nav
    %ul.nav
      %li
        %a.beta-notice(data-bind='click: showBetaNotice')
          Early Private Beta: Please Read Me
      %li
        %a(href='#boxes')
          Boxes
      %li
        %a(href='#' data-bind='click: comingSoon')
          Public Keys
      %li.dropdown
        %a.dropdown-toggle(data-toggle='dropdown')
          %span(data-bind='text: currentUser.username')
          %span.caret
        %ul.dropdown-menu
          %li
            %a(data-bind='click: comingSoon') Account
          %li.divider
          %li
            %a(href='/users/sign_out' data-method='delete' rel='nofollow')
              Sign Out
#screen
  #content

    / ko with: editor
    %header
      .tabs
        %ul(data-bind='foreach: tabs')
          %li(data-bind='css: { active: active }')
            %a(data-bind='click: $parent.activateTab')
              .close_tab_button.icon-remove(data-bind='click: $parent.closeTab, clickBubble: false')
              %span(data-bind='text: title')
        .new_tab_button.btn.icon-plus(data-bind='click: newDocument')

    .editors

      / ko foreach: tabs
      .editor(data-bind='css: { active: active }')
        .btn-toolbar
          .btn-group
            %button.btn(data-bind='click: saveFile, attr: { disabled: !$root.fsSocketReady() || (fileVM && fileVM.loading() > 0) }')
              %i.icon-download-alt
              Save
          .btn-group
            %button.btn(data-bind='click: $root.comingSoon')
              %i.icon-search
              Find
          .btn-group
            %button.btn.dropdown-toggle(data-toggle='dropdown')
              %span(data-bind='text: CodeMirror.MODES[mode()]')
              %span.caret
            %ul.dropdown-menu(data-bind='foreach: CodeMirror.MODES_ARRAY')
              %li
                %a(data-bind='click: $parent.setMode')
                  %i(data-bind='css: { "icon-": $parent.mode() !== mode, "icon-ok": $parent.mode() === mode }')
                  %span(data-bind='text: name')

          .btn-group
            %button.btn.dropdown-toggle(data-toggle='dropdown')
              %span(data-bind='text: softTabs() ? "Soft Tabs:" : "Tab Size:"')
              %span(data-bind='text: tabSize')
              %span.caret
            %ul.dropdown-menu

              / ko foreach: [2, 3, 4, 8]
              %li
                %a(data-bind='click: $parent.setTabSize')
                  %i(data-bind='css: { "icon-": $parent.tabSize() !== $data, "icon-ok": $parent.tabSize() === $data }')
                  %span(data-bind='text: $data')
              / /ko

              %li.divider
              %li
                %a(data-bind='click: toggleSoftTabs')
                  %i(data-bind='css: { "icon-": !softTabs(), "icon-ok": softTabs() }')
                  Soft Tabs (Spaces)
        .document(data-bind='attr: { id: elementId }')
      / /ko
    / /ko

  #sidebar_wrapper
    #sidebar
      #sidebar_border
      .top.toolbar
        %input.path(type='text' value='~')
        .btn-group
          %button.btn(title='Change Tree Root' data-bind='click: comingSoon')
            %i.icon-folder-open
          %button.btn(title='Refresh Tree' data-bind='click: rootFile.refreshTree')
            %i.icon-refresh
      .tree
        %script(type='text/html' id='file-template')
          %li
            %a(data-bind='click: openFile')

              / ko if: directory
              /   ko if: expanded
              %i.icon-caret-down
              /   /ko
              /   ko ifnot: expanded
              %i.icon-caret-right
              /   /ko
              / /ko
              / ko ifnot: directory
              %i.icon-
              / /ko

              %span(data-bind='text: relativePath, css: { loading: loading() > 0 }')

            / ko if: expanded
            %ul(data-bind='template: { name: "file-template", foreach: files }')
            / /ko

        %ul(data-bind='template: { name: "file-template", data: rootFile }')
      .bottom.toolbar.btn-toolbar
        %button.btn(data-bind='click: comingSoon')
          %i.icon-upload
          Upload Files
        %button.btn(data-bind='click: comingSoon')
          %i.icon-eye-open
          Show Hidden

  #console(data-bind='css: { fullscreen: console.fullscreen }')

    / ko with: console
    #console_border
    %header
      .tabs
        %ul(data-bind='foreach: tabs')
          %li(data-bind='css: { active: active }')
            %a(data-bind='click: $parent.activateTab')
              .close_tab_button.icon-remove(data-bind='click: $parent.closeTab, clickBubble: false')
              %span(data-bind='text: title')
        .new_tab_button.btn.icon-plus(data-bind='click: newTerminal')
        .fullscreen_button.btn.icon-fullscreen(data-bind='click: toggleFullscreen')
    #terminal

      / ko foreach: tabs
      %div(data-bind='css: { active: active }')
        %iframe(scrolling='no' data-bind='attr: { src: "/boxes/" + id() + "/terminal" }')
      / /ko
    / /ko

#save_dialog.modal.hide.fade
  .modal-header
    %button.close(data-bind='click: saveDialog.hide') &#215;
    %h3 Save File
  .modal-body
    .form-horizontal
      .control-group(data-bind='css: { error: saveDialog.errorMessage }')
        %label.control-label(for='save_path')
          Path:
        .controls
          %span.help-inline \~/
          %input#save_path(type='text' placeholder='foo/bar.rb' data-bind='value: saveDialog.path')
          %span.help-inline.throbber.darkbg(data-bind='visible: saveDialog.saving')
          %span.help-inline(data-bind='text: saveDialog.errorMessage')
  .modal-footer
    %button.btn(data-bind='click: saveDialog.hide') Cancel
    %button.btn(data-bind='click: saveDialog.save, disable: saveDialog.saving') Save

#beta_notice.modal.hide.fade
  .modal-header
    %button.close(data-dismiss='modal') &#215;
    %h3 Thanks For Joining Our Early Private Beta
  .modal-body
    %p Please keep the following in mind:
    %ol
      %li You are using a super early beta. Many features are still unimplemented.
      %li Action.IO is not yet production ready. Do not rely on it for mission-critical tasks.
      %li Expect data-loss. Always keep a backup of all your work.
      %li Resource usage is not capped for this beta, please refrain from abusing your account.
      %li
        Visit
        %a.link(href='http://help.action.io/') http://help.action.io/
        or email us at
        %a.link(href='mailto:help@action.io') help@action.io
        for bug reports, feature requests and other feedback.
  .modal-footer
    %button.btn(data-dismiss='modal') Okay

!= JST['templates/partials/alert_dialog']()

