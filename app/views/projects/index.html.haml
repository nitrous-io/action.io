- content_for :page_script do
  :coffeescript
    window.WebFontConfig =
      google:
        families: [ 'Open+Sans:400,300,700:latin' ]

  %script(src='https://ajax.googleapis.com/ajax/libs/webfont/1/webfont.js' type='text/javascript' async='true')

.container
  %h1
    CREATE NEW BOX

  %ul#projects
    %li.selected
      %a(href='#')
        %img{src: image_path("rubyonrails.png"), alt: 'Ruby/Rails'}
        Ruby/Rails 
    %li
      %a(href='#') 
        %img{src: image_path("python-django.png"), alt: 'Python/Django'}
        Python/Django
    %li 
      %a(href='#')
        %img{src: image_path("nodejs.png"), alt: 'Node.js'}
        Node.js
    %li
      %a(href='#') 
        %img{src: image_path("lightning163.png"), alt: 'Vanilla'}
        Vanilla

  #project-details
    %form.form-inline
      %fieldset
        .control-group
          %label.control-label(for='box_name') Name
          .controls
            %input(type='text' id='box_name' name='name')
        .control-group
          %label.control-label(for='box_region_id') Region
          .controls
            %select(id='box_region_id' name='region_id')
              - for region in @regions
                %option{ value: region.id }
                  = region.description
        .control-group
          .controls
            %button.submit.btn Create Box
