= content_for :page_script do
  :coffeescript
    aio.app.rootRouter = new aio.routers.ConsoleRouter
      boxes: #{@boxes.to_json}
      boxTemplates: #{@box_templates.to_json}
      regions: #{@regions.to_json}
      publicKeys: #{@public_keys.to_json}
      userId: #{current_user.id}
    Backbone.history.start()

