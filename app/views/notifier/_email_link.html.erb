<table style="border-style:hidden;margin-bottom:0;width: 100%;font-family: 'Helvetica Neue', Arial, Helvetica, serif;">
  <tr style="text-align:center; padding-bottom: 0px">
    <td style="width:100%;height:50px;vertical-align:top;padding-left:17px; padding-top: 10px;">
      <a href="<%= url -%>" style="font-size: 15px; text-decoration: none; color: rgba(0,0,0,.8); -webkit-transition: color .2s ease;">
        <table class="button" cellspacing="0" border="0" align="center" cellpadding="0" style="padding: 10px;">
          <tr>
            <td style="-webkit-border-radius: 2px;-moz-border-radius: 2px; border-radius: 2px; font-size: 14px; text-shadow: white 0 1px 0px;  border: 1px solid #ccc; background-color: #eee; color: #333; text-decoration: none; padding: 6px 10px 5px; text-align: center;">
              <%= text -%>
            </td>
          </tr>
        </table>
      </a>
    </td>
  </tr>
</table>
