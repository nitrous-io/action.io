<table style="border-style:hidden;margin-bottom:0;width: 100%;font-family: 'Helvetica Neue', Arial, Helvetica, serif;">
  <tr style="text-align:center; padding-bottom: 0px">
    <td style="width:100%;height:50px;vertical-align:top;padding-left:17px; padding-top: 10px;">
      <table class="button" cellspacing="0" border="0" align="center" cellpadding="0" style="padding: 10px;">
        <tr>
          <td>
            <a style="-webkit-border-radius: 2px; -moz-border-radius: 2px; -ms-border-radius: 2px; border-radius: 2px; font-size: 15px; text-shadow: white 0 1px 0px; border: 1px solid #ccc; background-color: #eee; color: #888; text-decoration: none; padding: 6px 10px 5px; text-align: center; -webkit-transition: color .2s ease; -moz-transition: color .2s ease; -ms-transition: color .2s ease; transition: color .2 ease;" href="<%= url -%>">
              <%= text -%>
            </a>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
