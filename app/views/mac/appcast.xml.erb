<?xml version="1.0" encoding="UTF-8"?>
<rss xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle" xmlns:dc="http://purl.org/dc/elements/1.1/" version="2.0">
  <channel>
    <title>Action.IO for Mac</title>
    <link><%= mac_appcast_url(format: 'xml') %></link>
    <language>en</language>
    <%- @mac_app_updates.each do |mac_app_update| %>
      <item>
        <title><%= mac_app_update.title %></title>
        <pubDate><%= mac_app_update.published_at %></pubDate>
        <sparkle:releaseNotesLink><%= mac_release_notes_url(version: mac_app_update.version) %></sparkle:releaseNotesLink>
        <enclosure url="<%= mac_app_update.url %>" sparkle:version="<%= mac_app_update.version %>" length="<%= mac_app_update.file_size %>" type="application/octet-stream" />
      </item>
    <%- end %>
  </channel>
</rss>
