.mast#desc
  .mast-container
    %p
      This is
      %strong Beta
      software. Please remember to backup your work regularly.

.mast#hero
  .mast-container
    .meta
      .title-area
        %h1 Action.IO for Mac
        %p.tagline Cloud Coding on Solid Ground.

      %a.btn.btn-primary.btn-large{ href: "https://s3.amazonaws.com/action-mac/Action.IO-Mac-0.1.2.zip" }
        %span.licon
          %i.icon-download-alt
        Free Download

    .mba
      #mbaimage
        =image_tag 'mba.png', width: "500"

.mast#features
  .mast-container
    %ul
      %li
        %i.icon-folder-open-alt.icon-4x
        %h5 Local File-System
        %p
          Use your local file system to edit code. This means you can use your favorite code editor like
          %a(href='http://www.sublimetext.com/' class='link') Sublime Text
          or&nbsp;
          %a(href='http://macromates.com/' class='link')><
            TextMate
          \.
      %li
        %i.icon-cloud-upload.icon-4x
        %h5 Box Management
        %p Manage your boxes from your Mac's menubar. Start, stop, and terminate boxes with ease.
      %li
        %i.icon-search.icon-4x
        %h5 Cloud Preview
        %p Setup tunnelling to your box to expose services like web servers, so you can preview your application development.

.copyright
