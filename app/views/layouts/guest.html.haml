- @html_class = 'guest'
= render 'layouts/head'
%body
  .container
    %header#page-header
      .header-logo
      %h1
        = link_to 'action.io', root_path
      %ul.header-nav
        %li
          = link_to 'Twitter' , 'http://twitter.com/actionio'
        %li
          = link_to 'GitHub', 'http://github.com/actionio'
        %li
          = link_to 'AngelList', 'http://angel.co/action-io'
        %li.sign-in
          = link_to 'Sign In', new_user_session_path, class: "btn"
    %hr
  .container#body
    .row#flash
      .span12
        = render partial: 'layouts/flash', locals: { flash: flash }
    = yield

  = render 'layouts/footer_guest'
  = render 'layouts/scripts'
