- @html_class = 'guest'
= render 'layouts/head'
%body.gbody
  .container#ft-header
    .row
      .span3
        =image_tag 'lightning200.png', :width => 24, :class => "logo"
        %h3.logo=link_to 'action.io', '/'
      .span6.offset3
        %ul#ft-nav
          %li
            = link_to 'Management Console' , console_path
          %li
            = link_to 'Documentation', ''
          %li
            = link_to 'Help & Support', ''
          %li.signin
            = link_to 'Signin', '', :class => "btn"
  .container#body
    = yield

  .container
    = render 'layouts/footer'