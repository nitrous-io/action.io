- @html_class = 'guest'
- no_nav = false unless defined? no_nav
- no_footer = false unless defined? no_footer
= render layout: 'layouts/html5' do
  = render 'layouts/head'
  %body
    .container
      %header#page-header
        %h1.logo
          %a(href='https://lite.nitrous.io/')<
            Nitrous
        - unless no_nav
          .header-nav
            %ul
              %li
                = link_to 'Desktop', desktop_path
              %li
                = link_to 'Pricing', pricing_path
              %li
                = link_to  'Support', 'http://help.nitrous.io/'
              %li.sign-in
                - if user_signed_in?
                  = link_to 'Open Dashboard', web_app_path, class: 'btn'
                - else
                  = link_to 'Sign In', new_user_session_path, class: 'btn'

      %hr#header-bottom

    .container#body
      - if flash.any?
        .row#flash
          .span12
            = render partial: 'layouts/flash', locals: { flash: flash }
      = yield

    - unless no_footer
      = render 'layouts/footer_guest'
    = render 'layouts/scripts'
