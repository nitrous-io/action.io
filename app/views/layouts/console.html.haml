- @html_class = 'console'
= render 'layouts/head'

%body#console
  .container-fluid
    .row-fluid#flash
      = render partial: 'layouts/flash', locals: { flash: flash }
    .row-fluid#console-nav
      #logo
        =image_tag 'lightning200.png', :width => 24, :class => "logo"
        %h3.logo=link_to 'action.io', '/'
      #console-actions
        %ul.nav.pull-right
          - if user_signed_in?
            %li.dropdown
              %a.dropdown-toggle.btn{ href: '#', 'data-toggle' => 'dropdown' }
                = current_user.username
                %b.caret
              %ul.dropdown-menu
                %li
                  = link_to 'Settings', '#'
                %li
                  = link_to 'Help', '#'
                %li.divider
                %li
                  = link_to 'Sign out', destroy_user_session_path, method: 'delete'
        .btn-toolbar
          .btn-group
            %a.btn{ :href => "#" }
              %i.icon-refresh
              Refresh
            %a.btn{ :href => "#" }
              %i.icon-th-list
              List Boxes
            %a.btn{ :href => "#" }
              %i.icon-folder-close
              Boxes

    .row-fluid#page_content
      = yield

  .container-fluid
    = render 'layouts/footer'
