#new-header.mast
  .mast-container
    %ul#topnav
      %li
        = link_to 'Desktop', desktop_path
      %li
        = link_to 'Pricing', pricing_path
      %li
        = link_to 'Support', 'http://help.nitrous.io/'
      %li
        - if user_signed_in?
          = link_to "Signed in as #{current_user.username}", web_app_path
          %a(href='/users/sign_out' data-method='delete' rel='nofollow')
            (Not you?)
        - else
          = link_to 'Sign In', new_user_session_path, class: 'btn'

    %h1#logo
      %a{ href: "/" }<
        Nitrous
