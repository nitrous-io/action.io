- @html_class = 'bare'
= render 'layouts/head'
%body.bare
  .bare-container
    #bare-header
      #logo-container
        =link_to image_tag('lightning128.png', :width => 50, :class => "logo"), "/"

  .bare-container
    #bare-body
      - if flash.any?
        - flash.each do |type, message|
          .alert.fade.in(class="alert-#{type}")
            = message
      - else
        %header.page-header
          %h2= @page_header

      = yield

  .bare-container
    .footer-links
      = yield :bare_links
  = render 'layouts/scripts'
