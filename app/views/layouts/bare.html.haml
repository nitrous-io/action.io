- @html_class = 'bare'
= render 'layouts/head'
%body.bare
  .bare-container
    #bare-header
      #logo-container
        =image_tag 'lightning200.png', :width => 32, :class => "logo"
        %h1.logo=link_to 'action.io', '/'

  .bare-container
    #bare-body
      - if flash.any?
        - flash.each do |type, message|
          .alert.fade.in(class="alert-#{type}")
            = message
      - else
        %header.page-header
          %h4= @page_header

      = yield

  .bare-container
    .footer-links
      = yield :bare_links
  = render 'layouts/scripts'
