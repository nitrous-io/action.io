- @html_class ||= 'bare'
= render layout: 'layouts/html5' do
  = render 'layouts/head'
  %body.bare
    = render partial: 'layouts/flash', locals: { flash: flash }

    .page
      .bare-container
        #bare-header
          =link_to root_url do
            %h1.logo<
              Nitrous
              %span> .IO

      .bare-container
        #bare-body
          = yield

      .bare-container
        .footer-links
          = yield :bare_links
    = render 'layouts/scripts'
