- @html_class = 'bare'
= render 'layouts/head'
%body.bare
  .bare-container
    #bare-header
      #logo-container
        =image_tag 'lightning200.png', :width => 32, :class => "logo"
        %h1.logo=link_to 'action.io', '/'

  .bare-container
    #bare-body
      = yield

  .bare-container
    .footer-links
      = yield :bare_links
  =#render 'layouts/footer'
