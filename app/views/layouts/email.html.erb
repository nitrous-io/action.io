<%=
  # Yahoo Link color fix: Simply override the styling color and decoration inline.

  # Gmail/Hotmail image display fix: Gmail and Hotmail unwantedly adds in an extra space below images when using non IE browsers.  This can be especially painful when you putting images on top of each other or putting back together an image you spliced for formatting reasons.  Either way, you can add 'style="display: block;"' to remove that space below the image.

%>
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN"
    "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">

<html xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
  <title><%= @title %></title>
  <style type="text/css">
    .yshortcuts, .yshortcuts a, .yshortcuts a:link,.yshortcuts a:visited, .yshortcuts a:hover, .yshortcuts a span { color: black; text-decoration: none !important; border-bottom: none !important; background: none !important;}

    a:hover { color: #3f78c6 !important; }
    a.share:hover { color: #ffffff !important; }

    a:active .button td { background-color: #bbb !important; }
    /* Not to be inlined */
    @media only screen and (max-device-width: 480px) {
      .page {
        width: 280px !important;
      }

      #backgroundTable {
        padding: 5px !important;
      }
      body {
        padding: 12px !important;
      }
      .header {
        font-size: 20px !important;
      }
      .headline {
        font-size: 24px !important;
      }
      .image {
        width: 260px;
      }
      .thumbnail {
        width: 50px;
      }
    }
  </style>
</head>

<body style="margin: 0; color: #222; background: #e5e5e5; padding: 20px;">

  <span style="display: none;"><%= @summary_text %></span>

    <div class="page" style="width: 724px; margin: 0 auto;">

      <table cellpadding="0" cellspacing="0" border="0" style="margin-bottom: 5px; width: 100%; font: 12px/18px Helvetica, sans-serif;">
        <tr>
          <td style="width:65%;">&nbsp;</td>
          <td style="text-align: right; padding-right: 20px; color: #aaa;">
            <a href="mailto:hello@action.io" style="color:#aaa; font-size: 9px; margin-bottom: 2px;">hello@action.io</a>
          </td>
        </tr>
      </table>

      <table cellpadding="0" cellspacing="0" border="0" id="backgroundTable" style="-webkit-border-radius: 1px; -webkit-box-shadow: rgba(0,0,0,0.2) 0 3px 7px; -moz-border-radius: 1px; -moz-box-shadow: rgba(0,0,0,0.2) 0 3px 7px; border-radius: 1px; box-shadow: rgba(0,0,0,0.2) 0 3px 7px; clear: both; margin: 0px; background: white; border: 1px solid #aaa; font: 12px/16px Helvetica, sans-serif; padding: 20px 20px 10px; width: 100%;">
      <tr>
      <td>

      <table cellpadding="0" cellspacing="0" border="0" width="100%">
        <tr>
          <td style="padding-left:10px;">
            <img src="http://assets.action.io/images/actionio-logo.png" alt="Action.IO" />
        </tr>
        <tr>
          <td>
            <table cellpadding="10" border="0" style="margin:0; width: 100%;" width="100%">
              <tr>
                <td>
                  <%= yield %>
                <td>
              </tr>
            </table>
          </td>
        </tr>
      </table>

      </td>
      </tr>
      </table>

      <table cellpadding="0" border="0" width="100%" style="margin-top: 5px; width: 100%; color: #999; font: 9px/12px Helvetica, sans-serif;">
        <tr>
          <td>
            <p style="color:#999; font: 9px/12px Helvetica, sans-serif;padding: 0; margin: .5em 0;font-size: 10px;line-height: 12px;">You received this email because you registered with <a href="http://www.action.io" style="color:#999;">Action.IO</a>.</p>
            <p style="color:#999; font: 9px/12px Helvetica, sans-serif;padding: 0; margin: .5em 0;font-size: 10px;line-height: 12px;">To ensure delivery to your inbox, please add <a href="mailto:hello@action.io" style="color:#999;">hello@action.io</a> to your address book.</p>
          <td>
        </tr>
      </table>

    </div>
  </body>
</html>