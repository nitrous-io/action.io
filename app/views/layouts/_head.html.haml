%head
  %meta(charset='utf-8')
  %title
    Action.IO
  %meta(name='viewport'    content='width=device-width, initial-scale=1.0')
  %meta(name='description' content='Action.IO is a cloud-based development environment platform with a web-based IDE and cloud VMs, and supports Ruby, Python, Node.js and more.')
  %meta(name='author'      content='Action.IO')

  /[if lt IE 9]
    = javascript_include_tag 'https://html5shim.googlecode.com/svn/trunk/html5.js'

  = stylesheet_link_tag 'application', media: 'all'

  %link{ rel: 'shortcut icon', type: 'image/x-icon', href: '/favicon.ico' }

  = csrf_meta_tags

  - if Rails.env.production?
    -#google analytics
    :coffeescript
      window._gaq ||= []
      _gaq.push ['_setAccount', 'UA-32750837-1']
      _gaq.push ['_setDomainName', 'action.io']
      _gaq.push ['_trackPageview']

      ga = document.createElement('script')
      ga.type = 'text/javascript'
      ga.async = true
      ga.src = (if document.location.protocol == 'https:' then 'https://ssl' else 'http://www') + '.google-analytics.com/ga.js'
      s = document.getElementsByTagName('script')[0]
      s.parentNode.insertBefore(ga, s)

