%head
  %meta(charset='utf-8')
  %title
    = @page_title || 'Nitrous'
  %meta(name='description' content='Nitrous is a cloud-based development environment platform with a web-based IDE and cloud VMs, and supports Ruby, Python, Node.js and more.')
  %meta(name='author'      content='Nitrous')
  - if @meta_keywords.is_a?(Enumerable)
    %meta(name='keywords' content="#{@meta_keywords.join(', ')}")

  - if ENV['CHROME_WEB_STORE_ITEM_ID'].present?
    %link(rel='chrome-webstore-item' href="https://chrome.google.com/webstore/detail/#{ENV['CHROME_WEB_STORE_ITEM_ID']}")

  /[if lt IE 9]
    = javascript_include_tag 'https://html5shim.googlecode.com/svn/trunk/html5.js'

  - if defined?(use_bootstrap3) && use_bootstrap3
    = stylesheet_link_tag 'bootstrap3/application', media: 'all'
  - else
    = stylesheet_link_tag 'application', media: 'all'


  %link{ rel: 'shortcut icon', type: 'image/x-icon', href: '/favicon.ico' }

  = csrf_meta_tags

  - if Rails.env.production?
    -#google analytics
    :coffeescript
      ((i, s, o, g, r, a, m) ->
        i['GoogleAnalyticsObject'] = r
        i[r] = i[r] or ->
          (i[r].q = i[r].q or []).push arguments
          return

        i[r].l = 1 * new Date
        a = s.createElement(o)
        m = s.getElementsByTagName(o)[0]
        a.async = 1
        a.src = g
        m.parentNode.insertBefore a, m
        return
      ) window, document, 'script', '//www.google-analytics.com/analytics.js', 'ga'
      ga 'create', 'UA-32750837-1', 'auto'
    - if user_signed_in?
      :coffeescript
        ga 'set', '&uid', '#{current_user.username}'
    :coffeescript
      ga 'send', 'pageview'

