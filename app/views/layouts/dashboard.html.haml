- @html_class = 'dashboard'
= render 'layouts/head'

%body
  = render partial: 'layouts/flash', locals: { flash: flash }

  .container
    %header#page-header
      .header-logo
      %h1
        = link_to 'action.io', root_path
      %ul.header-nav
        %li
          %a(href='/invites') Invites
        %li
          %a(href='/app#/boxes') Boxes
        %li
          %a(href='/app#/public_keys') Public Keys
        %li.dropdown
          %a.dropdown-toggle(data-toggle='dropdown')
            %span= current_user.username
            %span.caret
          %ul.dropdown-menu
            %li
              = link_to 'Account Settings', edit_user_registration_path
            %li
              = link_to 'Applications', oauth_authorized_applications_path
            %li
              %a(href='/users/sign_out' data-method='delete' rel='nofollow')
                Sign Out
    %hr
    = yield
  = render 'layouts/scripts'

