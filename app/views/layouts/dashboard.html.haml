- @html_class = 'dashboard'
= render layout: 'layouts/html5' do
  = render 'layouts/head'

  %body
    = render partial: 'layouts/flash', locals: { flash: flash }

    .container
      %header#page-header
        .header-logo
        %h1
          %a(href='/')<
            Nitrous
        .header-nav
          %ul
            %li
              %a(href='/app#/invites') Invites
            %li
              %a(href='/app#/boxes') Boxes
            %li
              %a(href='/app#/public_keys') Public Keys
            %li.dropdown
              %a.dropdown-toggle(data-toggle='dropdown')
                %span Help
                %span.caret
              %ul.dropdown-menu
                %li
                  %a(href='http://help.nitrous.io/' target='_blank') Help Center
                %li
                  %a(href='http://help.nitrous.io/categories/faq' target='_blank') Frequently Asked Questions
                %li.divider
                %li
                  %a(href='http://blog.nitrous.io/' target='_blank') Blog
                %li
                  %a(href='http://updates.nitrous.io/' target='_blank') Updates
                %li.divider
                %li
                  %a(href='mailto:support@nitrous.io?subject=Nitrous%20Feedback' target='_blank') Report an Issue...
            %li.dropdown
              %a.dropdown-toggle(data-toggle='dropdown')
                %span= current_user.username
                %span.caret
              %ul.dropdown-menu
                %li
                  %a(href='/app#/n2o/upgrade') Buy N2O...
                %li
                  %a(href='/app#/n2o/bonus') Get More N2O...
                %li.divider
                %li
                  %a(href='/desktop' target='_blank') Download Desktop App
                %li.divider
                %li
                  %a(href='/embed' target='_blank') Create Hack Button
                %li.divider
                %li
                  %a(href='/app#/account') Account Settings
                %li
                  =link_to 'Applications', oauth_authorized_applications_path
                %li.divider
                %li
                  %a(href='/users/sign_out' data-method='delete' rel='nofollow')
                    Sign Out

      %hr#header-bottom

      = yield
    = render 'layouts/scripts'
