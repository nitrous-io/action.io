!!! 5
%html{ lang: 'en', class: full_controller_action_name }
  %head
    %meta(charset='utf-8')
    %title
      action.io
    %meta(name='viewport'    content='width=device-width, initial-scale=1.0')
    %meta(name='description' content='')
    %meta(name='author'      content='')

    /[if lt IE 9]
      = javascript_include_tag 'http://html5shim.googlecode.com/svn/trunk/html5.js'

    = stylesheet_link_tag 'application', media: 'all'

    %link{ rel: 'shortcut icon', type: 'image/x-icon', href: asset_path('favicon.ico') }
    %link{ rel: 'apple-touch-icon', href: asset_path('icon-apple-57x57.png') }
    %link{ rel: 'apple-touch-icon', sizes: '72x72',   href: asset_path('icon-apple-72x72.png') }
    %link{ rel: 'apple-touch-icon', sizes: '114x114', href: asset_path('icon-apple-114x114.png') }

    = csrf_meta_tags
  %body
    %header.navbar.navbar-fixed-top
      .navbar-inner
        .container
          %h3
            = link_to 'action.io', root_path, class: 'brand'
          %ul.nav
            = nav_li 'Home', root_path
            - if user_signed_in?
              = nav_li 'Console', console_path
          %ul.nav.pull-right
            - if user_signed_in?
              %li.dropdown
                %a.dropdown-toggle{ href: '#', 'data-toggle' => 'dropdown' }
                  = current_user.username
                  %b.caret
                %ul.dropdown-menu
                  %li
                    = link_to 'Settings', '#'
                  %li
                    = link_to 'Help', '#'
                  %li.divider
                  %li
                    = link_to 'Sign out', destroy_user_session_path, method: 'delete'
            - else
              %li.dropdown
                = link_to 'Sign in', new_user_session_path
    - if flash.any?
      .container
        - flash.each do |type, message|
          .alert.fade.in(class="alert-#{type}")
            %a.close(href='#' data-dismiss='alert') &times;
            = message
    #page_content
      = yield
    %footer.footer
      .container
        %p Copyright &copy; 2011 Action.io Inc. All rights reserved.
    #scripts
      = javascript_include_tag 'application'
      :coffeescript
        aio.app.initialize()
      = yield :page_script
    #third_party_scripts


