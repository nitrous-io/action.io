- @html_class = 'dashboard'
= render 'layouts/head'

%body
  .container
    %header#page-header
      .header-logo
      %h1 action.io
      %ul.header-nav
        %li
          Signed in as
          %span
            = current_user.username
          (
          %a.link(href='/users/sign_out' data-method='delete' rel='nofollow')><
            Not you?
          )
    %hr
    = yield
  #scripts
    = javascript_include_tag 'application'
    = yield :page_script
    = render 'layouts/webfont'

