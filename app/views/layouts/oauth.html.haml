- @html_class = 'dashboard'
= render layout: 'layouts/html5' do
  = render 'layouts/head'

  %body
    = render partial: 'layouts/flash', locals: { flash: flash }

    .container
      %header#page-header
        .header-logo
        %h1 nitrous
        %ul.header-nav
          %li
            Signed in as
            %span
              = current_user.username
            (
            %a.link(href='/users/sign_out' data-method='delete' rel='nofollow')><
              Not you?
            )
      %hr#header-bottom
      = yield
    #scripts
      = javascript_include_tag 'application'
      = yield :page_script
      = render 'layouts/webfont'

