#scripts
  = javascript_include_tag 'application'
  :ruby
    js_init_options = {
      environment: Rails.env,
      pusherKey: Pusher.key,
      currentUser: current_user && current_user.serialize_as_hash
    }
  :coffeescript
    aio.app.initialize(#{js_init_options.to_json})
  = yield :page_script

