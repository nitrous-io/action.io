    .container-fluid
      %h1
        %a.brand(href='#') action.io
      .nav-collapse
        .nav
          %li
            = link_to 'Projects', '#'
          %li.active
            = link_to 'Develop', '#'
          %li
            = link_to 'Deploy', '#'
        .nav.pull-right
          %li.dropdown
            = link_to '#', class: 'dropdown-toggle', 'data-toggle' => 'dropdown' do
              = current_user.username
              %span.caret
            %ul.dropdown-menu
              %li
                = link_to 'Settings', '#'
