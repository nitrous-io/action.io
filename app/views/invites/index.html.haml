.container
  .invites{:style => "padding: 20px;"}
    %h1 Invites Dashboard

    %div.sorts{:style => 'padding-top: 20px;'}
      %ul{class: "nav nav-pills dark"}
        %li{class: @filter.blank? ? 'active' : ''}
          = link_to "Pending", invites_path
        %li{class: @filter == 'activated' ? 'active' : ''}
          = link_to "Activated", invites_path(filter: 'activated')
        %li{class: @filter == 'accepted' ? 'active' : ''}
          = link_to "Accepted", invites_path(filter: 'accepted')

    - if @invites.size < 1
      .notice There are no invites to display.
    - else
      %div.total-invites
        %h3{style: 'padding: 10px 0' }= "Total: #{pluralize(@invites.count, 'invite')}"

      %table{class: 'table table-striped'}
        %thead
          %tr
            %td
              Email
            %td
              Referrer Code
            %td
              Country
            %td
              Request IP
            %td
              Created
            %td
              Invite Code

        - @invites.each do |i|
          %tr
            %td= i.email
            %td= i.referrer_code
            %td= i.country
            %td= i.ip
            %td= "#{time_ago_in_words(i.created_at)} ago"
            %td= i.invite_code

      = will_paginate(@invites, renderer: ::BootstrapPagination::Rails)
