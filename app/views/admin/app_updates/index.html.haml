%h1 App Updates

%table.table.table-bordered
  %thead
    %tr
      %th id
      %th platform
      %th version
      %th title
      %th release_notes
      %th url
      %th file_size
      %th published_at
      %th actions
  %tbody
    - @app_updates.each do |app_update|
      %tr
        %td= app_update.id
        %td= app_update.platform
        %td= app_update.version
        %td= app_update.title
        %td= truncate app_update.release_notes, length: 15
        %td= link_to app_update.url
        %td= app_update.file_size
        %td= app_update.published_at
        %td
          = link_to 'Show', admin_app_update_url(app_update), class: 'btn'
          = link_to 'Edit', edit_admin_app_update_url(app_update), class: 'btn'
          = link_to 'Destroy', admin_app_update_url(app_update), method: 'delete', confirm: 'Are you sure you want to destroy this item?', class: 'btn btn-danger'

%p
  = link_to 'New Item', new_admin_app_update_url, class: 'btn btn-primary'
%p
  = link_to 'View Appcast XML for Mac', desktop_app_appcast_url(format: :xml, platform: 'mac'), class: 'btn'
%p
  = link_to 'View Appcast XML for Windows', desktop_app_appcast_url(format: :xml, platform: 'windows'), class: 'btn'

