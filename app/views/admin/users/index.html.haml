- @page_header = "Users Dashboard"

= form_tag admin_users_path, class: 'form-inline', method: 'get' do
  = text_field_tag "identifier", nil, class: "input-large", placeholder: "email, username or box id", autocomplete: "off"
  = submit_tag "Find"

- if @user
  %table.table
    %thead
      %tr
        %th ID
        %th Name
        %th Email
        %th N2O
        %th Status
        %th Actions
        %th Features
    %tbody
      %tr
        %td
          = @user.id
        %td
          = @user.username
        %td
          = @user.email
        %td
          = @user.max_n2o
        %td
          - if @user.banned_at.present?
            %i.icon-ban-circle
            Banned
          - if @user.active_plan.present?
            %i.icon-dollar
            Paid user
        %td
          = link_to 'Login to Account', switch_admin_user_path(@user), method: :post, class: 'btn'
          = link_to 'Fill N2O', fill_n2o_admin_user_path(@user), class: 'btn'
          = link_to 'Edit', edit_admin_user_path(@user), class: 'btn'
          - if @user.banned_at.blank?
            = link_to 'Ban', ban_admin_user_path(@user), method: :post, class: 'btn btn-danger'
        %td
          = link_to @user.private_snapshots_enabled ? 'Disable Snapshots' : 'Enable Snapshots',
              toggle_private_snapshots_admin_user_path(@user),
              method: :post,
              class: 'btn'
