= form_tag action_url, class: 'form-inline', method: 'get' do
  = label_tag :period_start, "From"
  = text_field_tag :period_start,
      @period_start.to_date,
      "data-provide" => "datepicker",
      "data-date-format" => "yyyy-mm-dd",
      "data-date-start-date" => RevenueEvent::START_OF_BILLING,
      "data-date-end-date" => Date.today,
      "data-date-today-btn" => "linked",
      "data-date-autoclose" => true,
      autocomplete: "off"
  = label_tag :period_end, "To"
  = text_field_tag :period_end,
      @period_end.to_date,
      "data-provide" => "datepicker",
      "data-date-format" => "yyyy-mm-dd",
      "data-date-start-date" => RevenueEvent::START_OF_BILLING,
      "data-date-end-date" => Date.today,
      "data-date-today-btn" => "linked",
      "data-date-autoclose" => true,
      autocomplete: "off"
  = submit_tag "Submit"
  = link_to "Previous 30 days", "#{action_url}?period_start=#{30.days.ago(@period_start)}&period_end=#{@period_start}"
