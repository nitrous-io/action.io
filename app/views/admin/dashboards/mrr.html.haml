- @page_header = "MRR Dashboard"

.header
  %ul.nav.nav-pills
    %li.active
      %a(href="/admin/dashboards/mrr")
        MRR
    %li
      %a(href="/admin/dashboards/cashflow")
        Cashflow
    %li
      %a(href="/admin/dashboards/plans")
        Plans

.dashboard
  = render partial: 'form', locals: { action_url: mrr_admin_dashboards_path }

  %table.table
    %tr
      %th
      %th
        %p.text-right
          Committed
      %th
        %p.text-right
          Discounts
      %th
        %p.text-right
          Billed
    %tr
      %th
        Starting MRR
      %td
        %p.text-right
          = as_currency @starting_recurring_revenue
          %br
          = @starting_subscribers
          Subscribers
      %td
      %td

    %tr
      %th
        New Subscriptions
      %td
        %p.text-right
          = as_currency @subscribed_data[:amount]
          %br
          = @subscribed_data[:count]
          New customers *
          = as_currency @subscribed_data[:avg]
          %abbr(title="Avg. Revenue Per Paying User") ARPPU
      %td
        %p.text-right
          = as_currency @discounts_data[:subscribed][:amount]
          %br
          = @discounts_data[:subscribed][:count]
          New customers
      %td
        %p.text-right
          = as_currency(@subscribed_data[:amount] - @discounts_data[:subscribed][:amount])
    %tr
      %th
        Upgrades
      %td
        %p.text-right
          = as_currency @upgraded_data[:amount]
          %br
          = @upgraded_data[:count]
          upgrades *
          = as_currency @upgraded_data[:avg]
          avg. upgrades
      %td
        %p.text-right
          = as_currency @discounts_data[:upgraded][:amount]
          %br
          = @discounts_data[:upgraded][:count]
          Upgrades
      %td
        %p.text-right
          = as_currency(@upgraded_data[:amount] - @discounts_data[:upgraded][:amount])

    %tr.subtract_row
      %th
        Downgrades
      %td
        %p.text-right
          (
          = as_currency @downgraded_data[:amount]
          )
          %br
          = @downgraded_data[:count]
          downgrades *
          = as_currency @downgraded_data[:avg]
          av. downgrades
      %td
        %p.text-right
          (
          = as_currency @discounts_data[:downgraded][:amount]
          )
          %br
          = @discounts_data[:downgraded][:count]
          Downgrades
      %td
        %p.text-right
          (
          = as_currency (@downgraded_data[:amount] - @discounts_data[:downgraded][:amount])
          )

    %tr.subtract_row
      %th
        Cancelations (Churn)
      %td
        %p.text-right
          (
          = as_currency @canceled_data[:amount]
          )

          %br
          = @canceled_data[:count]
          cancellations *
          = as_currency @canceled_data[:avg]
          %abbr(title="Avg. Revenue Per Churned User") ARPCU
      %td
        %p.text-right
          (
          = as_currency @discounts_data[:canceled][:amount]
          )
          %br
          = @discounts_data[:canceled][:count]
          Cancelations
      %td
        %p.text-right
          (
          = as_currency(@canceled_data[:amount] - @discounts_data[:canceled][:amount])
          )

    %tr
      %th
        Recurring Discounts
      %td
      %td
        %p.text-right
          = as_currency @discounts_data[:recurring][:amount]
          %br
          = @discounts_data[:recurring][:count]
          Subscribers
      %td
    %tr
      %th
        Ending MRR
      %td
        %p.text-right
          = as_currency @ending_recurring_revenue
          %br
          = @ending_subscribers
          Subscribers
      %td
        %p.text-right
          = as_currency @discounts_data[:overall][:amount]
          %br
          = @discounts_data[:overall][:count]
          Subscribers

      %td
        %p.text-right
          = as_currency (@ending_recurring_revenue - @discounts_data[:overall][:amount])

  .csv
    %a.btn.btn-success(href="#{mrr_admin_dashboards_path(format: :csv, period_start: @period_start, period_end: @period_end)}")
      Download as CSV (Monthly)

  .footer
    %h4
      Legend
    %ul
      %li Committed MRR - Total monthly revenue expected to be collected from all subscriptions (without discounts or refunds)
      %li Total Billed -  Total value billed within the give period. (includes discounts)
      %li Total Collected - Total value collected within the period (after refunds)


    %h4
      Footnotes
    %ul
      %li "Total Billed" includes users who subscribed and canceled within the given period. That's why "Total Billed" figure can be higher in some months than the "Ending Committed MRR".
      %li "Total Collected" includes charges collected from users who subscribed and canceled within the given period. So "Total Collected" can also be higher in some months than the "Ending Committed MRR".

