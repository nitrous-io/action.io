- @page_header = "MRR Dashboard"

.header
  %ul.nav.nav-pills
    %li.active
      %a(href="/admin/dashboards/mrr")
        MRR
    %li
      %a(href="/admin/dashboards/cashflow")
        Cashflow
    %li
      %a(href="/admin/dashboards/plans")
        Plans Mix

.dashboard
  = render partial: 'period_select', locals: { action_url: mrr_admin_dashboards_path }

  %table.table
    %tr
      %th
      %th
        %p.text-right
          Committed
          %sup 1
      %th
        %p.text-right
          Discounts
          %sup 2
      %th
        %p.text-right
          Billed
          %sup 1 - 2
    %tr
      %th
        Starting MRR
      %td
        %p.text-right
          = as_currency @starting_recurring_revenue
          %br
          = pluralize @starting_subscribers, "subscriber"
      %td
        %p.text-right
          = as_currency @discounts_data[:starting][:amount]
          %br
          = pluralize @discounts_data[:starting][:count], "subscriber"
      %td
        %p.text-right
          = as_currency(@starting_recurring_revenue - @discounts_data[:starting][:amount])

    %tr
      %th
        New Subscriptions
      %td
        %p.text-right
          = as_currency @subscribed_data[:amount]
          %br
          = @subscribed_data[:count]
          New customers *
          = as_currency @subscribed_data[:avg]
          %abbr(title="Avg. Revenue Per Paying User") ARPPU
      %td
        %p.text-right
          = as_currency @discounts_data[:subscribed][:amount]
          %br
          = pluralize @discounts_data[:subscribed][:count], "new customer"
      %td
        %p.text-right
          = as_currency(@subscribed_data[:amount] - @discounts_data[:subscribed][:amount])
    %tr
      %th
        Upgrades
      %td
        %p.text-right
          = as_currency @upgraded_data[:amount]
          %br
          = @upgraded_data[:count]
          upgrades *
          = as_currency @upgraded_data[:avg]
          avg
      %td
        %p.text-right
          = as_currency @discounts_data[:upgraded][:amount]
          %br
          = pluralize @discounts_data[:upgraded][:count], "upgrade"
      %td
        %p.text-right
          = as_currency(@upgraded_data[:amount] - @discounts_data[:upgraded][:amount])

    %tr.subtract_row
      %th
        Downgrades
      %td
        %p.text-right
          (
          = as_currency @downgraded_data[:amount]
          )
          %br
          = @downgraded_data[:count]
          downgrades *
          = as_currency @downgraded_data[:avg]
          avg
      %td
        %p.text-right
          (
          = as_currency @discounts_data[:downgraded][:amount]
          )
          %br
          = pluralize @discounts_data[:downgraded][:count], "downgrade"
      %td
        %p.text-right
          (
          = as_currency (@downgraded_data[:amount] - @discounts_data[:downgraded][:amount])
          )

    %tr.subtract_row
      %th
        Cancelations
      %td
        %p.text-right
          (
          = as_currency @canceled_data[:amount]
          )

          %br
          = @canceled_data[:count]
          cancellations *
          = as_currency @canceled_data[:avg]
          %abbr(title="Avg. Revenue Per Churned User") ARPCU
      %td
        %p.text-right
          (
          = as_currency @discounts_data[:canceled][:amount]
          )
          %br
          = pluralize @discounts_data[:canceled][:count], "cancelation"
      %td
        %p.text-right
          (
          = as_currency(@canceled_data[:amount] - @discounts_data[:canceled][:amount])
          )

    %tr
      %th
        Added Discounts
      %td
      %td
        %p.text-right
          = as_currency @discounts_data[:added][:amount]
          %br
          = @discounts_data[:added][:count]
          added
      %td

    %tr.subtract_row
      %th
        Expired Discounts
      %td
      %td
        %p.text-right
          (
          = as_currency @discounts_data[:expired][:amount]
          )
          %br
          = @discounts_data[:expired][:count]
          expired
      %td

    %tr
      %th
        Ending MRR
      %td
        %p.text-right
          = as_currency @ending_recurring_revenue
          %br
          = pluralize @ending_subscribers, "subscriber"
      %td
        %p.text-right
          = as_currency @discounts_data[:total][:amount]
          %br
          = pluralize @discounts_data[:total][:count], "subscriber"

      %td
        %p.text-right
          = as_currency (@ending_recurring_revenue - @discounts_data[:total][:amount])

  .csv
    = link_to 'Download as CSV', mrr_admin_dashboards_path(format: :csv, period_start: @period_start, period_end: @period_end), class: 'btn'

  .footer
    %h4
      Legend
    %ul
      %li Committed MRR - Gross monthly revenue before discounts or refunds.
      %li Billed MRR - Monthly revenue including discounts.
      %li Added Discounts - Discounts added for existing subscriptions (usually manually applied).
      %li Expired Discounts - Discounts that expired within the period.
