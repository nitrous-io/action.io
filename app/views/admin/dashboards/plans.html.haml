- @page_header = "Plan Mix"

.header
  %ul.nav.nav-pills
    %li
      %a(href="/admin/dashboards/mrr")
        MRR
    %li
      %a(href="/admin/dashboards/cashflow")
        Cashflow
    %li
      %a(href="/admin/dashboards/plans")
        Plans

= render partial: 'form', locals: { action_url: plans_admin_dashboards_path }

%table.table
  %tr
    %th
      Metric
    %td
      %p.text-right
        = "#{@period_start} - #{@period_end}"

  - Plan.all.each do |plan|
    %tr
      %th
        = plan.name
        (
        = as_currency plan.price_in_cents
        )
      %td
        %p.text-right
          = plan.subscriptions_count(@period_start, @period_end)

