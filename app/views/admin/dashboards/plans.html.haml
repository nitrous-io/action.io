- @page_header = "Plan Mix"

.header
  %ul.nav.nav-pills
    %li
      %a(href="/admin/dashboards/mrr")
        MRR
    %li
      %a(href="/admin/dashboards/cashflow")
        Cashflow
    %li.active
      %a(href="/admin/dashboards/plans")
        Plans Mix

%h3
  Plans Mix on
  = @day

= form_tag plans_admin_dashboards_path, class: 'form-inline', method: 'get' do
  = label_tag :day, "Change date:"
  = text_field_tag :day, @day, :"data-provide" => "datepicker", "data-date-format" => "yyyy-mm-dd", "data-date-start-date" => "2013-11-01", "data-date-end-date" => Date.today, autocomplete: "off"
  = submit_tag "Submit"

%table.table.plans
  %tr
    %th Plan Name
    %th Stripe ID
    %th Price
    %th Subscriber Count
  - @current_plans_table.each do |plan, subscriber_count|
    %tr
      %td
        = plan.name
      %td
        = plan.stripe_id
      %td
        = plan.price || 'Unknown'
      %td
        = subscriber_count

- if @archived_plans_table.present?
  %table.table.plans
    %h4 Plans no longer in database (but still in Stripe)
    %tr
      %th Plan Stripe ID
      %th Subscriber Count
    - @archived_plans_table.each do |stripe_id, subscriber_count|
      %tr
        %td
          = stripe_id
        %td
          = subscriber_count
