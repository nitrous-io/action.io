%h1= @coupon.code

%table.table.table-bordered
  %tr
    %th duration
    %td= @coupon.duration
  %tr
    %th percent off
    %td= @coupon.percent_off
  %tr
    %th active
    %td= @coupon.active
  %tr
    %th created at
    %td= @coupon.created_at

= link_to 'Destroy', admin_coupon_url(@coupon), method: 'delete', confirm: 'Are you sure you want to destroy this item?', class: 'btn btn-danger'
= link_to 'Back to List', admin_coupons_url, class: 'btn'
