%h1 New Coupon

= simple_form_for([:admin, @coupon], html: { class: 'form form-horizontal' }) do |f|
  = f.input :code
  = f.input :description, input_html: { placeholder: '3 months free' }
  = f.input :duration, label: 'duration (in months)'
  = f.input :percent_off, label: 'percent off (%)'
  = f.input :active, as: :boolean, input_html: { checked: true }
  .controls
    = f.button :submit, 'Save', class: 'btn btn-success'
    = link_to 'Cancel', admin_coupons_url, class: 'btn'
