%h1 Coupons

%table.table.table-bordered
  %thead
    %tr
      %th code
      %th active
      %th duration (months)
      %th percent off
      %th
  %tbody
    - @coupons.each do |coupon|
      %tr
        %td= coupon.code
        %td= coupon.active
        %td= coupon.duration
        %td= coupon.percent_off
        %td
          - if coupon.active?
            = link_to 'Deactivate', deactivate_admin_coupon_url(coupon), method: 'put', confirm: 'Are you sure you want to deactivate this coupon?', class: 'btn btn-danger'
          - else
            = link_to 'Activate', activate_admin_coupon_url(coupon), method: 'put', class: 'btn btn-danger'
= link_to 'New Coupon', new_admin_coupon_url, class: 'btn btn-primary'
