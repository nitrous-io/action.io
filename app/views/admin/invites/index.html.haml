- @page_header = "Invites Dashboard"

- if @invites.size > 0
  %span.label.dlabel= "Total: #{pluralize(@invites.count, 'invite')}"

.invites
  %div.sorts
    %ul{class: "nav nav-pills dark"}
      %li{class: (@filter.blank? && params[:q].blank?) ? 'active' : ''}
        = link_to "Pending", admin_invites_path
      %li{class: @filter == 'activated' ? 'active' : ''}
        = link_to "Activated", admin_invites_path(filter: 'activated')
      %li{class: @filter == 'accepted' ? 'active' : ''}
        = link_to "Accepted", admin_invites_path(filter: 'accepted')

%form.form.form-inline.dash-search
  %input{ value: "#{params[:q]}", name: "q", class: "input-large", placeholder: "Search Location, e.g. San Francisco, Boston", autocomplete: "off" }
  %button.btn Search

- if params[:q]
  %h4.sq="Showing invites for: \"#{params[:q]}\""

%table{class: 'table table-striped'}
  %thead
    %tr
      %th Email
      %th Referrer Code
      %th Country
      %th Request IP
      %th Created
      %th Invite Code

  - if @invites.size > 0
    - @invites.each do |i|
      %tr
        %td.important
          = i.email
          - if params[:q]
            %span.label{class: "#{i.state}"}= i.state
        %td= i.referrer_code
        %td= i.country
        %td= i.ip
        %td= "#{time_ago_in_words(i.created_at)} ago"
        - unless i.state == 'accepted'
          %td
            - _invite_text = (i.state == 'pending') ? 'Send Invite' : 'Resend Invite'
            = button_to "#{_invite_text}", action: 'send_invite', id: i.id, return_url: request.url
        - else
          %td
            %span.muted invited
  - else
    %tr
      %td{colspan: 6, style: "text-align: center"} There are no invites to display.

= will_paginate(@invites, renderer: ::BootstrapPagination::Rails) if @invites.size > 0
