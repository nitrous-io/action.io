.hero
  %h1
    =@feature['hero_title']
  %h4.subtitle
    =@feature['hero_subtitle']

  %a.btn.btn-success.signup
    =@feature['call_to_action']
    &#8594;

.container

.features
  -@feature['features'].each do |f|
    %article.feature.one
      %img="#{f['img']}"
      .meta
        %h5.title="#{f['title']}"
        .copy
          ="#{f['copy']}"

.cta
  %a.bcta(href="/signup")
    =@feature['call_to_action']
