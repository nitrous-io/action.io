- @page_title = "Join the Nitrous.IO Team"

.container

  %h1.title= @page_title
  .subtitle We&rsquo;re looking for remarkable people to help us change the way the world codes.  We have offices in the heart of Chinatown in Singapore and on Castro Street in Mountain View, California.

  %ul.actions
    %li
      = link_to '&raquo; View Open Job Posts'.html_safe, jobs_path, class: 'btn btn-success'

  %hr

  %article.clearfix
    %ul#team-bios
      - @members.each do |m|
        %li
          %a.tt-info(rel='tooltip' target='_blank' href="http://twitter.com/#{m['twitter']}" data-toggle="tooltip" data-placement="top"){name: m['name'], title: "<em>#{m['name']}</em> #{m['bio']}".html_safe }
            =image_tag "team/#{m['img']}.jpg", title: m['name']

  %hr{style: "margin: 0 0 20px;"}

  #locations-carousel.carousel.slide(data-ride="carousel")
    %ol.carousel-indicators
      %li(data-target="#locations-carousel" data-slide-to="0" class="active")
      %li(data-target="#locations-carousel" data-slide-to="1")
      %li(data-target="#locations-carousel" data-slide-to="2")

    .carousel-inner
      .item.active
        = image_tag 'team/team1.jpg'
      .item
        = image_tag 'team/team2.jpg'
      .item
        = image_tag 'team/team3.jpg'

= content_for :page_script do
  = javascript_include_tag 'pages/team_page'
  :coffeescript
    new AIO.TeamPage()
