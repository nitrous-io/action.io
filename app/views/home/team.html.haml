- @page_title = "Nitrous Team"

.container

  %p.alert
    = "We're looking for remarkable people to help change the way the world codes."
    = link_to '&raquo; See job posts'.html_safe, jobs_path

  %h1.title= @page_title

  %article
    %ul#team-bios
      - @members.each do |m|
        %li
          %a{rel: 'tooltip', name: "#{m['name']}", href: "http://twitter.com/#{m['twitter']}", "data-toggle" => "tooltip", "data-placement" => "top", title: "<em>#{m['name']}</em> #{m['bio']}".html_safe, class: "tt-info", html: true}
            =image_tag "team/#{m['twitter']}.jpeg", title: "#{m['name']}"


= content_for :page_script do
  :coffeescript
    new AIO.TeamPage()
