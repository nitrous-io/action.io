- @page_title = "Join the Nitrous.IO Team"
= render 'page_menu'

.container

  %h1.title= @page_title
  .subtitle We&rsquo;re looking for remarkable people to help us change the way the world codes.  We have offices in the heart of Chinatown in Singapore and in the SOMA district of San Francisco, California.

  %ul.actions
    %li
      = link_to '&raquo; View Open Job Posts'.html_safe, jobs_path, class: 'btn btn-success'

  %hr

  %article.clearfix
    %ul#team-bios
      - @members.each do |m|
        %li
          %a.tt-info(rel='tooltip' target='_blank' href="http://twitter.com/#{m['twitter']}" data-toggle="tooltip" data-placement="top"){name: m['name'], title: "<em>#{m['name']}</em> #{m['bio']}".html_safe }
            =image_tag "team/#{m['img']}.jpg", title: m['name']

  %hr{style: "margin: 0 0 20px;"}

= content_for :page_script do
  = javascript_include_tag 'pages/team-page'
  :coffeescript
    new App.TeamPage()
