- @page_title = "Action Pricing"

#pricing
  .page-title
    %h1 Need a Little More Action?
    .subtitle You can upgrade or downgrade at any time.
  .plan
    .plan-title
      %h2 Starter
    .plan-price
      %h2 Free
      %span.freq Always
    .plan-details
      %ul
        %li Web IDE
        %li SSH Access
        %li Shared Resources
        %li 256MB Memory + 1GB Storage
    .plan-action
      = link_to 'Sign Up', '', class: 'btn btn-action'

  .plan
    .plan-title
      %h2 Basic
    .plan-price
      %h2
        %span.currency $
        TBD
      %span.freq per month
    .plan-details
      %ul
        %li Web IDE
        %li SSH Access
        %li Shared Resources
        %li.mhlite 1GB RAM + 10GB Storage
    .plan-action
      = link_to 'Sign Up', '', class: 'btn btn-action'

  .plan.active
    .plan-title
      %h2 Plus
    .plan-price
      %h2
        %span.currency $
        TBD
      %span.freq per month
    .plan-details
      %ul
        %li Web IDE
        %li SSH Access
        %li.hlite Dedicated Resources
        %li.hlite 1.5GB RAM + 40GB Storage
        %li.hlite Full Root Access
    .plan-action
      = link_to 'Sign Up', '', class: 'btn btn-action'

  .plan
    .plan-title
      %h2 Pro
    .plan-price
      %h2
        %span.currency $
        TBD
      %span.freq per month
    .plan-details
      %ul
        %li Web IDE
        %li SSH Access
        %li.hlite Dedicated Resources
        %li.hlite 3.5GB RAM + 100GB Storage
        %li.hlite Full Root Access
    .plan-action
      = link_to 'Sign Up', '', class: 'btn btn-action'

.plan-footer
  %ul
    %li All plans come with:
    %li.label Email Support
    %li.label SSL Protection
    %li.label Global Availability Zones
  %hr
    #faq-section
      .row
        .span6
          %h3 Is there a setup fee?
          %p No, there are no setup fees on any of our plans.

          %h3 Can I cancel at any time?
          %p Yes, you can cancel at anytime and we will bill you on a pro-rated basis for your development machine usage for that month.

          %h3 Do I need a credit card to signup?
          %p You do not need a credit card to take advantage of our free tier. If you'd like to upgrade to a better computing services, you will need a valid credit card.
        .span6
          %h3 Action Add-ons
          %p Action's 3rd party add-ons extend the Action platform and provide you with convenient services to save you countless hours and insure you from setup and configuration headaches.
          %p
            If you've got a cool service that you think would compliment the Action.IO platform, please don't hesitate to
            = mail_to 'bizdev@action.io', 'bizdev@action.io', encode: 'javascript'
  %hr

  %h1
    More Questions? Contact us anytime at
    = mail_to 'hello@action.io', 'hello@action.io', encode: 'javascript'

