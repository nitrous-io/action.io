- @page_title = "Action Pricing"

#pricing
  .page-title
    %h1 Need a Little More Action?
    .subtitle You can upgrade or downgrade at any time.
  .plan
    .plan-title
      %h2 Free
    .plan-price
      %h2 Free
      %span.freq Always
    .plan-details
      %ul
        %li Web IDE
        %li SSH Access
        %li Shared Database
        %li Shared Dev Instance
    .plan-action
      = link_to 'Sign Up', '', :class => "btn btn-action"

  .plan
    .plan-title
      %h2 Lite
    .plan-price
      %h2
        %span.currency $
        19.99
      %span.freq per month
    .plan-details
      %ul
        %li Web IDE
        %li SSH Access
        %li Shared Database
        %li.mhlite Fast Dev Instance
    .plan-action
      = link_to 'Sign Up', '', :class => "btn btn-action"

  .plan.active
    .plan-title
      %h2 Developer
    .plan-price
      %h2
        %span.currency $
        69.99
      %span.freq per month
    .plan-details
      %ul
        %li Web IDE
        %li SSH Access
        %li.hlite Full Root Access
        %li.hlite Dedicated Database
        %li.hlite 1.7GB EC2 Instance
    .plan-action
      = link_to 'Sign Up', '', :class => "btn btn-action"

  .plan
    .plan-title
      %h2 Org
    .plan-price
      %h2
        %span.currency $
        109.99
      %span.freq per month
    .plan-details
      %ul
        %li Web IDE
        %li Organization Tools
        %li.hlite Full Root Access
        %li.hlite Dedicated Database
        %li.hlite 3.75 GB Dedicated Instance
    .plan-action
      = link_to 'Sign Up', '', :class => "btn btn-action"

.plan-footer
  %ul
    %li All plans come with:
    %li.label Email Support
    %li.label SSL Protection
    %li.label Global Availability Zones

  %h3 Plans &amp; Pricing FAQs

  %hr

  %h1
    More Questions? Contact us anytime at
    = mail_to "hello@action.io", "hello@action.io", :encode => "javascript"

