- @page_title = "Action Pricing"

#pricing
  .page-title
    %h1 Need a Little More Action?
    .subtitle You can upgrade or downgrade at any time.
  .plan
    .plan-title
      %h2 Starter
    .plan-price
      %h2 Free
      %span.freq Always
    .plan-details
      %ul
        %li Web IDE
        %li SSH Access
        %li Shared Resources
        %li 256MB Memory + 1GB Storage
    .plan-action
      = link_to 'Sign Up', '', :class => "btn btn-action"

  .plan
    .plan-title
      %h2 Basic
    .plan-price
      %h2
        %span.currency $
        TBD
      %span.freq per month
    .plan-details
      %ul
        %li Web IDE
        %li SSH Access
        %li Shared Resources
        %li.mhlite 1GB RAM + 10GB Storage
    .plan-action
      = link_to 'Sign Up', '', :class => "btn btn-action"

  .plan.active
    .plan-title
      %h2 Plus
    .plan-price
      %h2
        %span.currency $
        TBD
      %span.freq per month
    .plan-details
      %ul
        %li Web IDE
        %li SSH Access
        %li.hlite Dedicated Resources
        %li.hlite 1.5GB RAM + 40GB Storage
        %li.hlite Full Root Access
    .plan-action
      = link_to 'Sign Up', '', :class => "btn btn-action"

  .plan
    .plan-title
      %h2 Pro
    .plan-price
      %h2
        %span.currency $
        TBD
      %span.freq per month
    .plan-details
      %ul
        %li Web IDE
        %li SSH Access
        %li.hlite Dedicated Resources
        %li.hlite 3.5GB RAM + 100GB Storage
        %li.hlite Full Root Access
    .plan-action
      = link_to 'Sign Up', '', :class => "btn btn-action"

.plan-footer
  %ul
    %li All plans come with:
    %li.label Email Support
    %li.label SSL Protection
    %li.label Global Availability Zones
  %hr
    #faq-section
      = render :partial => 'faq-pricing'
  %hr

  %h1
    More Questions? Contact us anytime at
    = mail_to "hello@action.io", "hello@action.io", :encode => "javascript"

