- @page_title = "Nitrous Pricing"

.page-title
  %h1 Do More, Faster.
  %h2 Supercharge Your Development

#plansContainer
  %ul.plans
    - @plans.each do |plan|
      %li.span3{ class: ('selected' if plan.highlight) }
        %h3
          = plan.name
          - if plan.highlight
            %small Most Popular

        .n2o-amount
          %span.amount= plan.n2o_amount
          N2O

        %ul.plan-features
          %li
            #{plan.cpu_multiplier} x CPU Share
          %li
            #{plan.vmem_multiplier} x Virtual Memory
          - unless plan.name == 'Start'
            %li
              Custom Domains
              %small (coming soon)


        .pricing
          $ #{plan.price}
          %span.interval / mo.

        .action
          = link_to 'Choose Plan', new_user_registration_path, class: 'btn btn-success lgaction'

  .common-paid-features
    %h4 All Paid Plans Come With:
    .row
      %ul.span6
        %li
          %i.icon-ok
          No Automatic Shut Downs
        %li
          %i.icon-ok
          Direct SSH Access
      %ul.span5
        %li
          %i.icon-ok
          SSL Protection (coming soon)
        %li
          %i.icon-ok
          Premium Support

%p.free-text
  Free plans start with 150 N2O.
