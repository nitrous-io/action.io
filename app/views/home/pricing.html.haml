- @page_title = "Nitrous Pricing"

.page-title
  %h1 Build Your Own Plan
  %h2 Pay As You Go For Exactly What You Need

.calculator
  .row.slider-row
    .span4
      #box-slider.vertical-slider
        .track
        .slider
          .slider-content
            .title
              \# Boxes
            .value
              %span 1

    .span4
      #memory-slider.vertical-slider
        .track
        .slider
          .slider-content
            .title Memory
            .value
              %span 384
              MB

    .span4
      #storage-slider.vertical-slider
        .track
        .slider
          .slider-content
            .title Storage
            .value
              %span 750
              MB

  .row.total-row
    .span4
      %p Estimated Monthly Cost
    .span4
      %p
        %i.icon-bolt
        %span#total-n2o 0
        N2O
    .span4
      %p.total
        $
        %span#total-price 0.00
        \/ month
        %span.footnote ✝

.row.contact-us-row
  .span12
    %h2
      Questions? Need More?
      = mail_to 'hello@nitrous.io?subject=Pricing', 'Contact us.', encode: 'javascript'

.more-info
  .row
    .span3
      %h3 What&rsquo;s Included?
      %ul
        %li
          %p Technical Support
        %li
          %p Global Infrastructure
        %li
          %p Web IDE and Console
        %li
          %p Real-time Collaboration

    .span3
      %h3 What&rsquo;s a box?
      %ul
        %li
          %p
            A box is a sandboxed development environment in the
            cloud where you can code, test, and run your projects.

    .span6
      %h3 What&rsquo;s N2O?
      %ul
        %li
          %p N2O units represent computing resources that can be distributed among your Nitrous.IO boxes.
        %li
          %p All accounts come pre-filled with enough N2O for a starter box, for free.
        %li
          %p
            You can increase the total amount of N2O available in your account by purchasing more N2O or by
            inviting your friends and spreading the word.

.fineprint
  %p
    %span.footnote ✝
    This price is not final and may change after public beta.

= content_for :page_script do
  = javascript_include_tag 'pages/pricing_page'
  :coffeescript
    AIO.page = new AIO.PricingPage(#{@n2o_128mb_memory}, #{@n2o_250mb_storage}, #{@free_n2o}, #{@n2o_price_cents})
