- @page_title = "Nitrous:Enterprise Request Trial"

.page-title
  %h2
    Love Nitrous.IO? Want to use it in your business?

  %h4
    - if current_user.present?
      %p
        Complete the form below to request for a Nitrous for Business trial.
      %p
        We'll give you
        = KeyValue[N2oFill::N2O_BUSINESS_SURVEY_BONUS]
        N2O as our way of saying thanks.
    - else
      %p
        Complete the form below to request a Nitrous for Businesses trial.
      %p
        You might want to
        = link_to 'sign in', new_user_session_path(redirect_to: '/business'), class: 'link'
        &mdash; we're giving
        = KeyValue[N2oFill::N2O_BUSINESS_SURVEY_BONUS]
        N2O as a reward for completing this form.

  #app-form
    #wufoo-m7x3r3
      %p
        Loading...

    %script{type: 'text/javascript'}
      var m8x3r3;(function(d, t) {
      var s = d.createElement(t), options = {
      'userName':'actionio',
      'formHash':'m7x3r3',
      'autoResize':true,
      'async':true,
      'ssl':true,
      - if current_user.present?
        'defaultValues':"field9=#{current_user.username}",
      'header':'show'};
      s.src = 'https://wufoo.com/scripts/embed/form.js';
      s.onload = s.onreadystatechange = function() {
      var rs = this.readyState; if (rs) if (rs != 'complete') if (rs != 'loaded') return;
      try { m7x3r3 = new WufooForm();m7x3r3.initialize(options);m7x3r3.display(); } catch (e) {}};
      var scr = d.getElementsByTagName(t)[0], par = scr.parentNode; par.insertBefore(s, scr);
      })(document, 'script');
