- @page_title = "What we do"

.page-title
  %h1= @page_title
  %h4.subtitle We help developers and teams streamline and manage their development workflow. We've already saved developers tens of thousands of hours.

  #alt-auth
    %ul
      %li
        = link_to user_omniauth_authorize_path(:github), class: 'github btn' do
          %i.icon-github-sign
          GitHub
      %li
        = link_to user_omniauth_authorize_path(:google_oauth2), class: 'google btn' do
          %i.icon-google-plus-sign
          Google
    %h4 Sign up now with:

%hr

