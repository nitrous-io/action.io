= content_for :page_script do
  :coffeescript
    mixpanel.track('Viewed Home Page') if mixpanel?

.container
  - if @promo_message.present?
    .row#promo-message
      .span12
        .alert.alert-notice.fade-in
          = @promo_message

  .row#promo-main
    .span5
      .hero-unit
        %h2 Hello World in 60 Seconds.
        %p.desc Managing development environments is a pain. Get setup lightning fast in the cloud &amp; code from anywhere, on any machine.

        .mc-signup#email-signup
          %h3 Give Me Early Access
          = render partial: 'invites/invite_form', locals: { invite: @invite }

    .span7
      .video.hero-unit.clearfix{:style => "float: right;"}
        %iframe(width="480" height="270" src="https://www.youtube.com/embed/7X6IvkgkC7k?hd=1" frameborder="0" webkitAllowFullScreen=true mozallowfullscreen=true allowFullScreen=true)

%hr

#features.row.showcase
  .span4
    .fitem
      =image_tag 'home-index/devices.png'
      .info
        %h4 Code from Anywhere
        %p When you need to fix that emergency bug while on the beach.
  .span4
    .fitem
      =image_tag 'home-index/stack400.png'
      .info
        %h4 Get Setup Fast
        %p It only takes a few seconds to get from signup to a fully loaded stack.
  .span4
    .fitem
      =image_tag 'home-index/console.png'
      .info
        %h4 Not just a Web IDE
        %p Use Vim or Emacs to edit your code, from the terminal or your browser.

%hr

.row.showcase#press
  .span4
    %a(href="http://www.readwriteweb.com/hack/2012/06/action-aims-to-be-the-heroku-of-development-environments-invitation-link-within.php" target="_blank")
      = image_tag "assets/press/rww-transparent-shortened.png", width: "200px"

  .span4
    %a(href="http://thenextweb.com/dd/2012/06/20/code-from-an-ipad-cloud-based-action-io-wants-to-revolutionise-the-way-developers-work/" target="_blank")
      = image_tag "assets/press/tnw-transparent-resized.png", width: "170px"

  .span4
    %a(href="#")
      = image_tag "assets/press/techcrunch-transparent.png", width: "140px"
