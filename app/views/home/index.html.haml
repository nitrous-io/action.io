.mast#header.clearfix
  - if flash.any?
    = render partial: 'layouts/flash', locals: { flash: flash }

  .mast-container
    %ul#topnav
      %li
        = link_to 'Pricing', pricing_path
      %li
        = link_to 'Support', 'http://help.nitrous.io/'
      %li
        = link_to 'Sign In', new_user_session_path, class: 'btn'
    %h1#logo
      %a{ href: "/" }<
        Nitrous
        %span> .IO

.mast#promo-main.clearfix
  .mast-container
    %h1
      Create a
      #stack-name
        %span Ruby
      Development Environment in 60 seconds.
    .item-left
      .info-container
        #video-container
          %iframe(width="480" height="270" src="https://www.youtube.com/embed/u6Qu9T5lRqI?hd=1" frameborder="0" allowfullscreen=true)
    .item-right
      .info-container
        .mc-signup#email-signup
          = simple_form_for @user, url: user_registration_path do |form|
            = form.input :username, required: true, placeholder: "Pick a username", input_html: { id: 'first-step',  autocomplete: false }, label: false
            = form.input :email, required: true, placeholder: "Your email", label: false
            = form.input :password, required: true, placeholder: "Create a password", label: false
            - if params[:ref].present?
              = form.input :disabled_referrer_code, wrapper_html: { class: 'ref_code' }, input_html: { value: params[:ref].to_s }, label: 'Referral Code:', disabled: true
              = form.input :referrer_code, as: :hidden, input_html: { value: params[:ref].to_s }, label: false
            %p.disclaimer
              By clicking on the sign up button below, you agree to the Nitrous.IO
              = link_to 'Terms of Service', 'http://help.nitrous.io/admin-terms'
              and
              = link_to 'Privacy Policy', 'http://help.nitrous.io/admin-privacy'
            = form.button :submit, value: "Sign Up for Free", class: "btn btn-success"

      - unless params[:ref].present?
        #alt-auth
          %ul
            %li
              = link_to user_omniauth_authorize_path(:github), class: 'github' do
                %i.icon-github-sign
                GitHub
            %li
              = link_to user_omniauth_authorize_path(:google_oauth2), class: 'google' do
                %i.icon-google-plus-sign
                Google
            %li
              = link_to user_omniauth_authorize_path(:linkedin), class: 'linkedin' do
                %i.icon-linkedin-sign
                LinkedIn
          %h5 Or sign up with:

.mast#stacks.clearfix
  .mast-container
    %h2 Popular Languages and Frameworks (more on the way...)
    .row.promo-row
      .span12
        %ul
          %li#rails Rails
          %li#python Python
          %li#django Django
          %li#node NodeJS
          %li#ruby Ruby
          %li#go Go

.mast#benefits
  .mast-container
    .row.promo-row
      .benefit-container
        .span4.text
          %h4 Lightning fast box provisioning
          .subtitle
            Get setup on any stack in seconds. Code in the browser on our web IDE or via SSH. Your box is accessible anywhere.
        .span7.offset1
          #new-box-slideshow.slideshow

    .row.promo-row
      .benefit-container
        .span7
          #ide-slideshow.slideshow
        .span4.offset1.text
          %h4 Powerful Web IDE
          .subtitle
            A powerful web IDE with a fully functional linux shell in your browser. None of those fake consoles, this is the real thing.

    .row.promo-row
      .benefit-container
        .span4.text
          %h4 Collaborative Coding
          .subtitle
            Add collaborators to your box, then code together in the browser. Run and preview code together on the same runtime.
        .span7.offset1
          #collab-slideshow.slideshow

    .row.promo-row
      .benefit-container
        .span6.text.with-button
          %h4 Use Your Favorite Editor
          .subtitle
            :markdown
              Our [Mac application](/mac) syncs files with your Nitrous.IO boxes, allowing you to edit code comfortably using [Sublime Text](http://www.sublimetext.com/), [Textmate](http://macromates.com/) or your favorite Mac editor.
            %a.btn.btn-success(href=mac_download_url)
              %span.licon
                %i.icon-download-alt
              Download Nitrous.IO for Mac
        .span5
          #mac-app-mba

    .row.promo-row
      .benefit-container.last
        .span7
          #chromebooks
        .span4.text
          %h4 Develop on Chromebooks
          .subtitle
            :markdown
              Your ultra-portable 4G [Chromebook](http://www.google.com/intl/en_us/chrome/devices/chromebook-pixel/) just got a powerful, lightning fast development environment. Developing on a Chromebook has never been easier.

.mast#enterprise.clearfix
  .mast-container
    %h2 Work Better, Together
    .subtitle Stop repeating yourself. Create development environment templates for your team to keep your team in sync.

    = link_to "Learn more about Nitrous:Enterprise", enterprise_path, class: "btn btn-success lgaction"

.mast#testimonials.clearfix
  .mast-container
    %h2 Talented Developers Love Us
    .row.promo-row
      .span3
        .quote
          %h4
            .dt
            Nitrous.IO is insanely good. I was working on Ember in an Ember app! O_O
        = image_tag 'assets/testimonials/katz.jpg', class: 'avatar'
        %h6
          Yehuda Katz
          = link_to "Tilde, Ember, Rails, Bundler", "http://twitter.com/wycats"

      .span3
        .quote
          %h4
            .dt
            Spent time programming from my web browser thanks to Nitrous.IO This works really really well!
        = image_tag 'assets/testimonials/tobi.jpeg', class: 'avatar'
        %h6
          Tobias Lütke
          = link_to "Shopify, Rails", "http://twitter.com/tobi"

      .span3
        .quote
          %h4
            .dt
            Holy $#!*!; Chromebook Pixel + Nitrous.IO = freaking awesome.
        = image_tag 'assets/testimonials/dale.jpg', class: 'avatar'
        %h6
          Tom Dale
          = link_to "Tilde, Ember, SproutCore", "http://twitter.com/tomdale"

      .span3
        .quote
          %h4
            .dt
            Nitrous.IO takes away the pain of setting up dev environments. It'll save you a ton of time.
        = image_tag 'assets/testimonials/yu.jpg', class: 'avatar'
        %h6
          James Yu
          = link_to "Parse", "http://twitter.com/jamesjyu"

.mast#press.clearfix
  .mast-container
    %h2 As Featured In
    .row.promo-row
      .span3
        %a(href="http://techcrunch.com/2013/04/16/nitrous-io-seed-funding/")
          = image_tag 'home-index/tc.png', alt: 'TechCrunch'

      .span3
        %a(href="http://venturebeat.com/2013/04/16/nitrous-io-closes-a-quick-1m-round-for-a-seriously-cool-web-based-ide/")
          = image_tag 'home-index/vb.png', alt: 'VentureBeat'

      .span3
        %a(href="http://thenextweb.com/dd/2012/06/20/code-from-an-ipad-cloud-based-action-io-wants-to-revolutionise-the-way-developers-work/" target="_blank")
          = image_tag 'home-index/tnw.png', alt: 'The Next Web'

      .span3
        %a(href="http://www.readwriteweb.com/hack/2012/06/action-aims-to-be-the-heroku-of-development-environments-invitation-link-within.php" target="_blank")
          = image_tag 'home-index/rww.png', alt: 'ReadWriteWeb'

.mast#action.clearfix
  .mast-container
    = link_to 'Start Coding on a Free Box', new_user_registration_path, class: 'btn btn-success lgaction'

= content_for :page_script do
  :coffeescript
    AIO.page = new AIO.HomePage

= render 'layouts/footer_guest'
