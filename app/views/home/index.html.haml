= content_for :page_script do
  :coffeescript
    mixpanel.track('Viewed Home Page') if mixpanel?
    $('#first-step').focus()

.container
  - if @promo_message.present?
    .row#promo-message
      .span12
        .alert.alert-notice.fade-in
          = @promo_message

  .row#promo-header
    .span12
      .hero-unit
        %h1 Hello World in 60 Seconds.
        %p.desc Get setup lightning fast in the cloud &amp; code from anywhere, on any machine.

  .row#promo-main
    .span7
      .video.clearfix
        %iframe(width="480" height="270" src="https://www.youtube.com/embed/7X6IvkgkC7k?hd=1" frameborder="0" webkitAllowFullScreen=true mozallowfullscreen=true allowFullScreen=true)

    .span5
      .mc-signup#email-signup
        = simple_form_for @user, url: user_registration_path do |form|
          = form.input :username, required: true, placeholder: "Pick a username", input_html: { id: 'first-step',  autocomplete: false }, label: false
          = form.input :email, required: true, placeholder: "Your email", label: false
          = form.input :password, required: true, placeholder: "Create a password", label: false
          %p.disclaimer
            ="By clicking on \"Sign up free\" below, you agree to the Nitrous.IO"
            = link_to 'Terms', 'http://help.nitrous.io/admin-terms'
            = ","
            = link_to 'Privacy Policy', 'http://help.nitrous.io/admin-privacy'
            = ", and"
            = link_to 'Beta Agreement', 'http://help.nitrous.io/admin-beta'
          = form.button :submit, value: "Sign Up Free", class: "btn btn-info"

%hr

#features.row.showcase
  .span4
    .fitem
      =image_tag 'home-index/devices.png'
      .info
        %h4 Code from Anywhere
        %p When you need to fix that emergency bug while on the beach.
  .span4
    .fitem
      =image_tag 'home-index/stack400.png'
      .info
        %h4 Get Setup Fast
        %p It only takes a few seconds to get from signup to a fully loaded stack.
  .span4
    .fitem
      =image_tag 'home-index/console.png'
      .info
        %h4 Not just a Web IDE
        %p Use Vim or Emacs to edit your code, from the terminal or your browser.

%hr

.row.showcase#testimonials
  .span3
    .quote
      %h4
        .dt
        Nitrous.IO is insanely good. I was working on Ember in an Ember app! O_O
    %h6
      Yehuda Katz
      = link_to "Tilde, Ember, Rails, Bundler", "http://twitter.com/wycats"
  .span3
    .quote
      %h4
        .dt
        Spent time programming from my web browser thanks to Nitrous.IO This works really really well!
    %h6
      Tobias Lütke
      = link_to "Shopify, Rails", "http://twitter.com/tobi"
  .span3
    .quote
      %h4
        .dt
        Holy $#!*!; Chromebook Pixel + Nitrous.IO = freaking awesome.
    %h6
      Tom Dale
      = link_to "Tilde, Ember, SproutCore", "http://twitter.com/tomdale"
  .span3
    .quote
      %h4
        .dt
        Nitrous.IO takes away the pain of setting up dev environments. It'll save you a ton of time.
    %h6
      James Yu
      = link_to "Parse", "http://twitter.com/jamesjyu"

%hr

.row.showcase#press
  .span4
    %a(href="http://www.readwriteweb.com/hack/2012/06/action-aims-to-be-the-heroku-of-development-environments-invitation-link-within.php" target="_blank")
      = image_tag "assets/press/rww-transparent-shortened.png", width: "200px"

  .span4
    %a(href="http://thenextweb.com/dd/2012/06/20/code-from-an-ipad-cloud-based-action-io-wants-to-revolutionise-the-way-developers-work/" target="_blank")
      = image_tag "assets/press/tnw-transparent-resized.png", width: "170px"

  .span4
    %a(href="http://techcrunch.com/2013/04/16/nitrous-io-seed-funding/")
      = image_tag "assets/press/techcrunch-transparent.png", width: "140px"
