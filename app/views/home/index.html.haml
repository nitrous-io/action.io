.container
  .row#promo-main
    .span5
      .hero-unit
        %h2 0 to Rails in 60 Seconds.
        %p.desc Development environments are complex. Spend more time coding and less time setting up and configuring your machine.
        -#=link_to 'Setup a Box', new_user_registration_path, :class => 'btn btn-info btn-large', :style => "width: 180px;"

        .mc-signup#email-signup
          %h3 Request Beta Invite
          %form{ :action => "http://action.us4.list-manage2.com/subscribe/post?u=40aef44b6df80a146dc4163c7&amp;id=97a8d9f996", :method => "post", :id => "mc-embedded-subscribe-form", :name => "mc-embedded-subscribe-form", :class => "form-inline", :target => "_blank" }
            %input{ :type => "email", :value => "", :name => "EMAIL", :placeholder => "Your Email" }
            %button{ :type => "submit", :class => "btn btn-info"} Subscribe
          %p{ :class => "disclaimer"}
            P.S. We hate spam, we won't share your email.</p>

    .span7
      .hero-unit.clearfix{:style => "float: right;"}
        .video-thumbnail

  .row.showcase#clone
    .span5
      .hero-unit
        %h2 Clone in a *snap*
        %p.desc Creating new development boxes is a breeze. Boxes are versioned and tagged, so you won't stress about testing out new platforms.
    .span7
      .showcase-thumb
        = image_tag "home-index/world.png"

  .row.showcase#version
    .span5
      .hero-unit
        %h2 Version your Stack
        %p.desc Unlike most cloud editors, we let you code the way you want. Use vim, emacs, or your favorite graphical editor on your own machine.
    .span7
      .showcase-thumb
        = image_tag "home-index/stack400.png", :width => 250

  .row.showcase#collab
    .span5
      .hero-unit
        %h2 Collaborate
        %p.desc Unlike most cloud editors, we let you code the way you want. Use vim, emacs, or your favorite graphical editor on your own machine.
    .span7
      .showcase-thumb
        = image_tag "home-index/share.png"

  .row.showcase#moar-email
    .span8
      .mc-signup#email-signup.moar-email
        %h3 Want Early Access?
        %form{ :action => "http://action.us4.list-manage2.com/subscribe/post?u=40aef44b6df80a146dc4163c7&amp;id=97a8d9f996", :method => "post", :id => "mc-embedded-subscribe-form", :name => "mc-embedded-subscribe-form", :class => "form-inline", :target => "_blank" }
          %input{ :type => "email", :value => "", :name => "EMAIL", :placeholder => "Your Email" }
          %button{ :type => "submit", :class => "btn btn-info"} Subscribe
        %p{ :class => "disclaimer"}
          P.S. We hate spam, we won't share your email.</p>
