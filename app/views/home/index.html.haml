.container
  - if @promo_message.present?
    .row#promo-message
      .span12
        .alert.alert-notice.fade-in
          = @promo_message

  .row#promo-main
    .span5
      .hero-unit
        %h2 Welcome to the Future.
        %p.desc Managing development environments is a pain. Do it in the cloud &ndash; code from anywhere, on any machine.

        .mc-signup#email-signup
          %h3 Give Me Early Access
          = render :partial => 'invites/invite_form', :locals => { :invite => @invite }

    .span7
      .video.hero-unit.clearfix{:style => "float: right;"}
        %iframe(width="480" height="270" src="https://www.youtube.com/embed/9GIylBBh2zk?hd=1" frameborder="0" webkitAllowFullScreen=true mozallowfullscreen=true allowFullScreen=true)

= render :partial => 'quotes.html.haml'
= render :partial => 'features.html.haml'
