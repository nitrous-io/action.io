    .row.promo-row
      .span3
        .quote
          %h4
            .dt
            Nitrous.IO is insanely good. I was working on Ember in an Ember app! O_O
        = image_tag 'assets/testimonials/katz.jpg', class: 'avatar'
        %h6
          Yehuda Katz
          = link_to "Tilde, Ember, Rails, Bundler", "http://twitter.com/wycats"

      .span3
        .quote
          %h4
            .dt
