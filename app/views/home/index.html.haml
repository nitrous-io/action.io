= content_for :page_script do
  :coffeescript
    mixpanel.track('Viewed Home Page') if mixpanel?
    $('#first-step').focus()

    stacks = ["Python", "Ruby", "Django", "Go", "Rails", "Java", "Node.js"]
    i = 0

    setInterval(->
      $("#stack-name span").text stacks[i % stacks.length]
      i += 1
    , 2000)

- if @promo_message.present?
  .row#promo-message
    .span12
      .alert.alert-notice.fade-in
        = @promo_message

.mast#header.clearfix
  .mast-container
    %ul#topnav
      %li
        = link_to 'Pricing', pricing_path
      %li
        = link_to 'Support', 'http://help.nitrous.io/'
      %li
        = link_to 'Sign In', new_user_session_path, class: 'btn'
    %h1#logo
      %a{ href: "/" }<
        Nitrous
        %span> .IO

.mast#promo-main.clearfix
  .mast-container
    %h1
      Create a
      #stack-name
        %span Python
      Development Box in 20 seconds.
    .item-left
      .info-container
        #video-container
          %iframe(width="480" height="270" src="https://www.youtube.com/embed/7X6IvkgkC7k?hd=1" frameborder="0" webkitAllowFullScreen=true mozallowfullscreen=true allowFullScreen=true)
    .item-right
      .info-container
        .mc-signup#email-signup
          = simple_form_for @user, url: user_registration_path do |form|
            = form.input :username, required: true, placeholder: "Pick a username", input_html: { id: 'first-step',  autocomplete: false }, label: false
            = form.input :email, required: true, placeholder: "Your email", label: false
            = form.input :password, required: true, placeholder: "Create a password", label: false
            %p.disclaimer
              ="By clicking on \"Sign Up for Free\" below, you agree to the Nitrous.IO"
              = link_to 'Terms of Service', 'http://help.nitrous.io/admin-terms'
              = " and"
              = link_to 'Privacy Policy', 'http://help.nitrous.io/admin-privacy'
            = form.button :submit, value: "Sign Up for Free", class: "btn btn-success"

      #alt-auth
        %ul
          %li
            = link_to user_omniauth_authorize_path(:github), class: 'github' do
              %i.icon-github-sign
              GitHub
          %li
            = link_to user_omniauth_authorize_path(:google_oauth2), class: 'google' do
              %i.icon-google-plus-sign
              Google
        %h4 Or sign up with:

.mast#stacks.clearfix
  .mast-container
    %h2 Popular Languages and Frameworks (more on the way...)
    .row.promo-row
      .span12
        %ul
          %li#rails Rails
          %li#python Python
          %li#django Django
          %li#node NodeJS
          %li#ruby Ruby
          %li#go Go

.mast#benefits
  .mast-container
    .row.promo-row
      .benefit-container
        .span4.text
          %h4 Lightning fast box provisioning
          .subtitle
            Get setup on any stack in seconds. Code in the browser on our web IDE or via SSH. Your box is accessible anywhere.
        .span7.offset1
          #new-box-slideshow.slideshow

    .row.promo-row
      .benefit-container
        .span7
          #ide-slideshow.slideshow
        .span4.offset1.text
          %h4 Powerful Web IDE
          .subtitle
            A powerful web IDE with a fully functional linux shell in your browser. None of those fake consoles, this is the real thing.

    .row.promo-row
      .benefit-container.last
        .span4.text
          %h4 Collaborative Coding
          .subtitle
            Add collaborators to your box, then code together in the browser. Run and preview code together on the same runtime.
        .span7.offset1
          #collab-slideshow.slideshow

.mast#testimonials.clearfix
