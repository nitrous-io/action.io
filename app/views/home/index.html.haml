- if flash.any?
  = render partial: 'layouts/flash', locals: { flash: flash }

/[if lt IE 10]
  #ie-warning
    %p
      %strong WARNING:
      You are using an
      %strong unsupported
      and
      %strong outdated
      version of Internet Explorer.
    %p Nitrous requires a browser that supports latest HTML5 technologies.
    %p
      Please
      %a(href='http://browsehappy.com/' target='_blank') download a modern web browser
      and try again.
    %p
      We recommend
      %a(href='https://www.google.com/chrome' target='_blank') Google Chrome
      %span> .

= render 'layouts/new_header'

.mast#promo-main
  .mast-container
    .item-left
      .info-container
        = render partial: @page
    .item-right
      - if user_signed_in?
        = link_to 'Open Dashboard', web_app_path, class: 'btn btn-success btn-huge open-dashboard-button'
      - else
        .info-container
          .mc-signup#email-signup
            = simple_form_for @user, url: user_registration_path do |form|
              = form.input :username, required: true, placeholder: "Pick a username", input_html: { id: 'first-step',  autocomplete: false }, label: false
              = form.input :email, required: true, placeholder: "Your email", label: false, input_html: { class: 'mailcheck' }
              = form.input :password, required: true, placeholder: "Create a password", label: false
              - if @coupon && @coupon.active
                = form.input :disabled_coupon_code, wrapper_html: { class: 'readonly' }, input_html: { value: @coupon.code.to_s }, label: 'Coupon Code:', disabled: true
                = form.input :coupon_code, as: :hidden, input_html: { value: params[:coupon_code].to_s }, label: false
              - if params[:ref].present?
                = form.input :disabled_referrer_code, wrapper_html: { class: 'readonly' }, input_html: { value: params[:ref].to_s }, label: 'Referral Code:', disabled: true
                = form.input :referrer_code, as: :hidden, input_html: { value: params[:ref].to_s }, label: false
              %p.disclaimer
                By clicking on the sign up button below, you agree to the Nitrous
                = link_to 'Terms of Service', 'http://help.nitrous.io/admin-terms'
                and
                = link_to 'Privacy Policy', 'http://help.nitrous.io/admin-privacy'
              = form.button :submit, value: "Sign Up for Free", class: 'btn-success btn-huge'

        - unless params[:ref].present? || params[:coupon_code].present?
          #alt-auth
            %ul
              %li
                = link_to user_omniauth_authorize_path(:github), class: 'github' do
                  %i.fa.fa-github-square
                  GitHub
              %li
                = link_to user_omniauth_authorize_path(:google_oauth2), class: 'google' do
                  %i.fa.fa-google-plus-square
                  Google
              %li
                = link_to user_omniauth_authorize_path(:linkedin), class: 'linkedin' do
                  %i.fa.fa-linkedin-square
                  LinkedIn
            %h5 Or sign up with:

.mast#nitrouspro
  .mast-container
    .hero-visual
      = image_tag 'home-index/nitrous-pro-chrome.png', width: '970px', alt: 'Nitrous Pro'
    .hero-tagline
      %h2 Introducing Nitrous Pro
      %h3 Software Development Without the Pain

      .form-wrapper
        %form.cta-get-started
          %input{ :type => "email", :name => "email", :placeholder => "Email address" }
          %input.btn.blue.submit{ :type => 'submit', "data-ripple-color" => "rgba(0,0,0,.2)", :value => "Get Started" }

.mast#page-content
  .mast-container
    #usedby
      %h4 Used by developers at:
      = image_tag 'home-index/companies.png'

    %hr

    .profile.left.railsgirls
      %div
        = image_tag 'home-index/railsgirls-logo.png'
        %p.right
          Nitrous helps Rails Girls focus on teaching how to code instead of troubleshooting their students' development machines.

    %hr

    .profile.right.ember
      %div
        = image_tag 'home-index/ember-logo.png'
        %p.left
          Tom Dale and Yehuda Katz use Nitrous to easily collaborate on Ember.js, a powerful javascript framework, regardless of where they are.

    %hr

    .profile.left.klabnik
      %div
        = image_tag 'home-index/klabnik-logo.png'
        %p.right
          Nitrous allows Steve Klabnik to break free from heavy unix machines so he can craft applications on his Chromebook Pixel.

    %hr

    #ide
      %h1 A full-featured IDE in your browser
      .subtitle
        :markdown
          Code a variety of languages including Ruby, Python, Go, NodeJS and PHP. Run web servers, databases, caches and more right [from the menubar](http://help.nitrous.io/autoparts/).

      %video(src='https://s3.amazonaws.com/assets.action.io/videos/ide.mp4' preload='true' autoplay='true' loop='true' poster='https://s3.amazonaws.com/assets.action.io/videos/poster.png')

    %hr

    #mac
      %h1 Use your favorite editor
      .subtitle
        :markdown
          Our [desktop application](/desktop) syncs files with your Nitrous boxes, allowing you to edit code comfortably using [Atom](https://atom.io), [Sublime Text](http://www.sublimetext.com/), [Textmate](http://macromates.com/) or your favorite desktop text editor.

      %a.btn.btn-success#download{ href: '/desktop' }
        %span &#11015;&#65038;
        Get Nitrous Desktop

      %p.macversion
        Requires Windows XP / OS X 10.7+ Lion or Newer

      = image_tag 'home-index/mac-window.png', class: 'mac-screenshot'

      %h4.also-available Also available on:

      %ul.otherapps
        %li.chrome
          = link_to "", "https://chrome.google.com/webstore/detail/nitrousio/efdcneeepllhjlbejkfnaolelbpdacai?hl=en", target: "_blank"
        %li.windows
          = link_to '', windows_path

    %hr

    #benefits
      .row
        .span4
          .benefit-col
            .bicon
              %i.icon.fa.fa-globe.fa-5x
            %h4 Work from Anywhere
            %p.desc
              Code on our web-based editor, with your favorite text editor or via SSH. Your development box is accessible anywhere.

        .span4
          .benefit-col
            .bicon
              %i.icon.fa.fa-comments.fa-5x
            %h4 Share your workspace
            %p.desc
              Since your box is in the cloud, you can code collaboratively with anyone. Get help from a friend and code directly on the same machine in the cloud.

        .span4
          .benefit-col
            .bicon
              %i.icon.fa.fa-laptop.fa-5x
            %h4 Code on your Chromebook
            %p.desc
              :markdown
                Your ultra-portable 4G [Chromebook](https://www.google.com/chrome/devices/google-chromebook-pixel/) just got a powerful development environment.

    #action.clearfix
      - if user_signed_in?
        = link_to 'Start Coding', web_app_path, class: 'btn btn-success lgaction'
      - else
        = link_to 'Start Coding on a Free Box', new_user_registration_path, class: 'btn btn-success lgaction'

- if (email = params[:confirm_email]).present?
  #email-confirmation
    .darkness
      .container
        .window
          %button.close.close-button &times;
          %i.email-icon.fa.fa-envelope-o
          %h1
            Wait! One More Step!
          .well.well-large
            %p
              We sent an email to
              %span.email
                = email.to_s
              with instructions for confirming your account.

            %small
              No email? Check your spam folder.

            - if email.present? && e = email_to_provider_website(email)
              %a.btn.btn-success.btn-block(href=e)
                Check Your Email
            - else
              %a.btn.btn-success.btn-block.close-button(href='#')
                Okay

= render 'layouts/footer_guest'

= content_for :page_script do
  = javascript_include_tag 'pages/home-page'

  :coffeescript
    App.page = new App.HomePage #{(@user || current_user).email.to_s.to_json}, coupon_code: #{@coupon.try(:code).to_json}

  - if params[:confirm_email].present? || params[:oauth_signup].present?
    :javascript
      /* <![CDATA[ */
      window.goog_snippet_vars = function() {
        var w = window;
        w.google_conversion_id = 972755190;
        w.google_conversion_label = "VRJECLKC3wcQ9qHszwM";
        w.google_remarketing_only = false;
      };
      // DO NOT CHANGE THE CODE BELOW.
      window.goog_report_conversion = function(url) {
        window.goog_snippet_vars();
        window.google_conversion_format = "3";
        window.google_is_call = true;
        var opt = new Object();
        opt.onload_callback = function() {
          if (typeof(url) != 'undefined') {
            window.location = url;
          }
        };
        var conv_handler = window['google_trackConversion'];
        if (typeof(conv_handler) == 'function') {
          conv_handler(opt);
        }
      }
      /* ]]> */
    = javascript_include_tag '//www.googleadservices.com/pagead/conversion_async.js'
    :javascript
      window.goog_report_conversion();
  - elsif current_user.nil?
    -# neither :confirm_email nor :oauth_signup params present, user not signed
    -# in, activate remarketing
    :javascript
      /* <![CDATA[ */
      var google_conversion_id = 972755190;
      var google_custom_params = window.google_tag_params;
      var google_remarketing_only = true;
      /* ]]> */
    = javascript_include_tag '//www.googleadservices.com/pagead/conversion_async.js'
