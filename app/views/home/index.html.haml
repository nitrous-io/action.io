.container
  .row#promo-main
    .span5
      .hero-unit
        %h2 0 to Rails in 60 Seconds.
        %p.desc Development environments are complex. Spend more time coding and less time setting up and configuring your machine.
        -#=link_to 'Setup a Box', new_user_registration_path, :class => 'btn btn-info btn-large', :style => "width: 180px;"

        .mc-signup#email-signup
          %h3 Request Beta Invite
          = render :partial => 'invites/invite_form', :locals => { :invite => Invite.new }

    .span7
      .hero-unit.clearfix{:style => "float: right;"}
        .video-thumbnail

  .row.showcase#clone
    .span6
      .hero-unit
        %h2 Clone in a *snap*
        %p.desc Creating new development boxes is a breeze. Clone an entire environment from any action template in a matter of seconds.
        %p
          %a.mlink="Read More About Cloning &raquo;".html_safe
    .span6
      .showcase-thumb#world
        = image_tag "home-index/world.png"

  .row.showcase#version
    .span6
      .hero-unit
        %h2 Version your Stack
        %p.desc Rollback to a previous environment state in a few seconds. Undo previous installations without all of the headaches.
        %p
          %a.mlink="Read More About Versioning &raquo;".html_safe
    .span6
      .showcase-thumb
        = image_tag "home-index/stack400.png", :width => 250

  .row.showcase#collab{:style => "padding-bottom: 0;"}
    .span6
      .hero-unit
        %h2 Collaborate
        %p.desc Getting your teammates on the same page has never been easier. Share a stack with your team or with the world.
        %p
          %a.mlink="Read More About Collaboration &raquo;".html_safe
    .span6
      .showcase-thumb
        = image_tag "home-index/share.png"

  .row#moar-email
    .span8
      .mc-signup#email-signup.moar-email
        %h3 Want Early Access?
        = render :partial => 'invites/invite_form', :locals => { :invite => Invite.new }