- @page_title = 'Hack on Nitrous.IO'

:ruby
  _repos = [
    { repo: 'meteor/telephone-pictionary', runtime: 'meteor', file_to_open: 'README.nitrous.md' },
    { repo: 'firebase/angularFire', runtime: 'nodejs', file_to_open: 'README.md' },
    { repo: 'twilio/starter-ruby', runtime: 'rails', file_to_open: 'README.nitrous.md' },
    { repo: 'shopify/shopify_django_app', runtime: 'django', file_to_open: 'README.nitrous.md' },
    { repo: 'railsapps/rails-devise', runtime: 'rails', file_to_open: 'nitrous.txt' },
    { repo: 'learnable/tuvi', runtime: 'rails' },
    { repo: 'intridea/grape', runtime: 'rails', file_to_open: 'README.md' },
    { repo: 'sendgrid/eventkit', runtime: 'php', file_to_open: 'README.nitrous.md' },
    { repo: 'discovermeteor/microscope', runtime: 'meteor', file_to_open: 'README.nitrous.md' }
  ]

.container
  %h1.page_title Nitrous Hack Button
  %h4.subtitle
    The fastest way to share a development environment setup
  %ul.hack-steps
    %li.step.active
      %span.num 1
      %h3 Choose a Repository and Create a Button to Embed
    %li.step
      %span.num 2
      %h3 Embed your Button in a Blog, Github Readme, etc...
    %li.step
      %span.num 3
      %h3 Anyone can Start Hacking on your Project in Seconds!

  .action-area
    %a.btn.btn-success{ href: '/embed' }
      Create a Hack Button
      %i.fa.fa-chevron-right

  %hr

  %h2 Popular Repositories
  %ul.partners
    - _repos.each do |r|
      - _author, _repo = r[:repo].split('/')
      %li.partner
        .logo
          = image_tag "hack/#{_author}.png"
        .repo-info
          .author
            %a{ href: "https://www.github.com/#{_author}" }
              = _author
          .repo
            = _repo
          .hack-button
            = link_to hack_button_url(r) do
              = image_tag 'hack-s-v1.png'

  %hr

  %h2{ :id => "bookmarklet"}
    Don't See Your Favorite Repo?
  %p
    Drag this
    %a{ ondragend:"App.HackPage.didDragBookMarklet()",href:"javascript:(function()%0A%7B%0A%20%20var%20links%3Ddocument.querySelectorAll(%27.clone%27)%3B%0A%20%20if((document.URL.indexOf(%27github.com%27))%26%26(links%5B0%5D)%26%26(links%5B0%5D.defaultValue))%0A%20%20%7B%0A%20%20%20%20var%20gitlink%3Dlinks%5B0%5D.defaultValue%3B%0A%20%20%20%20if(gitlink.indexOf(%27https%3A%2F%2Fgithub.com%2F%27)%3E%20-1)%7B%0A%20%20%20%20%20%20open(%27https%3A%2F%2F#{Settings.host_full}%2Fhack_button%3Fsource%3Dbookmarklet%26repo%3D%27%2BencodeURI(gitlink.replace(%27https%3A%2F%2Fgithub.com%2F%27%2C%27%27)))%3B%0A%20%20%20%20%7D%0A%20%20%7D%0A%20%20else%0A%20%20%7B%0A%20%20%20%20alert(%27Sorry!%20This%20page%20does%20not%20seem%20to%20be%20a%20GitHub%20Repo.%27)%0A%20%20%7D%0A%7D)()", class:"btn btn-warning"} Hack
    bookmarklet to your bookmarks toolbar and use it to start hacking on any public GitHub repo.

  %br
  %hr
  %h2
    Don't Have Nitrous.IO Account?
  .sign-in-area
    %a.btn.btn-success Sign Up for Free
    and start hacking today.

= content_for :page_script do
  = javascript_include_tag 'pages/hack-page'
  :coffeescript
    App.HackPage.initialize()
