- @page_title = 'Hack on Nitrous.IO'

:ruby
  _repos = [
    { repo: 'meteor/telephone-pictionary', runtime: 'nodejs', file_to_open: 'README.nitrous.md' },
    { repo: 'firebase/angularFire', runtime: 'nodejs', file_to_open: 'README.md' },
    { repo: 'twilio/starter-ruby', runtime: 'rails', file_to_open: 'README.nitrous.md' },
    { repo: 'shopify/shopify_django_app', runtime: 'django', file_to_open: 'README.nitrous.md' },
    { repo: 'railsapps/rails-devise', runtime: 'rails', file_to_open: 'nitrous.txt' },
    { repo: 'learnable/tuvi', runtime: 'rails' },
    { repo: 'intridea/grape', runtime: 'rails', file_to_open: 'README.md' },
    { repo: 'sendgrid/eventkit', runtime: 'php', file_to_open: 'README.nitrous.md' },
    { repo: 'discovermeteor/microscope', runtime: 'nodejs', file_to_open: 'README.nitrous.md' }
  ]

.container
  %h1.page_title Nitrous Hack Button
  %h4.subtitle
    The fastest way to share a development environment setup
  %ul.hack-steps
    %li.step.active
      %span.num 1
      %h3 Choose a Repository and Create a Button to Embed
    %li.step
      %span.num 2
      %h3 Embed your Button in a Blog, Github Readme, etc...
    %li.step
      %span.num 3
      %h3 Anyone can Start Hacking on your Project in Seconds!

  .action-area
    %a.btn.btn-success{ href: '/embed' }
      Create a Hack Button
      %i.fa.fa-chevron-right

  %hr

  %h2 Popular Repositories
  %ul.partners
    - _repos.each do |r|
      - _author, _repo = r[:repo].split('/')
      %li.partner
        .logo
          = image_tag "hack/#{_author}.png"
        .repo-info
          .author
            %a{ href: "https://www.github.com/#{_author}" }
              = _author
          .repo
            = _repo
          .hack-button
            = link_to hack_button_url(r) do
              = image_tag 'hack-s-v1.png'

  .sign-in-area
    %a.btn.btn-success Sign Up
    or
    %a.link Sign in
    to create your own button or to start hacking on a popular repository.

= content_for :page_script do
  = javascript_include_tag 'pages/hack-page'
  :coffeescript
    App.HackPage.initialize()
