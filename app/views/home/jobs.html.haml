- @page_title = "We're changing the way the world codes."
= render 'page_menu'

.container
  .row
    .span8
      .page-title
        %h2 We're changing the way the world writes web applications.

      %p We are a results and data-driven organzation. We value people who are doers instead of talkers, people who obsess over the details, who listen to data, but know when to trust their gut, and who can empathize with developers.

      %article
        %ul#jobs.dark-list
          = render 'job_devops'
          = render 'job_engineer'
          = render 'job_support'
          = render 'job_evangelist'
          = render 'job_pdesign'
          = render 'job_ghacker'
          = render 'job_admin'

    .span3.offset1
      #sidebar
        %h3 Nitrous.IO Perks
        %ul
          %li Competitive Salary &amp; Equity
          %li Pick Your Projects
          %li Health Insurance
          %li Gym Membership
          %li Choice of Equipment
          %li Flexible Vacation
          %li Public Transport Stipend
          %li SF-Singapore Exchange Program

        %h3 Mountain View Positions
        %ul#position_links
          %li
            %a(href='#platform') Platform Engineer
          %li
            %a(href='#software') Software Engineer
          %li
            %a(href='#support') Support Engineer
          %li
            %a(href='#evangelist') Developer Evangelist
          %li
            %a(href='#pdesign') Product Designer
          %li
            %a(href='#ghacker') Growth Hacker
          %li
            %a(href='#admin') Corporate Assistant

        %h3 Singapore Positions
        %ul#position_links_sg
          %li
            %a(href='#software') Software Engineer
          %li
            %a(href='#support') Support Engineer
          %li
            %a(href='#pdesign') Product Designer

= content_for :page_script do
  = javascript_include_tag 'pages/jobs_page'
  :coffeescript
    AIO.JobsPage.initialize()
