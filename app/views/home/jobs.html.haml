- @page_title = "Join the Team"

.container
  .row
    .span8
      %h1.title= @page_title
      %p Nitrous.IO is revolutionizing the way the the world develops software applications. We are looking for remarkable people to help us effect the next paradigm shift in programming.

      %hr
      %h2 Open Positions

      %article
        %ul#jobs.dark-list
          = render 'job_devops'
          = render 'job_engineer'
          = render 'job_support'

    .span3.offset1
      #sidebar
        %h3 Nitrous.IO Perks
        %ul
          %li Competitive Salary &amp; Equity
          %li Health Insurance
          %li Gym Membership
          %li Choice of Equipment
          %li Annual Travel Stipend
          %li Free Catered Lunch
          %li Snacks &amp; Beers
          %li Bike or Public Transport Stipend
          %li SF-Singapore Exchange Program
        %h3 Open Positions
        %ul#position_links
          %li
            %a(href='#platform') Platform Engineer
          %li
            %a(href='#software') Software Engineer
          %li
            %a(href='#support') Support Engineer

= content_for :page_script do
  = javascript_include_tag 'pages/jobs_page'
  :coffeescript
    AIO.JobsPage.initialize()

