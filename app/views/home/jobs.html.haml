- @page_title = "Join the Team"

.container
  .row
    .span8
      %h1.title= @page_title
      %p Action.IO is revolutionizing the way the the world develops software applications. We are looking for remarkable people to help us effect the next paradigm shift in programming.
      %p Action.IO was founded in August of 2012 and has offices in San Francisco and Singapore.

      %hr
      %h2 Open Positions

      %article
        %ul#jobs.dark-list
          = render 'job_devops'
          = render 'job_engineer'
          = render 'job_support'

    .span3.offset1
      #sidebar
        %h3 About Action.IO
        %p
          Employees receive equity, health insurance, gym memberships, beers stocked in the office, exercise balls, the laptop of your choice, the chair of your choice, and a bike or a monthly public transportation stipend.
        %h3 Action Perks
        %p
          %ul
            %li Relocation costs covered
            %li Equity in a fast growing startup
            %li Gym Stipend
            %li Machine of your choice
        %h3 Open Positions
        %ul
          %li= link_to 'Dev Ops Engineer', jobs_path(anchor: 'devops')
          %li= link_to 'Software Engineer', jobs_path(anchor: 'engineer')
          %li= link_to 'Support Engineer', jobs_path(anchor: 'support')
