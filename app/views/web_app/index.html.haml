= content_for :page_script do
  :ruby
    js_init_options = {
      environment: Rails.env,
      currentUser: current_user.try(:serialize_as_hash),
      pusherKey: Pusher.key,
      boxes: @boxes.serialize_as_hash,
      regions: @regions.serialize_as_hash,
      boxTemplates: @box_templates.serialize_as_hash
    }
  = javascript_include_tag 'https://d3dy5gmtp8yhk7.cloudfront.net/1.12/pusher.min.js'
  = javascript_include_tag 'aio'
  :coffeescript
    AIO.initialize()
    AIO.bootstrap #{js_init_options.to_json}
#app
