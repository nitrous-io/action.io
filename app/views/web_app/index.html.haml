= content_for :page_script do
  :ruby
    js_init_options = {
      environment: Rails.env,
      currentUser: current_user.try(:serialize_as_hash, scope: current_user),
      entryCouponCode: @coupon_code,
      shoverServerURI: Settings.shover_server_uri,
      firebaseHost: ENV['FIREBASE_HOST'],
      stripePublishableKey: ENV['STRIPE_PUBLISHABLE_KEY'],
      n2o128mbMemory: @n2o_128mb_memory,
      n2o250mbStorage: @n2o_250mb_storage,
      paymentsEnabled: ENV['ENABLE_PAYMENTS'],
      maxMemoryMB: @max_memory_in_mb,
      maxStorageMB: @max_storage_in_mb,
      minMemoryMB: @min_memory_in_mb,
      minStorageMB: @min_storage_in_mb
    }
  = javascript_include_tag 'https://cdn.firebase.com/v0/firebase.js'
  = javascript_include_tag 'https://js.stripe.com/v2/'
  = javascript_include_tag 'aio'
  :coffeescript
    AIO.initialize()
    AIO.get('router.applicationController').initialize(#{js_init_options.to_json})
    AIO.get('router.boxesController').loadAll(#{ { boxes: @boxes.serialize_as_hash }.to_json })
    AIO.get('router.snapshotsController').loadAll(#{ { snapshots: @snapshots.serialize_as_hash }.to_json })
    AIO.get('router.repositoriesController').loadAll(#{ { repositories: @repositories.serialize_as_hash }.to_json })
    AIO.get('router.publicKeysController').loadAll(#{ { public_keys: @public_keys.serialize_as_hash }.to_json })
    AIO.get('router.regionsController').loadAll(#{ { regions: @regions.serialize_as_hash }.to_json })
    AIO.get('router.boxTemplatesController').loadAll(#{ { box_templates: @box_templates.serialize_as_hash }.to_json })
    AIO.get('router.personalPlansController').loadAll(#{ { plans: @personal_plans.serialize_as_hash }.to_json })
    AIO.get('router.teamPlansController').loadAll(#{ { plans: @team_plans.serialize_as_hash }.to_json })
    AIO.get('router.allPlansController').loadAll(#{ { plans: @all_plans.serialize_as_hash }.to_json })
    AIO.set('router.n2oBonusController.content', AIO.Bonus.create(#{@bonus.serialize_as_hash[:bonus].to_json}))
    AIO.set('router.n2oBonusController.bonusInfo', #{@bonus_info.to_json})
#app
