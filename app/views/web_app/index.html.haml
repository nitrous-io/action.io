= content_for :page_script do
  :ruby
    js_init_options = {
      environment: Rails.env,
      currentUser: current_user.try(:serialize_as_hash),
      pusherKey: Pusher.key
    }
  = javascript_include_tag 'aio'
  -#= javascript_include_tag "#{ENV['ACTION_BOX_SERVER_URI']}/socket.io/socket.io.js"
  :coffeescript
    AIO.initialize()
    AIO.get('router.applicationController').initialize(#{js_init_options.to_json})
    AIO.get('router.boxesIndexController').loadAll(#{ { boxes: @boxes.serialize_as_hash }.to_json })
    AIO.get('router.regionsIndexController').loadAll(#{ { regions: @regions.serialize_as_hash }.to_json })
#app
