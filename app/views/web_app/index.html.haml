= content_for :page_script do
  :ruby
    js_init_options = {
      environment: Rails.env,
      currentUser: current_user.try(:serialize_as_hash, scope: current_user),
      pusherKey: Pusher.key,
      firebaseHost: ENV['FIREBASE_HOST']
    }
  = javascript_include_tag 'https://d3dy5gmtp8yhk7.cloudfront.net/1.12/pusher.min.js'
  = javascript_include_tag 'https://cdn.firebase.com/v0/firebase.js'
  = javascript_include_tag 'aio'
  :coffeescript
    AIO.initialize()
    AIO.lookup('controller:application').initialize(#{js_init_options.to_json})
    AIO.lookup('controller:boxes').loadAll(#{ { boxes: @boxes.serialize_as_hash }.to_json })
    AIO.lookup('controller:regions').loadAll(#{ { regions: @regions.serialize_as_hash }.to_json })
    AIO.lookup('controller:boxTemplates').loadAll(#{ { box_templates: @box_templates.serialize_as_hash }.to_json })
#app
