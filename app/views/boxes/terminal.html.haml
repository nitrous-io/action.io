= render 'layouts/head'

%body
  = render 'layouts/scripts'
  = javascript_include_tag 'term'
  = javascript_include_tag "#{ENV['ACTION_BOX_SERVER_URI']}/socket.io/socket.io.js"
  :coffeescript
    window.term = new Terminal(80, 6)
    term.open()

    window.socket = io.connect('#{ENV['ACTION_BOX_SERVER_URI']}/ws/ssh')

    socket.on 'connect', ->
      socket.emit('start', #{@box.id})

    socket.on 'start', (err) ->
      return if err
      term.element.focus()
      socket.emit 'r', 80, 6

      #term.on 'data', (data) ->
        #socket.emit 'd', data
      term.handler = (data) ->
        socket.emit 'd', data

      term.on 'resize', (cols, rows) ->
        socket.emit 'r', cols, rows

      window.onresize = ->
        term.sizeToFit()

      window.onresize()

    socket.on 'd', (data) ->
      term.write(data)

