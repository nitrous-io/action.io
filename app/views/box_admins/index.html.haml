- @page_header = "Admins for #{@box.name}"

%h1= @box.name

.header
  = form_for(:user, url: [@box, :admins], html: { class: "form-inline form dash-search" }) do |form|
    = form.text_field :username, required: false, placeholder: "username", size: nil, id: nil
    = form.button "Invite", class: "btn", 'data-disable-with' => "Submitting..."

%table{class: 'table table-striped'}
  %thead
    %tr
      %th Username
      %th Email
      - if current_user == @box.owner
        %th Action

  - @users.each do |u|
    %tr
      %td.important= u.username
      %td= u.email
      %td
        - if current_user == @box.owner
          =link_to "Remove", url_for(action: :destroy, box_id: @box.id, id: u.username), confirm: "Are you sure ?", method: :delete
