#changeSubscriptionModal(class="modal hide fade")
  .modal-header
    %h2 Change Subscription
  .modal-body
    .control-group
      %label.control-label Select a plan
      .controls
        = select_tag 'subscription_plan', options_from_collection_for_select(@subscription_plans, "id", "description", @current_subscription_plan.id)
  .modal-footer
    %a.btn(data-dismiss="modal") Cancel
    %a#changePlanBtn.btn.btn-primary Change


