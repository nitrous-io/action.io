%ul.devise_links
  - if controller_name != 'sessions' && !signed_in?(resource_name)
    %li
      = link_to "Sign in", new_session_path(resource_name)

  - if devise_mapping.recoverable? && controller_name != 'passwords' && !signed_in?(resource_name)
    %li
      = link_to "Forgot password?", new_password_path(resource_name)

  - if devise_mapping.confirmable? && controller_name != 'confirmations'
    %li
      = link_to "Didn't receive confirmation instructions?", new_user_confirmation_path
