#updateCardModal(class="modal hide fade")
  .modal-header
    %h2 Update Credit Card
  .modal-body
    .control-group
      %label.control-label Credit Card Number
      .controls
        = text_field_tag 'card_number'
        %span.help-inline Current Card No. #{@billing_profile.formatted_card_number}

    .control-group
      %label.control-label Expiration
      .controls
        = text_field_tag 'card_expiration', @billing_profile.expiry

    .control-group
      %label.control-label CVC
      .controls
        = text_field_tag 'card_cvc'

    .control-group
      %label.control-label Billing Zip
      .controls
        = text_field_tag 'card_billing_zip'

  .modal-footer
    #errors.hide
    %a.btn(data-dismiss="modal") Cancel
    %a#updateCardBtn.btn.btn-primary Change
