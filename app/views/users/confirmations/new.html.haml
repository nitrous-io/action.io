- @page_header = "Send Confirmation Email"

= simple_form_for resource, as: resource_name, url: confirmation_path(resource_name), html: {method: 'post'} do |f|
  = f.input :email, input_html: { value: current_user.try(:email) }, required: false

  .form-actions
    = f.button :submit, 'Send Confirmation Email', class: 'btn-info'

- content_for :bare_links do
  = render '/users/partials/links'
