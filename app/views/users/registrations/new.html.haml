- omniauth = params[:omniauth] == '1'
%header.page-header
  %h1
    - if omniauth
      You are almost there!
    - else
      New Account
= simple_form_for resource, as: resource_name, url: registration_path(resource_name), html: {class: 'form-horizontal'} do |f|
  = hidden_field_tag :omniauth, '1' if omniauth
  = f.input :username
  = f.input :full_name
  = f.input :email
  - unless omniauth
    = f.input :password
    = f.input :password_confirmation, label: 'Confirm Password'
  .form-actions
    = f.button :submit, class: 'btn-success'
  = render 'users/partials/links'

