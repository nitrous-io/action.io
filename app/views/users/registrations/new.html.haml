- omniauth = params[:omniauth] == '1'
- @page_title = omniauth ? 'Almost There!' : 'Sign up with Nitrous.IO'

- if @clone_repo
  - @html_class = 'bare steps'
  .steps
    .step.active
      %i.icon.fa.fa-user.fa-fw.fa-2x
      %strong Step 1:
      %span Sign up
    .step
      %i.icon.fa.fa-cloud-download.fa-fw.fa-2x
      %strong Step 2:
      %span Download repository

= simple_form_for resource, as: resource_name, url: registration_path(resource_name) do |f|
  = f.input :username, input_html: { autocomplete: false }
  = f.input :email, input_html: { value: (resource.email ? resource.email : params[:email]), class: 'mailcheck' }, label: 'E-Mail', required: false
  = f.input :password
  - if params[:user] && params[:user][:coupon_code].present?
    = f.input :coupon_code, as: :hidden, input_html: { value: params[:user][:coupon_code].to_s }, label: false
  - if params[:ref].present?
    = f.input :disabled_referrer_code, input_html: { value: params[:ref].to_s }, label: 'Referral Code', disabled: true
    = f.input :referrer_code, input_html: { value: params[:ref].to_s }, as: :hidden
  - else
    = f.input :referrer_code, as: :hidden
  = f.input :intent, as: :hidden, input_html: { value: params[:intent].present? ? params[:intent] : @intent }
  .form-actions
    = f.button :submit, class: 'btn', value: 'Sign Up'

- unless @clone_repo
  - content_for :bare_links do
    = render 'users/partials/links'
