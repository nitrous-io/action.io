- omniauth = params[:omniauth] == '1'
- @page_header = omniauth ? 'Almost There!' : 'Create Account'

= simple_form_for resource, as: resource_name, url: registration_path(resource_name) do |f|
  = f.input :username, input_html: { :autocomplete => false }
  = f.input :invite_code, input_html: { value: (resource.invite_code ? resource.invite_code : params[:invite_code]) }
  = f.input :email, input_html: { value: (resource.email ? resource.email : params[:email]) }
  = f.input :password
  = f.input :password_confirmation, :label => 'Confirm Password'
  .form-actions
    = f.button :submit, class: 'btn-info', value: 'Sign Up'

- content_for :bare_links do
  = render 'users/partials/links'
