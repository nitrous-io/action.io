- email = params[:email]
.container
  .inner
    %i.email-icon.icon-envelope-alt
    %h1
      Wait! One More Step!
    .well-lg.well
      - if email.blank?
        %p
          We sent you an email with instructions for confirming your account.
      - else
        %p
          We sent an email to
          %span.email
            = email.to_s
          with instructions for confirming your account.

      %small
        No email? Check your spam folder.

      - if email.present? && e = email_to_provider_website(email)
        %a.btn.btn-success.btn-block(href=e)
          Check Your Email
      - else
        %a.btn.btn-success.btn-block(href=root_url)
          Go To Homepage
