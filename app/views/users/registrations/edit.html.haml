%h2 Account Settings

= simple_form_for resource, as: resource_name, url: registration_path(resource_name), html: { class: 'form form-horizontal', method: 'put' } do |f|
  .darker-panel
    = f.input :email, input_html: { class: 'mailcheck' }
    = f.input :full_name
    = f.input :password, hint: 'Leave it blank if you don’t want to change it.', label: 'New password'
    = f.input :password_confirmation, label: 'Confirm new password'

  .darker-panel
    = f.simple_fields_for :user_profile do |p|
      = p.input :subscribed_to_monthly_newsletter, label: 'Email Subscriptions', inline_label: 'Subscribe to Monthly Newsletter'
      = p.input :subscribed_to_product_announcements, label: false, inline_label: 'Subscribe to Product Announcements'

  - if billing_profile = f.object.billing_profile
    .darker-panel
      .control-group
        %label.control-label Billing
        .controls
          %p You are using #{billing_profile.active_subscription.subscription_plan.name} plan.
          %a.btn Change Plan
          %a.btn Update Credit Card

  .darker-panel
    = f.input :current_password, hint: 'We need your current password to confirm your changes.'

  .panel
    .controls
      = f.button :submit, class: 'btn-primary'
