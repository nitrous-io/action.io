- @page_header = "Forgot Password"
= simple_form_for resource, as: resource_name, url: password_path(resource_name), html: {class: 'form-inline', method: 'post'} do |f|
  = f.input :email, required: true, :placeholder =>  "Email", :label => false, :autocomplete => true

  .form-actions
    = f.button :submit, 'Send password reset instructions', class: 'btn-primary'

- content_for :bare_links do
  = render '/users/partials/links'
