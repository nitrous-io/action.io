.container
  = simple_form_for resource, as: resource_name, url: password_path(resource_name), html: {class: 'form-horizontal', method: 'post'} do |f|
    %legend Forgot your password?

    = f.input :email

    .form-actions
      = f.button :submit, 'Send me password reset instructions', class: 'btn-primary'

  = render '/users/partials/links'

