%header.page-header
  %h1
    Sign in
= simple_form_for resource, as: resource_name, url: session_path(resource_name), html: { class: 'form-horizontal' } do |f|
  = f.input :username, required: false
  = f.input :password

  - if devise_mapping.rememberable?
    .control-group
      .controls
        %label.checkbox(for='user_remember_me')
          = f.check_box :remember_me, as: 'boolean'
          Remember me

  .form-actions
    = f.button :submit, 'Sign in', class: 'btn-primary'
    %span.or
      or
    %a.btn.github{ href: omniauth_path(provider: 'github') }
      %i
      Sign in with GitHub

  = render '/users/partials/links'

