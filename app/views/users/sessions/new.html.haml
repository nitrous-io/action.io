- @page_header = "Sign In"
= simple_form_for resource, as: resource_name, url: session_path(resource_name, redirect_to: h(params[:redirect_to])), html: { class: 'form-inline' } do |f|
  = f.input :login, required: false, autocomplete: false, label: 'Username / E-Mail'
  = f.input :password, autocomplete: false

  - if devise_mapping.rememberable?
    .control-group
      .controls
        %label.checkbox(for='user_remember_me')
          = f.check_box :remember_me, as: 'boolean'
          Remember me

  .form-actions
    = f.button :submit, 'Sign In', class: 'btn'

  #alt-auth
    %ul
      %li
        = link_to user_omniauth_authorize_path(:github), class: 'github' do
          %i.fa.fa-github-square
          GitHub
      %li
        = link_to user_omniauth_authorize_path(:google_oauth2), class: 'google' do
          %i.fa.fa-google-plus-square
          Google
      %li
        = link_to user_omniauth_authorize_path(:linkedin), class: 'linkedin' do
          %i.fa.fa-linkedin-square
          LinkedIn
    %h5 Sign in with:

- content_for :bare_links do
  = render '/users/partials/links'
