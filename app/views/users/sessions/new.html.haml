- @page_header = "Sign In"
= simple_form_for resource, as: resource_name, url: session_path(resource_name), html: { class: 'form-inline' } do |f|
  = f.input :login, required: false, autocomplete: false, label: 'Username / E-Mail'
  = f.input :password, autocomplete: false

  - if devise_mapping.rememberable?
    .control-group
      .controls
        %label.checkbox(for='user_remember_me')
          = f.check_box :remember_me, as: 'boolean'
          Remember me

  .form-actions
    = f.button :submit, 'Sign In', class: 'btn'

  = link_to user_omniauth_authorize_path(:github), class: 'btn' do
    %i Sign in with GitHub
  = link_to user_omniauth_authorize_path(:google_oauth2), class: 'btn' do
    %i Sign in with Google

- content_for :bare_links do
  = render '/users/partials/links'
