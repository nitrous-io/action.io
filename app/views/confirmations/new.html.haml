- @page_header = 'Almost There!'

= simple_form_for current_user, method: :post, url: confirmations_path do |f|
  = f.input :username, required: true, input_html: { :autocomplete => false }
  = f.input :password, required: true
  .form-actions
    = f.button :submit, class: 'btn-info', value: 'Sign Up'
