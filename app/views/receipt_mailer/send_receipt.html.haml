%p Nitrous.IO Receipt (#{formatted_date @receipt.period_start} - #{formatted_date @receipt.period_end})

- @receipt.lines.each do |line|
  %p Plan name: #{line["plan"]["name"]}

  %p Charge: #{as_currency line["amount"]}

%p Subtotal: #{as_currency @receipt.subtotal}

%p Total: #{as_currency @receipt.total}

= mixpanel_pixel_track 'Payment Receipt Received', @billing_profile.user.email
