- _account_settings_url = "https://#{web_app_url}#/account_settings"

:markdown
  ## The credit card associated with your subscription will expire soon.

  If we are unable to charge your card your plan will be downgraded. This could make some of your boxes inaccessible.
  You can update your card details from here: #{_account_settings_url}

  Current Card Details:

  Card No.: #############{@billing_profile.last_four}

  Card Type: #{@billing_profile.card_type}

  Expiry: #{@billing_profile.exp_month}/#{@billing_profile.exp_year}

= mixpanel_pixel_track 'Credit Card Expiring Alert Received', @user.email
