- _account_settings_url = web_app_url(anchor: '/account')

:markdown
  ## #{@subject}

  Your payment of #{as_currency @amount_due} for the period #{@billing_period} failed using following credit card:

  Card No.: #############{@billing_profile.last_four}

  Card Type: #{@billing_profile.card_type}

  Expiry: #{@billing_profile.exp_month}/#{@billing_profile.exp_year}

- unless @final_notice
  Please take a moment to
  = link_to "update the card", _account_settings_url
  details.

- else
  Please take a moment to
  = link_to "update the card details immediately.", _account_settings_url
  %p
    This will be your final notice before your account is frozen.

= mixpanel_pixel_track 'N2O Payment Failed Alert Received', @user.email
