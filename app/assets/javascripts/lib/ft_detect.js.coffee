AIO.FTDetect =
  detect: (fileName) ->
    return 'text/plain' unless fileName
    extension = fileName.match(/.+\.([^\.]+)$/)?[1]
    fileType = switch fileName.toLowerCase()
      when 'rakefile', 'rantfile', '.irbrc', 'irbrc', '.pryrc', 'pryrc', 'capfile', 'gemfile', 'guardfile', '.guardfile', 'vagrantfile', '.autotest', 'thorfile', 'podfile'
        'text/x-ruby'
      when 'configure'
        'text/x-sh'

    if extension && !fileType
      fileType = switch extension.toLowerCase()
        when 'rb', 'rbw', 'gemspec', 'builder', 'rxml', 'rjs', 'rake', 'rant', 'ru', 'thor', 'rabl', 'jbuilder'
          'text/x-ruby'
        when 'html'
          'text/html'
        when 'erb', 'rhtml'
          'text/x-html-erb'
        when 'css'
          'text/css'
        when 'js'
          'text/javascript'
        when 'json'
          'application/json'
        when 'ejs'
          'application/x-ejs'
        when 'coffee'
          'text/x-coffeescript'
        when 'less'
          'text/x-less'
        when 'markdown', 'md'
          'text/x-markdown'
        when 'c', 'h'
          'text/x-csrc'
        when 'cpp', 'hpp'
          'text/x-c++src'
        when 'diff'
          'text/x-diff'
        when 'lua'
          'text/x-lua'
        when 'sql', 'mysql'
          'text/x-mysql'
        when 'pl'
          'text/x-perl'
        when 'php'
          'application/x-httpd-php'
        when 'py'
          'text/x-python'
        when 'scm'
          'text/x-scheme'
        when 'sh'
          'text/x-sh'
        when 'xml'
          'application/xml'
        when 'yml', 'yaml'
          'text/x-yaml'

    fileType || 'text/plain'

