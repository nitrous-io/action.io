.container
  {{view App.HeaderView}}

  %h2 {{ view.title }}

  #animated-gauge.shaking
    .gauge-needle-shadow
    .gauge-needle
    .gauge-center

  #repository-state
    %h3.name
      %div{ bind: { class: ':stateOrb state' } }
      %span
        cloning
        %code {{ repository.clone_url }}
        into {{ name }}
