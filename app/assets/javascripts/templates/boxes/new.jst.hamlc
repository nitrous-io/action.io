.container
  != JST['templates/partials/header']()

  %h2 New Box

  %ul.stacks
    %li.selected
      %div
        .image.ruby
        Ruby/Rails
    %li.coming_soon
      %div
        .image.python
        Python/Django
    %li.coming_soon
      %div
        .image.nodejs
        Node.js
    %li.coming_soon
      %div
        .image.vanilla
        Vanilla

  %form.form-horizontal
    %fieldset
      .control-group(data-bind='css: { error: errorMessages().name }'
        %label.control-label(for='box_name') Name
        .controls
          %input(type='text' id='box_name' data-bind='value: name')
          %span.help-inline(data-bind='text: errorMessages().name')
      .control-group(data-bind='css: { error: errorMessages().region }'
        %label.control-label(for='box_region_id') Region
        .controls
          %select(id='box_region_id' data-bind='options: regions, optionsText: "description", optionsValue: "id", value: region_id')
          %span.help-inline(data-bind='text: errorMessages().region')
      .control-group
        .controls(data-bind='click: createBox')
          %button.btn-primary.btn(data-bind='disable: saving') Create Box

