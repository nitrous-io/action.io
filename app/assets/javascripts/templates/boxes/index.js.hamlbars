.container
  {{view AIO.HeaderView}}

  %h2 Boxes

  %ul.boxes.dark-list
    =hb 'each arrangedContent' do
      %li{ bind: { class: 'expanded' } }
        .title.expandable(_action='didClickTitle this target="view"')
          %div{ bind: { class: ':stateOrb state' } }
          %h3.name {{ name }}
        .details
          %table
            %tr
              %th State
              %td {{ state }}
            %tr
              %th SSH URI
              %td
                %a.link{ bind: { href: 'sshURI' } } {{ sshURI }}
            %tr
              %th Region
              %td {{ region.description }}
            %tr
              %th Stack
              %td Ruby/Rails
          .details-actions
            =hb 'if stopped' do
              %button.btn.btn-primary(_action='didClickStart this target="view"') Start
              -#%%button.btn Clone
              .pull-right
                %button.btn.btn-danger Terminate

            =hb 'if running' do
              %button.btn.btn-primary(_action='didClickIDE this target="view"') IDE
              .pull-right
                %button.btn(_action='didClickSuspend this target="view"') Suspend
                %button.btn(_action='didClickShutDown this target="view"') Shut Down
                %button.btn.btn-danger(_action='didClickTerminate this target="view"') Terminate

            =hb 'if suspended' do
              %button.btn.btn-primary Resume(_action='didClickResume this target="view"')

            =hb 'if terminated' do
              %button.btn(disabled=true) Terminated!

            =hb 'if working' do
              %button.btn(disabled=true) Please wait...

  =hb 'unless length' do
    .static-text
      %p You have not created any boxes.

  .actions
    %button.btn.btn-primary(_action='didClickNewBox target="view"')
      New Box
    %button.btn(_action='didClickRefresh target="view"')
      Refresh

