.container
  %h1 Boxes
  %ul.boxes(data-bind='foreach: boxes')
    %li.box(data-bind='css: { expanded : expanded }')
      .summary(data-bind='click: toggleDetails')
        .state(data-bind='attr: { class : "state " + state() }')
        %h3.name(data-bind='text: name')
      .details
        %table
          %tr
            %th State
            %td(data-bind='text: state')
          %tr
            %th SSH URI
            %td
              %a(data-bind='attr: { href: sshUri }, text: sshUri')
          %tr
            %th Region
            %td(data-bind='text: region().description')
          %tr
            %th Stack
            %td Ruby/Rails
        .box-actions

          / ko if: state() === 'stopped'
          %button.btn.btn-primary Start
          %button.btn Clone
          .pull-right
            %button.btn.btn-danger Terminate
          / /ko

          / ko if: state() === 'running'
          %button.btn.btn-primary(data-bind='click: openIDE') IDE
          -#%button.btn Terminal
          .pull-right
            -#%button.btn Suspend
            -#%button.btn Shut Down
            %button.btn.btn-danger(data-bind='click: terminateBox') Terminate
          / /ko

          / ko if: state() === 'suspended'
          %button.btn.btn-primary Resume
          / /ko

          / ko if: state() === 'terminated'
          %button.btn(disabled=true) Terminated!
          / /ko

          / ko ifnot: _.include(['stopped', 'running', 'suspended', 'terminated'], state())
          %button.btn(disabled=true) Please wait...
          / /ko

  / ko if: boxes().length === 0
  .no-box
    %p You do not have any box created.
  / /ko

  .actions
    %button.btn.btn-primary(data-bind='click: newBox')
      New Box
    %button.btn(data-bind='click: refreshList')
      Refresh

