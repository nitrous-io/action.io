.container
  {{view AIO.HeaderView}}

  %h2 {{ view.title }}

  #animated-gauge.shaking
    .gauge-needle-shadow
    .gauge-needle
    .gauge-center

  #repository-state
    %h3.name
      %div{ bind: { class: ':stateOrb repositoryToClone.state' } }
      %span
        Cloning
        %code {{ cloneURL }}
        into {{ name }}

