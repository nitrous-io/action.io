#nav
  %ul.nav
    %li.dropdown
      %a.dropdown-toggle.logo(data-toggle='dropdown')
        %h1 action.io
      %ul.dropdown-menu
        %li
          %a
            About Action.IO
        %li.divider
        %li
          %a
            Preferences...
    %li.dropdown
      %a.dropdown-toggle(data-toggle='dropdown') File
      %ul.dropdown-menu
        %li
          %a
            New
        %li
          %a
            %span.pull-right &#8984;E
            Open...
        %li.divider
        %li
          %a
            Close
        %li
          %a
            Save
        %li
          %a
            Save As...
        %li
          %a
            Save All
        %li.divider
        %li
          %a
            Upload Files
    %li.dropdown
      %a.dropdown-toggle(data-toggle='dropdown') Edit
      %ul.dropdown-menu
        %li
          %a
            %span.pull-right &#8984;Z
            Undo
        %li
          %a
            %span.pull-right &#8679;&#8984;E
            Redo
        %li.divider
        %li
          %a
            %span.pull-right &#8984;X
            Cut
        %li
          %a
            %span.pull-right &#8984;C
            Copy
        %li
          %a
            %span.pull-right &#8984;V
            Paste
        %li.divider
        %li
          %a
            Find &amp; Replace
        %li
          %a
            Find in Files...
        %li.divider
        %li
          %a
            %span.pull-right &#8984;L
            Go to Line...
        %li.divider
        %li
          %a
            Strip Trailing Whitespaces

    %li.dropdown
      %a.dropdown-toggle(data-toggle='dropdown') View
      %ul.dropdown-menu
        %li.sub-menu.parent
          %a
            %span.pull-right.icon-caret-right
            Themes
          %ul.dropdown-menu.sub-menu.child
            %li
              %a
                TextMate
            %li
              %a
                Railscasts

    / ko if: previewUri()
    %li.dropdown
      %a.dropdown-toggle(data-toggle='dropdown') Preview
      %ul.dropdown-menu
        %li
          %a(target='_blank' data-bind='attr: { href: previewUri() }')
            View In New Window
        %li
          %a
            View In New Tab
    / /ko

    %li
      %a Deploy
    %li
      %a
        Help
  .secondary-nav
    %ul.nav
      %li
        %a.beta-notice(data-bind='click: showBetaNotice')
          Early Private Beta: Please Read Me
      %li
        %a(href='#boxes')
          Boxes
      %li
        %a(href='#')
          Public Keys
      %li.dropdown
        %a.dropdown-toggle(data-toggle='dropdown')
          %span(data-bind='text: currentUser.username')
          %span.caret
        %ul.dropdown-menu
          %li
            %a
              Settings
          %li
            %a
              Account
          %li
            %a
              Help
          %li.divider
          %li
            %a(href='/users/sign_out' data-method='delete' rel='nofollow')
              Sign Out
#screen
  #content

    / ko with: editor
    %header
      .tabs
        %ul(data-bind='foreach: tabs')
          %li(data-bind='css: { active: active }')
            %a(data-bind='click: $parent.activateTab')
              .close_tab_button.icon-remove(data-bind='click: $parent.closeTab, clickBubble: false')
              %span(data-bind='text: title')
        .new_tab_button.btn.icon-plus(data-bind='click: newDocument')

    .editors

      / ko foreach: tabs
      .btn-toolbar(data-bind='css: { active: active }')
        .btn-group
          %button.btn(data-bind='click: saveFile')
            %i.icon-download-alt
            Save
        .btn-group
          %button.btn
            %i.icon-search
            Find
        .btn-group
          %button.btn.dropdown-toggle(data-toggle='dropdown')
            %span(data-bind='text: AIO.ACE_MODES[mode()]')
            %span.caret
          %ul.dropdown-menu(data-bind='foreach: AIO.ACE_MODES_ARRAY')
            %li
              %a(data-bind='click: $parent.setMode')
                %i(data-bind='css: { "icon-": $parent.mode() !== mode, "icon-ok": $parent.mode() === mode }')
                %span(data-bind='text: name')

        .btn-group
          %button.btn.dropdown-toggle(data-toggle='dropdown')
            %span(data-bind='text: useSoftTabs() ? "Soft Tabs:" : "Tab Size:"')
            %span(data-bind='text: tabSize')
            %span.caret
          %ul.dropdown-menu

            / ko foreach: [2, 3, 4, 8]
            %li
              %a(data-bind='click: $parent.setTabSize')
                %i(data-bind='css: { "icon-": $parent.tabSize() !== $data, "icon-ok": $parent.tabSize() === $data }')
                %span(data-bind='text: $data')
            / /ko

            %li.divider
            %li
              %a(data-bind='click: toggleUseSoftTabs')
                %i(data-bind='css: { "icon-": !useSoftTabs(), "icon-ok": useSoftTabs() }')
                Soft Tabs (Spaces)
      / /ko

      #editor
    / /ko

  #sidebar_wrapper
    #sidebar
      #sidebar_border
      .top.toolbar
        %input.path(type='text' value='~')
        .btn-group
          %button.btn(title='Change Tree Root')
            %i.icon-folder-open
          %button.btn(title='Refresh Tree' data-bind='click: rootFile.refreshTree')
            %i.icon-refresh
      .tree
        %script(type='text/html' id='file-template')
          %li
            %a(data-bind='click: openFile')

              / ko if: directory
              /   ko if: expanded
              %i.icon-caret-down
              /   /ko
              /   ko ifnot: expanded
              %i.icon-caret-right
              /   /ko
              / /ko
              / ko ifnot: directory
              %i.icon-
              / /ko

              %span(data-bind='text: relativePath, css: { loading: loading() > 0 }')

            / ko if: expanded
            %ul(data-bind='template: { name: "file-template", foreach: files }')
            / /ko

        %ul(data-bind='template: { name: "file-template", data: rootFile }')
      .bottom.toolbar.btn-toolbar
        %button.btn
          %i.icon-upload
          Upload Files
        %button.btn
          %i.icon-eye-open
          Show Hidden

  #console(data-bind='css: { fullscreen: console.fullscreen }')

    / ko with: console
    #console_border
    %header
      .tabs
        %ul(data-bind='foreach: tabs')
          %li(data-bind='css: { active: active }')
            %a(data-bind='click: $parent.activateTab')
              .close_tab_button.icon-remove(data-bind='click: $parent.closeTab, clickBubble: false')
              %span(data-bind='text: title')
        .new_tab_button.btn.icon-plus(data-bind='click: newTerminal')
        .fullscreen_button.btn.icon-fullscreen(data-bind='click: toggleFullscreen')
    #terminal

      / ko foreach: tabs
      %div(data-bind='css: { active: active }')
        %iframe(scrolling='no' data-bind='attr: { src: "/boxes/" + id() + "/terminal" }')
      / /ko
    / /ko

  #beta_notice.modal.hide.fade
    .modal-header
      %button.close(data-dismiss='modal') &#215;
      %h3 Thanks For Joining Our Early Private Beta
    .modal-body
      %p Please keep the following in mind:
      %ol
        %li You are using a super early beta. Many features are still unimplemented.
        %li Action.IO is not yet production ready. Do not rely on it for mission-critical tasks.
        %li Expect data-loss. Always keep a backup of all your work.
        %li Resource usage is not capped for this beta, please refrain from abusing your account.
        %li
          Visit
          %a.link(href='http://help.action.io/') http://help.action.io/
          or email us at
          %a.link(href='mailto:help@action.io') help@action.io
          for bug reports, feature requests and other feedback.
    .modal-footer
      %button.btn(data-dismiss='modal') Okay

