#screen
  #content
    %header
      .tabs
        %ul
          %li.active
            %a
              .close_tab_button.icon-remove
              home_controller.rb
          %li
            %a
              .close_tab_button.icon-remove
              localhost:3000
        .new_tab_button.btn.icon-plus
      .btn-toolbar
        .btn-group
          %button.btn
            %i.icon-download-alt
            Save
        .btn-group
          %button.btn
            %i.icon-search
            Find
        .btn-group
          %button.btn.dropdown-toggle(data-toggle='dropdown')
            Ruby
            %span.caret
          %ul.dropdown-menu
            %li
              %a
                %i.icon-none
                Plain Text
            %li
              %a
                %i.icon-none
                CSS
            %li
              %a
                %i.icon-none
                HTML
            %li
              %a
                %i.icon-none
                JavaScript
            %li
              %a
                %i.icon-ok
                Ruby
        .btn-group
          %button.btn.dropdown-toggle(data-toggle='dropdown')
            Soft Tabs: 2
            %span.caret
          %ul.dropdown-menu
            %li
              %a
                %i.icon-ok
                2
            %li
              %a
                %i.icon-none
                3
            %li
              %a
                %i.icon-none
                4
            %li
              %a
                %i.icon-none
                8
            %li.divider
            %li
              %a
                %i.icon-ok
                Soft Tabs (Spaces)
    #editor
  #sidebar_wrapper
    #sidebar
      #sidebar_border
      .top.toolbar
        %input.path(type='text' value='~/foobar')
        .btn-group
          %button.btn(title='Change Root Folder')
            %i.icon-folder-open
          %button.btn(title='Refresh Tree')
            %i.icon-refresh
      .tree
        %script(type='text/html' id='file-template')
          %li
            %a(data-bind='click: toggleExpanded')

              / ko if: directory
              /   ko if: expanded
              %i.icon-caret-down
              /   /ko
              /   ko ifnot: expanded
              %i.icon-caret-right
              /   /ko
              / /ko
              / ko ifnot: directory
              %i.icon-
              / /ko

              %span(data-bind='text: relativePath')

            / ko if: expanded
            %ul(data-bind='template: { name: "file-template", foreach: files }')
            / /ko

        %ul(data-bind='template: { name: "file-template", data: rootFile }')
      .bottom.toolbar.btn-toolbar
        %button.btn
          %i.icon-upload
          Upload Files
        %button.btn
          %i.icon-eye-open
          Show Hidden
  #console(data-bind='attr : { class: console.fullscreen() ? "fullscreen" : "" }')

    / ko with: console
    #console_border
    %header
      .tabs
        %ul(data-bind='foreach: terminals')
          %li(data-bind='attr: { class: active() ? "active" : "" }')
            %a(data-bind='click: $parent.activateTerminal')
              .close_tab_button.icon-remove(data-bind='click: $parent.closeTerminal, clickBubble: false')
              %span(data-bind='text: title')
        .new_tab_button.btn.icon-plus(data-bind='click: newTerminal')
        .fullscreen_button.btn.icon-fullscreen(data-bind='click: toggleFullscreen')
    #terminal

      / ko foreach: terminals
      %div(data-bind='attr: { class: active() ? "active" : "" }')
        %iframe(scrolling='no' data-bind='attr: { src: "/boxes/" + id() + "/terminal" }')
      / /ko
    / /ko

