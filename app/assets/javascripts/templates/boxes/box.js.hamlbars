.title.expandable(_action='didClickBoxTitle this target="view"')
  %div{ bind: { class: ':stateOrb stateForOrb' } }
  %h3.name {{ name }}

.details
  =hb 'if region.enabled' do
    %table
      %tr
        %th State
        %td
          {{ state }}
          =hb 'if terminated' do
            %a.explain.icon-question-sign(title="Terminated boxes will be removed automatically after couple of hours" href="#")
      %tr
        %th SSH URI
        %td
          =hb 'unless terminated' do
            %a.link{ bind: { href: 'sshURI' } } {{ sshURI }}
      %tr
        %th Region
        %td {{ region.description }}
      %tr
        %th Stack
        %td {{ boxTemplate.name }}
      %tr
        %th Preview URI
        %td
          =hb 'unless terminated' do
            https://{{ boxHost }}:&lt;port&gt;
      %tr
        %th Public Key
        %td
          =hb 'if running' do
            =hb 'unless public_key' do
              =hb 'unless loadingPublicKey' do
                %a.link(_action='didClickRevealPublicKey this target="view"')
                  Reveal Public Key
                =hb 'else' # if loadingPublicKey
                %span.loading Fetching Public Key...
              =hb 'else' # if public_key
              {{view AIO.SelectableTextField class="box_text_field" valueBinding="public_key"}}

              =hb 'if owner.isGithubAuthenticated' do
                =hb 'unless addingPublicKeyToGitHub' do
                  %a.link(_action='didClickAddToGitHub this target="view"') Add to GitHub
                  =hb 'else' # if addingPublicKeyToGitHub
                  %span.loading Adding Public Key to GitHub...
                =hb 'else'
                %a.link(href='/users/edit') Add to GitHub
            {{ publicKeyInfo }}

    .details-actions
      =hb 'if underMaintenance' do
        %button.btn(disabled=true)
          Under Maintenance!

      =hb 'if archived' do
        %button.btn.btn-primary(_action='didClickUnarchive this target="view"'){ bind: { disabled: 'loading' } }
          Start

      =hb 'if stopped' do
        %button.btn.btn-primary(_action='didClickStart this target="view"'){ bind: { disabled: 'loading' } }
          Start
        %span.help-inline
          {{ firstErrors.base }}
        .pull-right
          %button.btn.btn-danger(_action='didClickTerminate this target="view"'){ bind: { disabled: 'loading' } }
            Terminate
          %button.btn.btn-danger(_action='didClickArchive this target="view"'){ bind: { disabled: 'loading' } }
            Archive

      =hb 'if running' do
        %button.btn.btn-primary(_action='didClickIDE this target="view"'){ bind: { disabled: 'loading' } }
          IDE
        %span.help-inline
          {{ firstErrors.base }}
        .pull-right
          %button.btn(_action='didClickRestart this target="view"'){ bind: { disabled: 'loading' } }
            Restart
          %button.btn(_action='didClickShutDown this target="view"'){ bind: { disabled: 'loading' } }
            Shut Down

      =hb 'if terminated' do
        %button.btn(disabled=true)
          Terminated!

      =hb "if 'under maintenance'" do
        %button.btn(disabled=true)
          Under Maintenance!

      =hb 'if provisioning' do
        %button.btn(_action='didClickProvisioning this target="view"')
          Provisioning...

      =hb 'if working' do
        %button.btn(disabled=true)
          Please wait...

    =hb 'else' # if region.enabled
    %table
      %tr
        %th State
        %td Under Maintenance
