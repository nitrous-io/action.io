.container
  {{view AIO.HeaderView}}

  %h2 New Box

  %ul.stacks
    %li.selected
      %div
        .image.ruby
        Ruby/Rails
    %li.coming_soon
      %div
        .image.python
        Python/Django
    %li.coming_soon
      %div
        .image.nodejs
        Node.js
    %li.coming_soon
      %div
        .image.vanilla
        Vanilla

  %form.form-horizontal
    %fieldset
      =hb 'view class="control-group" classBinding="errors.name:error"' do
        %label.control-label(for='box_name') Name
        .controls
          {{view Ember.TextField id="box_name" placeholder="my-awesome-box" valueBinding="name" disabledBinding="saving"}}
          %span.help-inline {{ firstErrors.name }}
      =hb 'view class="control-group" classBinding="errors.region_id:error"' do
        %label.control-label(for='box_region_id') Region
        .controls
          {{view Ember.Select id="box_region_id" contentBinding="AIO.router.regionsIndexController.content" optionLabelPath="content.description" optionValuePath="content.id" valueBinding="region_id" prompt="Select Your Region" disabledBinding="saving"}}
          %span.help-inline {{ firstErrors.region_id }}
      .control-group
        .controls
          {{view AIO.Button text="Create Box" class="btn-primary" target="parentView" action="didClickSaveButton" disabledBinding="saving"}}
          {{view AIO.Button text="Cancel" target="parentView" action="didClickCancelButton" disabledBinding="saving"}}

