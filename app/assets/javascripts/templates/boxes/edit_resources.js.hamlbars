.container
  {{view AIO.HeaderView}}

  %h2 Settings for {{ view.name }}

  %ul.nav.nav-tabs.dark
    %li.active
      %a
        %i.icon.icon-desktop
        Resources
    =hb 'if AIO.currentUser.private_snapshots_enabled' do
      %li
        %a(_action='didClickSnapshots this target="view"')
          %i.icon.icon-camera-retro
          Snapshots

  .settings-pane
    .info
      %p
        Note:
        =hb 'if running' do
          Changes will take effect shortly after saving. A restart will not be necessary.
          =hb 'else'
          Changes will take place the next time your box is started.

    %form.form-horizontal
      %div.control-group
        %label.control-label Memory
        .controls
          {{view AIO.SliderView valueBinding="memory" minBinding="AIO.minMemoryMB" max="AIO.maxMemoryMB" step=128 unit=" MB"}}
          .usage-details
            =hb 'if view.memoryUsageDetails' do
              {{view.memoryUsageDetails}}
              =hb 'else'
              fetching current memory usage
          .n2o-cost
            %i.icon-bolt
            {{ view.memoryCostChange }}

      %div.control-group
        %label.control-label Storage
        .controls
          {{view AIO.SliderView valueBinding="storage" min="AIO.minStorageMB" max="AIO.maxStorageMB" step=250 unit=" MB"}}
          %div{ bind: { class: ':usage-details view.insufficientStorage:error' } }
            =hb 'if view.storageUsageDetails' do
              {{view.storageUsageDetails}}
              =hb 'else'
              fetching current storage
          .n2o-cost
            %i.icon-bolt
            {{ view.storageCostChange }}

      %div.control-group
        %label.control-label Remaining N2O
        .controls.remaining-n2o-slider
          {{view AIO.SliderView valueBinding="view.remainingN2O" min=0 maxBinding="view.maxN2O" step=1 readOnly=true}}
          .n2o-cost
            %i.icon-bolt
            {{ view.totalCostChange }}

      %div{ bind: { class: ':control-group errors.base:error view.insufficientN2O:error' } }
        .controls
          %button.btn.btn-primary(_action='didClickChangeBox target="view"'){ bind: { disabled: 'view.saveChangesButtonDisabled' } }
            Save Changes
          %button.btn(_action='didClickCancel target="view"'){ bind: { disabled: 'saving' } }
            Cancel
          %span.help-inline
            {{ firstErrors.base }}
            =hb 'if view.insufficientN2O' do
              You do not have enough N2O to reconfigure your box.
              %a.link(href="/app#n2o/bonus") Get More
            =hb 'if view.insufficientStorage' do
              You are using more storage than the requested amount.
