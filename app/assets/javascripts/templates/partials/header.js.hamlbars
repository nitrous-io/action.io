%header#page-header
  .header-logo
  %h1
    %a(href='#') nitrous.io
  %ul.header-nav
    =hb 'if AIO.router.applicationController.currentUser.isAbleToInvite' do
      %li
        %a(href='/invites') Invites
    %li
      %a(href='#/boxes') Boxes
    %li
      %a(href='#/public_keys') Public Keys
    %li.dropdown
      %a.dropdown-toggle(data-toggle='dropdown')
        %span {{ AIO.router.applicationController.currentUser.username }}
        %span.caret
      %ul.dropdown-menu
        %li
          %a(href='/users/edit' target='_blank')
            Account Settings
        %li
          %a(href='/oauth/authorized_applications' target='_blank')
            Applications
        %li
          %a(href='#/vagrant')
            Vagrant Settings
        %li.divider
        %li
          %a(href='/users/sign_out' data-method='delete' rel='nofollow')
            Sign Out
%hr#header-bottom

