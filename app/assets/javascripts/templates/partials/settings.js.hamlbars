%ul.nav.nav-tabs.dark
  %li{ bind: { class: 'view.resourcesTabActive:active' } }
    %a(_action='didClickResources target="view"')
      %i.icon.icon-desktop
      Resources
  =hb 'if view.box.custom_domains_allowed' do
    %li{ bind: { class: 'view.domainTabActive:active' } }
      %a(_action='didClickDomain target="view"')
        %i.icon.icon-link
        Custom Domain
  =hb 'if AIO.currentUser.private_snapshots_enabled' do
    %li{ bind: { class: 'view.snapshotsTabActive:active' } }
      %a(_action='didClickSnapshots target="view"')
        %i.icon.icon-camera-retro
        Snapshots
