.container
  {{view App.HeaderView}}

  .web-app-container{ style: "padding: 20px 0" }
    %h1.title Hack on Nitrous.IO

    .row
      .span6
        %div{ bind: { class: ':alert :alert-error errors::hide' } }
          {{ errors }}

        .repo-info
          %i.icon.fa.fa-github.fa-4x

          .desc
            .name
              %span.author {{ author }}
              \/
              %span.short-name {{ shortName }}
            %a{ bind: { href: 'clone_url' } }
              %code {{ clone_url }}

        .picker.clearfix
          .new-box.clickable.btn.btn-success{_action: 'newBox'}
            Start hacking in a new box

          =hb 'if eligibleBoxes.length' do
            .or or use one of these boxes:

            %ul.boxes.dark-list
              =hb 'each eligibleBoxes' do
                %li
                  .title.clickable(_action='didClickExistingBox this target="view"')
                    %div{ bind: { class: ':image boxTemplate.runtime' } }
                    %h3 {{ name }}

              =hb 'each ineligibleBoxes' do
                %li
                  .title.disabled
                    %div{ bind: { class: ':stateOrb stateForOrb' } }
                    %h3
                      {{ name }}
                      .pull-right
                        .state
                          {{ stateForDisplay }}

      .span5.offset1
        .faq
          %i.fa.fa-code-fork.fa-2x.fa-fw
          %h3 Hack on Nitrous.IO
          %p
            Download this repository into one of your existing boxes, or into a new box.

          %i.fa.fa-code.fa-2x.fa-fw
          %h3 Get your own Hack Button
          %p
            You can create your own Hack on Nitrous.IO button for any public git repository. You can embed this button on any website so developers can start working on your project in seconds.

            %a.more.link{ href: hack_button_embed_path } Get your own button &raquo;

          =hb 'if ineligibleBoxes.length' do
            %i.fa.ineligible.fa-warning.fa-2x.fa-fw
            %h3 Ineligible Boxes
            %p
              It appears you have a box that is stuck in a transition state. You cannot download a repository into a box that is in a starting / stopping state.

          =hb 'unless App.currentUser.hasN2OForNewBox' do
            %i.fa.moren2o.fa-plus-square.fa-2x.fa-fw
            %h3 Creating a New Box
            %p
              Creating a new box will require additional N2O. If you need to create a
              new box to download this repository, you can
              =hb 'if App.subscription.active' do
                %a.link{ href: pricing_path }(_action='didClickUpgradePage target="view"') upgrade
                your plan.
                =hb 'else'
                %a.link{ href: pricing_path }(_action='didClickUpgradePage target="view"') subscribe
                to a paid plan.

              %a.more.link{ href: pricing_path }(_action='didClickUpgradePage target="view"')
                See all plans and pricing &raquo;
