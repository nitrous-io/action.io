.container
  {{view AIO.HeaderView}}

  %h2 Upgrade your account

  %form.form-horizontal(autocomplete="on" method="post")
    %ul.plans.thumbnails
      =hb 'each plans' do
        {{view AIO.PlanView planBinding="this"}}

    %div#addCreditCard{ bind: { class: 'billingProfile.exists:hide'} }
      %div{ bind: { class: ':control-group card.errors.number:error' } }
        %label.control-label(for='card_number') Credit Card Number
        .controls
          {{view Ember.TextField id="card_number" valueBinding="card.number" pattern="\d*" autocompletetype="cc-number"}}

      %div{ bind: { class: ':control-group card.errors.expiration:error' } }
        %label.control-label(for='card_expiration') Expiration
        .controls
          {{view Ember.TextField id="card_expiration" placeholder="MM/YYYY" valueBinding="card.expiration"}}

      %div{ bind: { class: ':control-group card.errors.cvc:error' } }
        %label.control-label(for='card_cvc') CVC
        .controls
          {{view Ember.TextField id="card_cvc" valueBinding="card.cvc" autocomplete="off"}}

      %div{ bind: { class: ':control-group card.errors.billingZip:error' } }
        %label.control-label(for='card_billing_zip') Billing Zip
        .controls
          {{view Ember.TextField id="card_billing_zip" placeholder="Only required if you live in the U.S." valueBinding="card.billingZip"}}

    =hb 'if billingProfile.exists' do
      %div#currentCreditCardDetails
        Current Credit Card on file: '{{billingProfile.formatted_card_number}}' ({{billingProfile.card_type}}).
        %a(_action='didClickChangeCreditCard target="view"') Use a different Card

    %div
      Please review the
      %a(href="http://help.nitrous.io/admin-terms/" target="_blank") terms of service,
      and
      %a(href="http://help.nitrous.io/admin-privacy/" target="_blank") privacy policy.
      All sales are final — no refunds.

    %div{ bind: { class: ':control-group' } }
      %button.btn.upgrade_btn(_action='didClickUpgrade target="view"'){ bind: { disabled: 'processing' } }
        Upgrade
      %p {{processingErrorMessage}}
