.container
  {{view AIO.HeaderView}}

  %h2.title Upgrade your account

  =hb 'if AIO.currentUser.team_plans_enabled' do
    %h3 Personal Plans

    %p For developers looking to work on open source / side projects

  {{view AIO.PlanSelectionView plansBinding='personalPlansController'}}

  =hb 'if AIO.currentUser.team_plans_enabled' do
    %h3 Team Plans

    %p For teams that have many team members with varying permissions

    {{view AIO.PlanSelectionView plansBinding='teamPlansController' showCommonFeatures=true}}

  .common-paid-features
    %h4 All Paid Plans Come With:
    .row
      %ul.span6
        %li
          %i.fa.fa-check
          No Automatic Shut Downs
        %li
          %i.fa.fa-check
          Direct SSH Access
      %ul.span5
        %li
          %i.fa.fa-check
          SSL Protection (US and Europe regions only)
        %li
          %i.fa.fa-check
          Premium Support

  %p.free-text
    Free plans start with 150 N2O, with the ability to
    %a.link(href='#/n2o/bonus') earn additional resources.
    &nbsp;Each box is limited to {{AIO.maxMemoryGB}}GB of Memory and {{AIO.maxStorageGB}}GB of Storage.

  %hr
  .row.paymentInfo
    .billingInfoContainer.span8
      #addCreditCard
        =hb 'if processingErrorMessage' do
          %p.alert.alert-error {{ processingErrorMessage }}

        {{view AIO.CreditCardView cardBinding=card}}
        %p.note.small.muted
          Please review the
          %a.link(href="http://help.nitrous.io/admin-terms/" target="_blank") terms of service,
          and
          %a.link(href="http://help.nitrous.io/admin-privacy/" target="_blank") privacy policy.
          All sales are final — no refunds.

      %div{ bind: { class: ':control-group :submitBlock' } }
        %button.btn.btn-success(_action='didClickUpgrade target="view"'){ bind: { disabled: 'processing' } }
          Upgrade Account

    .planInfoContainer.span4
      .planInfo
        .planInfoHeader
          %h3 {{selectedPlan.name}}
          .subheader
            {{AIO.currentUser.email}}

        =hb 'if AIO.currentUser.coupon' do
          .lineItem
            .lineItemName
              Regular price
            .lineItemValue
              {{selectedPlan.formattedPrice}}

          .lineItem
            .lineItemName
              Discount
            .lineItemValue
              {{view.formattedDiscount}}

        .lineItem
          .lineItemName
            Total
          .lineItemValue
            {{view.formattedTotal}}

        =hb 'if AIO.currentUser.coupon' do
          %p.note.small.muted
            Coupon applied:
            {{AIO.currentUser.coupon.code}}
            %br
              ({{AIO.currentUser.coupon.description}})

  %hr
  {{view AIO.PricingFaqView}}

{{view AIO.ConfirmUpgradeDialogView}}
