.container
  {{view AIO.HeaderView}}

  %h2.title Upgrade your account

  {{view AIO.PlanSelectionView}}

  %hr
  .row.paymentInfo
    .billingInfoContainer.span8
      #addCreditCard
        =hb 'if processingErrorMessage' do
          %p.alert.alert-error {{ processingErrorMessage }}

        {{view AIO.CreditCardView cardBinding=card}}
        %p.note.small.muted
          Please review the
          %a.link(href="http://help.nitrous.io/admin-terms/" target="_blank") terms of service,
          and
          %a.link(href="http://help.nitrous.io/admin-privacy/" target="_blank") privacy policy.
          All sales are final — no refunds.

      %div{ bind: { class: ':control-group :submitBlock' } }
        %button.btn.btn-success(_action='didClickUpgrade target="view"'){ bind: { disabled: 'processing' } }
          Upgrade Account

    .planInfoContainer.span4
      .planInfo
        .planInfoHeader
          %h3 {{selectedPlan.name}}
          .subheader
            {{AIO.currentUser.email}}

        =hb 'if AIO.currentUser.coupon' do
          .lineItem
            .lineItemName
              Regular price
            .lineItemValue
              {{selectedPlan.formattedPrice}}

          .lineItem
            .lineItemName
              Discount
            .lineItemValue
              {{view.formattedDiscount}}

        .lineItem
          .lineItemName
            Total
          .lineItemValue
            {{view.formattedTotal}}

        =hb 'if AIO.currentUser.coupon' do
          %p.note.small.muted
            Coupon applied:
            {{AIO.currentUser.coupon.code}}
            %br
              ({{AIO.currentUser.coupon.description}})

  %hr
  {{view AIO.PricingFaqView}}

{{view AIO.ConfirmUpgradeDialogView}}
