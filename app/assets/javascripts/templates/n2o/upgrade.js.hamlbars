.container
  {{view AIO.HeaderView}}

  =hb 'unless billingProfile.active' do
    %h2 Upgrade your account
    =hb 'else'
    %h2 Change plan

  %form.form-horizontal(autocomplete="on" method="post")
    #plansContainer
      %ul.plans
        =hb 'each plans' do
          {{view AIO.PlanView planBinding="this"}}

    #addCreditCard{ bind: { class: 'billingProfile.active:hide'} }
      =hb 'if processingErrorMessage' do
        %p.alert.alert-error {{processingErrorMessage}}

      {{view AIO.CreditCardView cardBinding=card}}
      %p.note.small.muted
        Please review the
        %a(href="http://help.nitrous.io/admin-terms/" target="_blank") terms of service,
        and
        %a(href="http://help.nitrous.io/admin-privacy/" target="_blank") privacy policy.
        All sales are final — no refunds.

    =hb 'if billingProfile.active' do
      #currentCreditCardDetails
        Current Credit Card on file: '{{billingProfile.formatted_card_number}}' ({{billingProfile.card_type}}).
        %a(_action='didClickChangeCreditCard target="view"') Use a different Card

    #submitButtonBlock{ bind: { class: ':control-group' } }
      %button.btn.btn-success(_action='didClickUpgrade target="view"'){ bind: { disabled: 'processing' } }
        =hb 'unless billingProfile.active' do
          Upgrade Account
          =hb 'else'
          Change Plan
