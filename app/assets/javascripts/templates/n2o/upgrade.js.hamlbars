.container
  {{view AIO.HeaderView}}

  =hb 'unless billingProfile.active' do
    %h2.title Upgrade your account
    =hb 'else'
    %h2.title Change plan

  %form.form-horizontal(autocomplete="on" method="post")
    #plansContainer
      %ul.plans
        =hb 'each plans.arrangedContent' do
          {{view AIO.PlanView planBinding="this"}}
      .common-paid-features
        %h4 All Paid Plans Come With:
        .row
          %ul.span6
            %li
              %i.icon-ok
              No Automatic Shut Downs
            %li
              %i.icon-ok
              Direct SSH Access
          %ul.span5
            %li
              %i.icon-ok
              SSL Protection (coming soon)
            %li
              %i.icon-ok
              Premium Support

  %p.free-text
    Free plans start with 150 N2O, with the ability to
    %a.link(href='#/n2o/bonus') earn additional resources.

  %hr

  .row.paymentInfo
    .billingInfoContainer.span8
      #addCreditCard{ bind: { class: 'billingProfile.active:hide'} }
        =hb 'if processingErrorMessage' do
          %p.alert.alert-error {{processingErrorMessage}}

        {{view AIO.CreditCardView cardBinding=card}}
        %p.note.small.muted
          Please review the
          %a.link(href="http://help.nitrous.io/admin-terms/" target="_blank") terms of service,
          and
          %a.link(href="http://help.nitrous.io/admin-privacy/" target="_blank") privacy policy.
          All sales are final — no refunds.

      =hb 'if billingProfile.active' do
        #currentCreditCardDetails
          .icon
            %i.icon-credit-card
          .meta
            Current Card on file: '{{billingProfile.formatted_card_number}}' ({{billingProfile.card_type}}).
            %a(_action='didClickChangeCreditCard target="view"') Use a different Card

      %div{ bind: { class: ':control-group :submitBlock' } }
        %button.btn.btn-success(_action='didClickUpgrade target="view"'){ bind: { disabled: 'view.upgradeButtonDisabled' } }
          =hb 'unless billingProfile.active' do
            Upgrade Account
            =hb 'else'
            Change Plan

    .planInfoContainer.span4
      .planInfo
        .planInfoHeader
          %h3 {{selectedPlan.name}}
          .subheader
            {{AIO.currentUser.email}}

        .lineItem
          .lineItemName
            Total
          .lineItemValue
            {{selectedPlan.priceFormatted}}

  %hr
  .pricingContainer
    %h3 Questions about Pricing?
    .row
      .span6
        %h4 How long does N2O last?
        %p Once you purchase N2O, it will remain in your account while your subscription is active.  When you utilize N2O, for example, when you create boxes, you will see your available N2O decrease in your usage meter.

        %h4 So can I ever lose N2O?
        %p You will only lose purchased N2O capacity if you cancel your subscription.  You utilize N2O when you create boxes, and then when you terminate those boxes, the N2O is made available again for new boxes or upgrading existing boxes.

      .span5.offset1
        %h4 When does the billing cycle begin?
        %p The billing cycle starts on the day you upgrade your account and is billed every month on the anniversary of when your account was created.

        %h4 What happens if I want to upgrade, downgrade, or cancel my subscription?
        %p The monthly subscription cost will be pro-rated if changed to another plan, but not if the plan is canceled.

