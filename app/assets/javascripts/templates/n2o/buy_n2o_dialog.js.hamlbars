.modal-header
  %h3
    Buy N2O
.modal-body

  %form.form-horizontal(autocomplete="on" method="post")
    %div{ bind: { class: ':control-group' } }
      %label.control-label(for='subscription_plan') Select a plan
      .controls
        {{view Ember.Select id="subscription_plan" contentBinding="view.content.plans" valueBinding="view.content.selectedPlan" optionValuePath='content.id' optionLabelPath='content.description'}}

    %div{ bind: { class: ':control-group view.content.card.errors.number:error' } }
      %label.control-label(for='card_number') Credit Card Number
      .controls
        {{view Ember.TextField id="card_number" valueBinding="view.content.card.number" pattern="\d*" autocompletetype="cc-number"}}

    %div{ bind: { class: ':control-group view.content.card.errors.expiration:error' } }
      %label.control-label(for='card_expiration') Expiration
      .controls
        {{view Ember.TextField id="card_expiration" placeholder="MM/YYYY" valueBinding="view.content.card.expiration"}}

    %div{ bind: { class: ':control-group view.content.card.errors.cvc:error' } }
      %label.control-label(for='card_cvc') CVC
      .controls
        {{view Ember.TextField id="card_cvc" valueBinding="view.content.card.cvc" autocomplete="off"}}

    %div{ bind: { class: ':control-group view.content.card.errors.billingZip:error' } }
      %label.control-label(for='card_billing_zip') Billing Zip
      .controls
        {{view Ember.TextField id="card_billing_zip" placeholder="Only required if you live in the U.S." valueBinding="view.content.card.billingZip"}}

    %div
      Please review the
      %a(href="http://help.nitrous.io/admin-terms/") terms of service,
      and
      %a(href="http://help.nitrous.io/admin-privacy/") privacy policy.
      All sales are final — no refunds.

.modal-footer
  %p {{view.processingErrorMessage}}
  %button.btn(_action='didClickCancel target="view"')
    Cancel
  %button.btn(_action='didClickBuy target="view"'){ bind: { disabled: 'view.processing' } }
    Buy
