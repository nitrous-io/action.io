.modal-header
  %h3
    Buy N2O
.modal-body

  %form.form-horizontal
    %div{ bind: { class: ':control-group' } }
      %label.control-label(for='subscription_plan') Select a plan
      .controls
        {{view Ember.Select id="subscription_plan" contentBinding="view.plans" optionValuePath='content.id' optionLabelPath='content.name'}}

    %div{ bind: { class: ':control-group' } }
      %label.control-label(for='card_number') Credit Card Number
      .controls
        {{view Ember.TextField id="card_number" valueBinding="view.card.number"}}

    %div{ bind: { class: ':control-group' } }
      %label.control-label(for='card_expiration') Expiration
      .controls
        {{view Ember.TextField id="card_expiration" placeholder="MM/YYYY" valueBinding="view.card.expiration"}}

    %div{ bind: { class: ':control-group' } }
      %label.control-label(for='card_cvc') CVC
      .controls
        {{view Ember.TextField id="card_cvc" valueBinding="view.card.cvc"}}

    %div{ bind: { class: ':control-group' } }
      %label.control-label(for='card_billing_zip') Billing Zip
      .controls
        {{view Ember.TextField id="card_billing_zip" valueBinding="view.card.billing_zip"}}

.modal-footer
  %button.btn(_action='didClickCancel target="view"')
    Cancel
  %button.btn(_action='didClickBuy target="view"'){ bind: { disabled: 'view.messageInvalid' } }
    Buy
