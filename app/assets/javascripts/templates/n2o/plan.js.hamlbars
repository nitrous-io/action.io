%h3
  {{name}}
  =hb 'if highlight' do
    %small Most Popular

.n2o-amount
  %span.amount {{n2o_amount}}
  N2O

%ul.plan-features
  %li {{ cpu_multiplier }}x CPU Share
  %li {{ vmem_multiplier }}x Virtual Memory
  =hb 'if view.notStartPlan' do
    %li
      Custom Domains
      %small (coming soon)

.pricing
  $ {{price}}
  %span.interval / mo.

=hb 'if view.isCurrentPlan' do
  .currentPlan
    %h6 Current Plan
