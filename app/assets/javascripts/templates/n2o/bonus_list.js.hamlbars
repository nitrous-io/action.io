%ul.dark-list
  =hb 'if content.accepted_invite' do
    {{view AIO.N2oBonusItemView name="Accept Invitation" icon="icon-star" completed=true}}

  {{view AIO.N2oBonusItemView name="Complete Sign Up" icon="icon-user" completed=true hiddenBinding="isIntro"}}
  =hb 'if AIO.paymentsEnabled' do
    {{view AIO.N2oBonusItemView name="Buy N2O" rewardBinding="bonusInfo.upgrade_account" icon="icon-dollar" targetBinding="view" route="n2o.upgrade" class="buy-n2o"}}
  {{view AIO.N2oBonusItemView name="Invite Friends & Colleagues" icon="icon-group" completedBinding="content.invite_friends" rewardBinding="bonusInfo.invite_friends" route="invites.index" hiddenBinding="isIntro"}}
  =hb 'if view.isUsingChrome' do
    {{view AIO.N2oBonusItemView name="Install Chrome App" icon="icon-google-plus-sign" completedBinding="content.chrome_app" rewardBinding="bonusInfo.chrome_app" targetBinding="view" action="installChromeApp" hiddenBinding="isIntro"}}
  =hb 'if isIntro' do
    {{view AIO.N2oBonusItemView name="Connect GitHub"   icon="icon-github"      completedBinding="content.github"   rewardBinding="bonusInfo.github"    url="/users/auth/github" oauth=true popup=true}}
    {{view AIO.N2oBonusItemView name="Connect Google"   icon="icon-google-plus" completedBinding="content.google"   rewardBinding="bonusInfo.google"    url="/users/auth/google_oauth2" oauth=true popup=true width=500 height=600}}
    {{view AIO.N2oBonusItemView name="Connect Twitter"  icon="icon-twitter"     completedBinding="content.twitter"  rewardBinding="bonusInfo.twitter"   url="/users/auth/twitter" oauth=true popup=true width=700 height=500}}
    =hb 'else'
    {{view AIO.N2oBonusItemView name="Tell Us How You Work" icon="icon-laptop" completedBinding="content.user_survey_1" rewardBinding="bonusInfo.user_survey_1" hiddenBinding="hideUserSurvey1Bonus" url="/user-survey-1"}}
    {{view AIO.N2oBonusItemView name="Get in line for Nitrous for Business" icon="icon-bolt" completedBinding="content.business_survey" rewardBinding="bonusInfo.business_survey" hiddenBinding="hideBusinessSurveyBonus" url="/business"}}
    {{view AIO.N2oBonusItemView name="Connect GitHub"   icon="icon-github"      completedBinding="content.github"   rewardBinding="bonusInfo.github"    url="/users/auth/github" oauth=true popup=true}}
    {{view AIO.N2oBonusItemView name="Connect Google"   icon="icon-google-plus" completedBinding="content.google"   rewardBinding="bonusInfo.google"    url="/users/auth/google_oauth2" oauth=true popup=true width=500 height=600}}
    {{view AIO.N2oBonusItemView name="Connect Facebook" icon="icon-facebook"    completedBinding="content.facebook" rewardBinding="bonusInfo.facebook"  url="/users/auth/facebook" oauth=true popup=true width=1000 height=600}}
    {{view AIO.N2oBonusItemView name="Connect LinkedIn" icon="icon-linkedin"    completedBinding="content.linkedin" rewardBinding="bonusInfo.linkedin"  url="/users/auth/linkedin" oauth=true}}
    {{view AIO.N2oBonusItemView name="Connect Twitter"  icon="icon-twitter"     completedBinding="content.twitter"  rewardBinding="bonusInfo.twitter"   url="/users/auth/twitter" oauth=true popup=true width=700 height=500}}

  {{view AIO.N2oBonusItemView name="Follow @nitrousio on Twitter" icon="icon-twitter"  completedBinding="content.twitter_follow" rewardBinding="bonusInfo.twitter_follow" enabledBinding="content.twitter" targetBinding="view" action="followOnTwitter"}}
  {{view AIO.N2oBonusItemView name="Tweet about Nitrous.IO" icon="icon-twitter"  completedBinding="content.tweet_sent" rewardBinding="bonusInfo.tweet_sent" enabledBinding="content.twitter" targetBinding="view" action="composeTweet"}}
