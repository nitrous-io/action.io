.modal-header
  %h3
    Share why you love Nitrous.IO on Twitter
.modal-body
  %p
    I love @NitrousIO because
  .form-horizontal
    %div
      {{view AIO.ComposeTweetDialogTextField id="message" valueBinding="view.message" placeholder="it is cool"}}

.modal-footer
  %button.btn(_action='didClickCancel target="view"')
    Cancel
  %button.btn(_action='didClickSendTweet target="view"'){ bind: { disabled: 'view.messageInvalid' } }
    Tweet
