.container
  {{view AIO.HeaderView}}

  %h2 SSH Public Keys

  %ul.public_keys.dark-list
    =hb 'each arrangedContent' do
      %li
        .title
          %h3.name {{ name }}
          %p ({{ md5_fingerprint }})
          %button.btn.btn-danger(_action='didClickDelete this target="view"') Delete

  =hb 'unless length' do
    .static-text
      %p You have not added any public keys.

  .actions
    %button.btn.btn-primary(_action='didClickAddKey target="view"')
      Add Public Key
    %button.btn(_action='didClickRefresh target="view"')
      Refresh

