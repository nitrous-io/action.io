.container
  {{view AIO.HeaderView}}

  %h2 SSH Public Keys

  %ul.public_keys.dark-list
    =hb 'each arrangedContent' do
      %li
        .title
          %h3.name {{ name }}
          %p ({{ md5_fingerprint }})
          %button.btn.btn-danger(_action='removePublicKey this') Delete

  =hb 'unless length' do
    .dark-list
      .title
        %p You have not added any public keys.

  .panel
    %button.btn.btn-primary(_action='didClickAddKey')
      Add Public Key
    %button.btn(_action='refresh')
      Refresh

