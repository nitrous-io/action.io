.modal-header
  %h3
    Verify Password
.modal-body
  %p
    For security, please enter your current password to update the info.
  {{view Ember.TextField id="current_password" valueBinding="current_password" disabledBinding="saving"}}

.modal-footer
  %button.btn(_action='didClickCancel target="view"')
    Cancel
  %button.btn(_action='didClickOk target="view"')
    OK
