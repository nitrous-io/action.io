.container
  {{view AIO.HeaderView}}

  %h2 Account Settings

  %form.form-horizontal.simple_form
    .darker-panel
      .control-group
        .controls
          .avatar-block
            .image
              %img{ bind: { src: 'gravatarUrl' }}
            .meta
              %h6 {{ email }}
              %a(href="https://gravatar.com" target="_blank") Update Gravatar
      %div{ bind: { class: ':control-group errors.email:error' } }
        %label.control-label(for='email')
          %abbr(title="required") *
          Email
        .controls
          {{view Ember.TextField id="email" valueBinding="email" disabledBinding="saving"}}
          %span.help-inline {{ firstErrors.email }}
      %div{ bind: { class: ':control-group errors.full_name:error' } }
        %label.control-label(for='full_name') Full Name
        .controls
          {{view Ember.TextField id="full_name" valueBinding="full_name" disabledBinding="saving"}}
          %span.help-inline {{ firstErrors.full_name }}
      %div
        %label.control-label(for='password_reset_btn') Password
        .controls
          %button#password_reset_btn.btn(_action='didClickPasswordReset target="view"'){ bind: { disabled: 'resettingPassword' } }
            Send Password Reset Email

    .darker-panel
      %div{ bind: { class: ':control-group' } }
        %label.control-label(for='subscribed_to_monthly_newsletter')
          Email Subscriptions
        .controls
          %label.checkbox(for="subscribed_to_monthly_newsletter")
            {{view Ember.Checkbox id="subscribed_to_monthly_newsletter" valueBinding="user_profile.subscribed_to_monthly_newsletter"  checkedBinding="user_profile.subscribed_to_monthly_newsletter" disabledBinding="saving"}}
            Subscribe to Monthly Newsletter
          %label.checkbox(for="subscribed_to_product_announcements")
            {{view Ember.Checkbox id="subscribed_to_product_announcements" valueBinding="user_profile.subscribed_to_product_announcements" checkedBinding="user_profile.subscribed_to_product_announcements" disabledBinding="saving"}}
            Subscribe to Product Announcements

    =hb 'if hasActiveBillingProfile' do
      .darker-panel
        %div{ bind: { class: ':control-group' } }
          %label.control-label
            Billing
          .controls.billing-info
            .current-plan
              .icon
                %i.icon-archive
              .meta
                Current Plan: {{currentPlanName}} 
                %a(_action='didClickChangePlan target="view"') Change Plan
            .card-details
              .icon
                %i.icon-credit-card
              .meta
                Card: {{currentCardDetails}}
                %a(_action='didClickChangeCreditCard target="view"') Change Credit Card
            .cancel-subscription
              %a.cancel-link(_action='didClickCancelSubscription target="view"') Cancel Subscription
              =hb 'if cancelingSubscription' do
                %span (Please wait...)

    %div{ bind: { class: ':control-group :panel errors.base:error errors.current_password:error' } }
      .controls
        %button.btn.btn-primary(_action='didClickUpdate target="view"'){ bind: { disabled: 'saving' } }
          Update
        %span.help-inline
          {{ firstErrors.base }}

{{view AIO.ChangeCreditCardDialogView}}
