.container
  {{view AIO.HeaderView}}

  %h2 Account Settings

  %h3 User Info

  %form.form-horizontal.simple_form
    %div.darker-panel
      %div.control-group
        %img#gravatar_image{ bind: { src: 'gravatarUrl' }}
      %div{ bind: { class: ':control-group errors.email:error' } }
        %label.control-label(for='email')
          %abbr(title="required") *
          Email
        .controls
          {{view Ember.TextField id="email" valueBinding="email" disabledBinding="saving"}}
          %span.help-inline {{ firstErrors.email }}
      %div{ bind: { class: ':control-group errors.full_name:error' } }
        %label.control-label(for='full_name') Full Name
        .controls
          {{view Ember.TextField id="full_name" valueBinding="full_name" disabledBinding="saving"}}
          %span.help-inline {{ firstErrors.full_name }}
      %div#change_password_link.controls
        %a(_action='didClickChangePassword target="view"')
          Change Password
      %div#password_fields.hide
        %div{ bind: { class: ':control-group errors.password:error' } }
          %label.control-label(for='password')
            New Password
          .controls
            {{view Ember.TextField id="password" type="password" valueBinding="password" disabledBinding="saving"}}
            %span.help-inline {{ firstErrors.password }}
        %div{ bind: { class: ':control-group errors.password_confirmation:error' } }
          %label.control-label(for='password_confirmation')
            Confirm Password
          .controls
            {{view Ember.TextField id="password_confirmation" type="password" valueBinding="password_confirmation" disabledBinding="saving"}}
            %span.help-inline {{ firstErrors.confirm_password }}
    %div{ bind: { class: ':control-group :panel errors.base:error errors.current_password:error' } }
      .controls
        %button.btn.btn-primary(_action='didClickUpdate target="view"'){ bind: { disabledBinding: 'saving' } }
          Update
        %span.help-inline
          {{ firstErrors.base }}
          =hb 'if firstErrors.current_password' do
            Password you entered was invalid.

{{view AIO.VerifyPasswordDialogView}}
