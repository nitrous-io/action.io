.modal-header
  %h3
    Change Credit Card
.modal-body
  {{view AIO.CreditCardView cardBinding="view.card"}}

.modal-footer
  %p {{view.content.errorMessage}}
  %button.btn(_action='didClickCancel target="view"')
    Cancel
  %button.btn.btn-primary(_action='didClickChange target="view"'){ bind: { disabled: 'view.changing' } }
    Change
