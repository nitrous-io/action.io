.modal-header
  %h3
    Are you
    %strong ABSOLUTELY
    sure?
.modal-body
  %p
    This action may put your boxes in delinquent mode.
  %p
    Make sure to terminate the boxes you no longer need, before canceling subscription.
  %hr
    %p
      Please take a moment to let us know why you're cancelling your subscription:
      %iframe(height="468" allowTransparency="true" frameborder="0" scrolling="no" style="width:100%;border:none" src="https://actionio.wufoo.com/embed/z16r4fre12qoi1l/")

.modal-footer
  %button.btn(_action='didClickCancel target="view"')
    No, Take me back
  %button.btn.btn-danger(_action='didClickProceed target="view"'){ bind: { disabled: 'cancelingSubscription' } }
    Yes, Cancel subscription
