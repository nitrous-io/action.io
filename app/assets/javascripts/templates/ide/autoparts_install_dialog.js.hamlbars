.modal-header
  %h3 Install Autoparts
  {{view AIO.IdeManageAutopartsTextField placeholder="Filter available packages" valueBinding="view.searchTerm"}}
.modal-body
  =hb 'if view.loading' do
    %p
      Loading packages, please wait...
    =hb 'else'
    %ul.modal-list
      =hb 'if view.parts' do
        =hb 'each view.parts' do
          {{view AIO.IdePartListingView contentBinding="this"}}
        =hb 'else'
        %p
          No matching parts found.

.modal-footer
  %button.btn(_action='didClickCancel target="view"'){ bind: { disabled: 'saving' } }
    Close
