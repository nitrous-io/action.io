%header{ class: "ide_menu" }
  {{view AIO.IdeMainMenuView controllerBinding="AIO.router.ideMainMenuController"}}

#ide_main
  #top
    #editor
      {{view AIO.IdeEditorView controllerBinding="AIO.router.ideEditorController"}}
    #filetree
      {{view AIO.IdeSidebarView controllerBinding="AIO.router.ideSidebarController"}}

  #console
    {{view AIO.IdeConsoleView controllerBinding="AIO.router.ideConsoleController"}}

