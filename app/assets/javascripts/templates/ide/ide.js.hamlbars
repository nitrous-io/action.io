=hb 'if content.region.enabled' do
  =hb 'if content.region.goingDown' do
    #ide_going_down
      Nitrous.IO is going into maintenance mode soon. Please save your work now and come back later.

  {{view AIO.IdeMainMenuView controllerBinding="AIO.router.ideMainMenuController"}}

  #ide_body
    {{view AIO.IdeEditorView controllerBinding="AIO.router.ideEditorController"}}
    {{view AIO.IdeSidebarView controllerBinding="AIO.router.ideSidebarController"}}
    {{view AIO.IdeCollaborationPaneView controllerBinding="AIO.router.ideCollaborationPaneController"}}
    {{view AIO.IdeConsoleView controllerBinding="AIO.router.ideConsoleController"}}
    {{view AIO.IdeManageCollaboratorsDialogView controllerBinding="AIO.router.ideCollaborationPaneController"}}
    {{view AIO.IdeManageAuthDialogView controllerBinding="AIO.router.ideBasicAuthController"}}
    {{view AIO.IdeManageCustomDomainDialogView controllerBinding="AIO.router.ideCustomDomainController"}}

    {{view AIO.IdeManageAutopartsDialogView controllerBinding="AIO.router.ideAutopartsController"}}

  {{view AIO.IdeRegionNoticeView}}

{{view AIO.IdeMaintenanceNoticeView}}
{{view AIO.FlashMessageView}}
