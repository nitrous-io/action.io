=hb 'if content.region.enabled' do
  =hb 'if content.region.goingDown' do
    #ide_going_down
      Action.IO is going into maintenance mode soon. Please save your work now and come back later.

  {{view AIO.IdeMainMenuView controllerBinding="controllers.ideMainMenu"}}

  #ide_body
    {{view AIO.IdeEditorView controllerBinding="controllers.ideEditor"}}
    {{view AIO.IdeSidebarView controllerBinding="controllers.ideSidebar"}}
    {{view AIO.IdeConsoleView controllerBinding="controllers.ideConsole"}}

  {{view AIO.IdeManageCollaboratorsDialogView controllerBinding="controllers.ideCollaborators"}}
  {{view AIO.IdeRegionNoticeView}}

{{view AIO.IdeMaintenanceNoticeView}}
