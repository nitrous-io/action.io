.modal-header
  %h3 Action.IO is currently under maintenance
.modal-body
  %p
    Please follow our
    %a.link(href='http://twitter.com/actionio') Twitter account for updates
    or email us at
    %a.link(href='mailto:support@action.io') support@action.io
.modal-footer
  %button.btn(_action='didClickCloseIde target="view"')
    Close IDE
