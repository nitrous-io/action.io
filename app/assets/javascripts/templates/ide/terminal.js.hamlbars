=hb 'if content.region.enabled' do
  =hb 'if content.region.goingDown' do
    #ide_going_down
      Nitrous.IO is going into maintenance mode soon. Please save your work now and come back later.

  {{view AIO.IdeMainMenuView controllerBinding="AIO.router.ideMainMenuController" hideMainMenu=true}}

  #ide_body
    {{view AIO.IdeConsoleView controllerBinding="AIO.router.ideConsoleController" alwaysFullScreen=true}}
    {{view AIO.IdeManageAuthDialogView controllerBinding="AIO.router.ideBasicAuthController"}}

  {{view AIO.IdeRegionNoticeView}}

{{view AIO.IdeMaintenanceNoticeView}}

=hb 'unless controller.sftpSocketReady' do
  =hb 'if controller.sftpConnectionLost' do
    {{view AIO.IdeConnectionLostView}}
    =hb 'else'
    #ide_connecting
      Connecting...
