.modal-header
  %h3 Set password for &ldquo;{{ view.content.name }}&rdquo; preview
.modal-body
  %ul.modal-list
    %form.form-horizontal
      %div{bind: { class: ':control-group view.content.errors.auth_username:error view.content.errors.base.error' }}
        %label.control-label(for='box_auth_username') Username:
        .controls
          %span.help-inline
          {{view Ember.TextField id="box_auth_username" placeholder="box-username" valueBinding="view.content.auth_username" disabledBinding="saving"}}
          %span.help-inline {{ firstErrors.auth_username }}
      %div{bind: { class: ':control-group view.content.errors.auth_password:error view.content.errors.base.error' }}
        %label.control-label(for='box_auth_password') Password:
        .controls
          %span.help-inline
          {{view Ember.TextField id="box_auth_password" placeholder="box-password" valueBinding="view.content.auth_password" disabledBinding="saving"}}
          %span.help-inline {{ firstErrors.auth_password }}

      %div{ bind: { class: ':control-group errors.base:error' } }
        .controls
          %button.btn.btn-primary(_action='updateAuthentication'){ bind: { disabled: 'saving' } }
            Update
          %button.btn(_action='hideAuthDialog'){ bind: { disabled: 'saving' } }
            Cancel
          %span.help-inline {{ firstErrors.base }}
