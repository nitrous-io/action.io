#sidebar
  #sidebar_border
  .top.toolbar.btn-toolbar
    .btn-group
      %button.btn(title='Set Home Folder As Root' _action='didClickSetHomeAsRoot target="view"')
        %i.icon-home
      %button.btn(title='Refresh Tree' _action='didClickRefresh target="view"')
        %i.icon-refresh
  .tree(_action='didRightClickBackground on="contextMenu" target="view"')
    %ul
      {{view AIO.IdePathView pathBinding="rootPath"}}
  .bottom.toolbar.btn-toolbar
    %button.btn(disabled=true _action='didClickUpload target="view"')
      %i.icon-upload
      Upload Files
    %button.btn(disabled=true _action='didClickShowHidden target="view"')
      %i.icon-eye-open
      Show Hidden

{{view AIO.IdePathContextMenuView viewName="contextMenuView"}}

