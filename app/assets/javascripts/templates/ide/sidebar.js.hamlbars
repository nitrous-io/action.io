#sidebar
  #sidebar_border
  .top.toolbar
    %input.path(type='text' value='~')
    .btn-group
      %button.btn(disabled=true title='Change Tree Root' _action='didClickChangeRoot target="view"')
        %i.icon-folder-open
      %button.btn(title='Refresh Tree' _action='didClickRefresh target="view"')
        %i.icon-refresh
  .tree
    %ul
      {{view AIO.IdePathView pathBinding="rootPath"}}
  .bottom.toolbar.btn-toolbar
    %button.btn(disabled=true _action='didClickUpload target="view"')
      %i.icon-upload
      Upload Files
    %button.btn(disabled=true _action='didClickShowHidden target="view"')
      %i.icon-eye-open
      Show Hidden

