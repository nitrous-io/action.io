#console_border
%header
  .tabs
    %ul
      =hb 'each content' do
        %li{ bind: { class: 'active' } }
          %a(_action='didClickTab this target="view"')
            .close_tab_button.icon-remove(_action='didClickClose this target="view"')
            %span Console
    .new_tab_button.btn.icon-plus(_action='didClickNew target="view"')
    .fullscreen_button.btn.icon-fullscreen(_action='didClickFullscreen target="view"')

.console_sessions
  =hb 'each content' do
    {{view AIO.IdeConsoleSessionView consoleSessionBinding="this"}}

