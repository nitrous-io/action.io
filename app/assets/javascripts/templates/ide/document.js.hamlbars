.btn-toolbar
  .btn-group
    %button.btn(_action='didClickSave target="view"'){ bind: { disabled: 'view.saving' } }
      %i.icon-download-alt
      Save
  -#.btn-group
    -#%button.btn
      -#%i.icon-search
      -#Find
  .btn-group
    %button.btn.dropdown-toggle(data-toggle='dropdown')
      %span {{ view.modeName }}
      %span.caret
    %ul.dropdown-menu
      =hb 'each view.availableModes' do
        %li
          %a(_action='didSelectMode mode target="view"')
            =hb 'if active' do
              %i.icon-ok
              =hb 'else'
              %i.icon-
            %span {{ name }}

  .btn-group
    %button.btn.dropdown-toggle(data-toggle='dropdown')
      %span
        =hb 'if view.softTabs' do
          Soft Tabs:
          = hb 'else'
          Tab Size:
      %span {{ view.tabSize }}
      %span.caret

    %ul.dropdown-menu
      =hb 'each view.availableTabSizes' do
        %li
          %a(_action='didSelectTabSize size target="view"')
            =hb 'if active' do
              %i.icon-ok
              =hb 'else'
              %i.icon-
            %span {{ size }}

      %li.divider
      %li
        %a(_action='didClickSoftTabToggle target="view"')
          =hb 'if view.softTabs' do
            %i.icon-ok
            =hb 'else'
            %i.icon-
          Soft Tabs (Spaces)

  .btn-group
    %button.btn.dropdown-toggle(data-toggle='dropdown')
      %span.icon-beaker
        Labs

    %ul.dropdown-menu
      %li
        %a(_action='didSelectMatchBrackets target="view"')
          =hb 'if view.matchBrackets' do
            %i.icon-ok
            =hb 'else'
            %i.icon-
          Match Brackets 
      %li
        %a(_action='didSelectAutoCloseBrackets target="view"')
          =hb 'if view.autoCloseBrackets' do
            %i.icon-ok
            =hb 'else'
            %i.icon-
          Auto Close Brackets

.code_editor

