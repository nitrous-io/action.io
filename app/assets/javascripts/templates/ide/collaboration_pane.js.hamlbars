#collaboration_pane.side_pane
  {{view AIO.IdeCollaborationPaneBorderView}}
  .top.toolbar.btn-toolbar
    %span Chat
    .btn-group
      =hb 'view AIO.IdeCollaborationPaneOnlineUsersButton title="Online Users"' do
        %i.icon-group

      %button.btn(title='Hide Chat' _action='didClickHideChat target="view"')
        %i.icon-remove

  =hb 'if controller.users.length' do
    .users.popover.bottom
      .arrow
      .popover-content
        %ul
          =hb 'each user in controller.users' do
            %li
              {{ user }}
              {{view AIO.IdeCollaborationPaneVideoCallButton usernameBinding="user"}}

  .chat
    %ul
      =hb 'each controller.messages' do
        {{view AIO.IdeCollabMessageView contentBinding="this"}}

  .bottom.toolbar.btn-toolbar
    .chat-input
      {{view AIO.IdeCollaborationPaneTextField valueBinding="view.chatFieldText"}}
      %button.btn(_action='didClickSend target="view"')
        Send
