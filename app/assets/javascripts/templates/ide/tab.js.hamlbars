%li{ bind: { class: 'view.content.active' } }
  %a(_action='didClickTab this target="view"'){ bind: { title: 'view.content.tooltip' } }
    %div(_action='didClickClose this target="view"' title='Close Tab'){ bind: { class: ':close_tab_button view.content.clean:icon-remove:icon-asterisk' }}
    %span {{ view.content.title }}

