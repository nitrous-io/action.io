=hb 'if view.hideMainMenu' do
  %h2 {{ AIO.router.ideController.content.name }}
  =hb 'else'
  .primary-nav
    %ul.nav
      =hb 'each view.menu' do
        %li.dropdown
          %a.dropdown-toggle(data-toggle='dropdown')
            %span {{ name }}
          %ul.dropdown-menu
            =hb 'each items' do
              {{view AIO.IdeMenuItemView contentBinding="this"}}
=hb 'unless view.noSecondaryMenu' do
  .secondary-nav
    %ul.nav
      =hb 'unless view.hideMainMenu' do
        %li
          %a.beta-notice(_action='didClickBetaNotice target="view"')
            BETA - Read Me
      %li
        %a(href='#/invites') Invites
      %li
        %a(href='#/boxes')
          Boxes
      %li
        %a(href='#/public_keys')
          Public Keys
      %li.dropdown
        %a.dropdown-toggle(data-toggle='dropdown')
          %span {{ AIO.currentUser.username }}
          %span.caret
        %ul.dropdown-menu
          %li
            %a(href='#/account_settings')
              Account Settings
          %li
            %a(href='/users/sign_out' data-method='delete' rel='nofollow')
              Sign Out

=hb 'if view.hideMainMenu' do
  .alt-nav
    %ul.nav
      =hb 'each view.altMenu' do
        %li.dropdown
          %a.dropdown-toggle(data-toggle='dropdown')
            %span {{ name }}
          %ul.dropdown-menu
            =hb 'each items' do
              {{view AIO.IdeMenuItemView contentBinding="this"}}

#about_nitrousio.modal.hide.fade
  .modal-header
    %h3 About Nitrous.IO
  .modal-body
    %p Nitrous.IO
    %p
      Copyright &copy; 2012-2013
      %a(href='http://www.i18s.com/' target='_blank') Irrational Industries Inc.
      All Rights Reserved.
  .modal-footer
    %button.btn(data-dismiss='modal') Close

#beta_notice.modal.hide.fade
  .modal-header
    %h3 Thanks For Joining Our Beta
  .modal-body
    %p Please keep the following in mind:
    %ol
      %li You are using a beta product. Many features may still be unimplemented or broken.
      %li Do not rely on it for mission-critical tasks, for example in nuclear power plants or a war.
      %li Data loss may happen. Always check in your work to source code repositories.
      %li Please don&rsquo;t abuse your free account.
      %li
        Visit
        %a.link(href='http://help.nitrous.io/' target='_blank') http://help.nitrous.io/
        or email us at
        %a.link(href='mailto:help@nitrous.io' target='_blank') help@nitrous.io
        for bug reports, feature requests and other feedback.
  .modal-footer
    %button.btn(data-dismiss='modal') Okay

