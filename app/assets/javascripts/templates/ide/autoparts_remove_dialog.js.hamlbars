.modal-header
  %h3 Remove Autoparts
  {{view AIO.IdeManageAutopartsTextField placeholder="Filter installed packages" valueBinding="view.searchTerm"}}
.modal-body
  =hb 'if view.loading' do
    %p
      Loading packages, please wait...
    =hb 'else'
    %h4 {{view.partsTypeTitle}}
    %ul.modal-list
      =hb 'if view.parts' do
        =hb 'each view.parts' do
          {{view AIO.IdePartListingView contentBinding="this"}}
        =hb 'else'
        %p
          You have no packages installed,
          %a(_action='didClickAutopartsInstall target="view"') click here
          to install some packages first.

.modal-footer
  %button.btn(_action='didClickCancel target="view"'){ bind: { disabled: 'saving' } }
    Close
