%header
  .tabs
    %ul
      =hb 'each content' do
        %li{ bind: { class: 'active' } }
          %a(_action='didClickTab this target="view"')
            .close_tab_button(_action='didClickClose this target="view"'){ bind: { class: 'closeButtonClass' }}
            %span {{ title }}
    .new_tab_button.btn.icon-plus(_action='didClickNew target="view"')

.ide_document_views
  =hb 'each content' do
    =hb 'if isImageFile' do
      {{view AIO.IdeImageView documentBinding="this" classBinding="active"}}
      =hb 'else'
      {{view AIO.IdeDocumentView documentBinding="this" classBinding="active"}}

{{view AIO.IdeSaveDialogView}}
{{view AIO.IdeConfirmCloseDialogView}}

=hb 'unless controller.sftpSocketReady' do
  #ide_connecting
    Connecting...

