%header
  .tabs
    %ul
      =hb 'each content' do
        %li{ bind: { class: 'active' } }
          %a(_action='didClickTab this target="view"'){ bind: { title: 'tooltip' } }
            %div(_action='didClickClose this target="view"' title='Close Tab'){ bind: { class: ':close_tab_button clean:icon-remove:icon-asterisk' }}
            %span {{ title }}
    .new_tab_button.small_button.btn.icon-plus(_action='didClickNew target="view"' title='New Tab')
    .fullscreen_button.small_button.btn.icon-fullscreen(_action='didClickFullScreen target="view"' title='Toggle Full Screen')
    =hb 'if AIO.router.ideLayoutController.collaborationPaneHidden' do
      .chat_button.small_button.btn.icon-comments(_action='didClickChat target="view"' title='Show Chat')

.ide_document_views
  =hb 'each content' do
    =hb 'if isImageFile' do
      {{view AIO.IdeImageView documentBinding="this" classBinding="active"}}
      =hb 'else'
      {{view AIO.IdeDocumentView documentBinding="this" classBinding="active"}}

{{view AIO.IdeSaveDialogView}}
{{view AIO.IdeConfirmCloseDialogView}}

=hb 'unless controller.sftpSocketReady' do
  #ide_connecting
    Connecting...

