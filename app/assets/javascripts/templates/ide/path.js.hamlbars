=hb 'with view.content' do
  %li
    %a(_action='didClick target="view"')
      =hb 'if directory' do
        =hb 'if expanded' do
          %i.icon-caret-down
          =hb 'else'
          %i.icon-caret-right
        =hb 'else'
        %i.icon-
      %span {{ displayName }}

    =hb 'if expanded' do
      %ul
        {{collection contentBinding="arrangedContent" itemViewClass="AIO.IdePathView"}}

