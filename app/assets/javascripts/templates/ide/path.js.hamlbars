=hb 'with view.path' do
  =hb 'unless editable' do
    {{view AIO.IdePathNameView pathBinding="this"}}
    =hb 'else'
    {{view AIO.IdeEditablePathNameView pathBinding="this"}}

  =hb 'if expanded' do
    %ul
      =hb 'each arrangedContent' do
        =hb 'if controller.hiddenFilesVisible' do
          {{view AIO.IdePathView pathBinding="this"}}
          =hb 'else'
          =hb 'unless hidden' do
            {{view AIO.IdePathView pathBinding="this"}}

