.modal-header
  %h3 Collaborators for &ldquo;{{ AIO.router.ideController.content.name }}&rdquo;
.modal-body
  %p
    This feature is
    = succeed '.' do
      %ins experimental
    Please report any bugs that you encounter.
  %ul.modal-list
    =hb 'each view.content' do
      %li
        %p {{ username }}
        .pull-right
          %button.btn.btn-danger(_action='didClickRemove this target="view"'){ bind: { disabled: 'removing' }}
            Remove
    %li{ bind: { class: ':control-group view.content.errorMessage:error' } }
      {{view AIO.IdeManageCollaboratorsDialogTextField placeholder="username" valueBinding="view.content.newCollaboratorUsername"}}
      %button.btn(_action='didClickAdd target="view"'){ bind: { disabled: 'view.content.saving' }}
        Add
      %span.help-inline {{ view.content.errorMessage }}
  %p
    Please add only those that you absolutely trust as collaborators.
    Collaborators can access and edit any file present in your box
    including your private keys and saved credentials.

.modal-footer
  %button.btn(_action='didClickDone target="view"')
    Done
