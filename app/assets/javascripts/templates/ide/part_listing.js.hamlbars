%div.pull-left
  %h5
    {{ displayProps.name }} {{ version }}
  %p
    {{ displayProps.description }}
  %p.error-message
    {{ view.error }}
.pull-right
  =hb 'if view.servicesView' do
    =hb 'if running' do
      %button.btn.btn-danger(_action='didClickStop this target="view"'){ bind: { disabled: 'view.processing'}}
        {{ view.stopButtonText }}
      =hb 'else'
      %button.btn.btn-primary(_action='didClickStart this target="view"'){ bind: { disabled: 'view.processing'}}
        {{ view.startButtonText }}

    =hb 'else'
    =hb 'if installed' do
      %button.btn.btn-danger(_action='didClickUninstall this target="view"'){ bind: { disabled: 'view.processing'}}
        {{ view.uninstallButtonText }}
      =hb 'else'
      %button.btn.btn-primary(_action='didClickInstall this target="view"'){ bind: { disabled: 'view.processing'}}
        {{ view.installButtonText }}
