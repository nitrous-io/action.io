.pull-left
  %h5
    {{ humanized.name }} {{ version }}
  %p
    {{ humanized.description }}
  %p.error-message
    {{ errorMessage }}
.pull-right
  =hb 'if status' do
    =hb 'if running' do
      %button.btn.btn-primary(_action='didClickStop target="view"'){ bind: { disabled: 'stopping'}}
        {{ view.stopButtonText }}
      =hb 'else'
      %button.btn.btn-primary(_action='didClickStart target="view"'){ bind: { disabled: 'starting'}}
        {{ view.startButtonText }}

  =hb 'if installed' do
    %button.btn.btn-danger(_action='didClickUninstall target="view"'){ bind: { disabled: 'uninstalling'}}
      {{ view.uninstallButtonText }}
    =hb 'else'
    %button.btn.btn-primary(_action='didClickInstall target="view"'){ bind: { disabled: 'installing'}}
      {{ view.installButtonText }}
