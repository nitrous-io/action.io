%div.pull-left
  %h5
    {{ humanized.name }} {{ version }}
  %p
    {{ humanized.description }}
  %p.error-message
    {{ errorMessage }}
.pull-right
  =hb 'if view.inServicesView' do
    =hb 'if running' do
      %button.btn.btn-danger(_action='didClickStop target="view"'){ bind: { disabled: 'processing'}}
        {{ view.stopButtonText }}
      =hb 'else'
      %button.btn.btn-primary(_action='didClickStart target="view"'){ bind: { disabled: 'processing'}}
        {{ view.startButtonText }}

    =hb 'else'
    =hb 'if installed' do
      %button.btn.btn-danger(_action='didClickUninstall target="view"'){ bind: { disabled: 'processing'}}
        {{ view.uninstallButtonText }}
      =hb 'else'
      %button.btn.btn-primary(_action='didClickInstall target="view"'){ bind: { disabled: 'processing'}}
        {{ view.installButtonText }}
