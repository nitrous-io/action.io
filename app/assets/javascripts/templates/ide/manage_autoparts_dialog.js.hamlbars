.modal-header
  %h3 Manage Autoparts
  {{view AIO.IdeManageAutopartsTextField placeholder="Search all packages"}}
  %i {{view.installedPartsCount}} {{view.allPartsCount}}
.modal-body
  =hb 'if view.loading' do
    %p
      Loading packages, please wait...
    =hb 'else'
    %h4 {{view.partsTypeTitle}}
    %ul.modal-list
      =hb 'if view.parts' do
        =hb 'each view.parts' do
          {{view AIO.PartListingView contentBinding="this"}}
        =hb 'else'
        %p
          No matching parts found.

.modal-footer
  %button.btn(_action='didClickCancel target="view"'){ bind: { disabled: 'saving' } }
    Close
