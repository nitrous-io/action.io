.modal-header
  %h3 Manage Packages
  {{view Em.TextField placeholder="Filter Packages" valueBinding="view.searchTerm"}}

  %ul{ bind: { class: 'view.hidePager:hide:parts-pager' } }
    %li
      %button.btn(_action='didClickPrevious target="view"'){ bind: { disabled: 'view.inFirstPage' } }
        &#10094;
    %li
      %button.btn(_action='didClickNext target="view"'){ bind: { disabled: 'view.inLastPage' } }
        &#10095;

  %label.checkbox(for="filter_installed_packages")
    {{view Ember.Checkbox id="filter_installed_packages" checkedBinding="view.showInstalled"}}
    Show only installed packages

.modal-body
  =hb 'if view.loading' do
    %p
      Loading packages, please wait...
    =hb 'else'
    %ul.parts-list
      =hb 'if view.visibleParts' do
        =hb 'each view.visibleParts' do
          {{view AIO.IdePartListingView contentBinding="this"}}
        =hb 'else'
        %p
          Hmm.. We don't have that one yet.
          %a.link(href="mailto:support@nitrous.io")Send us a note
          or
          %a.link(href="http://github.com/nitrous-io/autoparts")a pull request

.modal-footer
  %button.btn(_action='didClickCancel target="view"')
    Close
