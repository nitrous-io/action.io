.container
  {{view AIO.HeaderView noMenu=true}}

  .intro-content
    .info-container
      %h2
        Earn More N2O
        %span.steps Step 2 of 2

      %p We start you off with a basic box for free. Upgrading it or creating a new box requires N2O &mdash; it's easy to earn more!

      .action-container
        .bonus-n2o
          {{ outlet 'n2oBonus' }}

      #box-state
        %div{ bind: { class: ':stateOrb state' } }
        %span {{ name }}
        is
        %span{ bind: { class: ':state state' } } {{ state }}
        %span.meter.pull-right
          {{view AIO.N2OView}}

      .panel.clearfix
        %button.btn.btn-primary.pull-right(_action='didClickNextScreen target="view"')
          Okay, Take Me to my Box!
