.container
  {{view AIO.HeaderView noMenu=true}}

  .intro-content
    .ileft
      .info-container
        %h2 Getting Started on Nitrous.IO
        %p
          :markdown
            A *box* is your _development environment_ on the Nitrous.IO platform.
        %p
          Creating one is lightning fast &mdash; pick a language or framework, give your box a name, and go!

    .iright
      .action-container
        {{view AIO.BoxFormView}}

  .panel.clearfix
    %button.btn.btn-primary.pull-right(_action='didClickNextScreen target="view"'){ bind: { disabled: 'view.createBoxButtonDisabled' } }
      Next
