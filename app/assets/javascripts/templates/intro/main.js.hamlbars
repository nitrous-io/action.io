.modal-header
  %h3 Welcome {{ view.content.user.username }}!
.modal-body
  %p
    Your account is pumped with
    %em XXX N2O
    to get started.

  %p
    You can earn
    %strong more N2O
    by completing  the following steps:

    %ul
      %li
        %a(_action="didClickCompleteProfile")
          Complete Profile
          %em
            (XX N2O)

      %li
        %a(_action="didClickConnectGooglePlus")
          Connect Google+
          %em
            (XX N2O)

      %li
        %a(_action="didClickConnectGithub")
          Connect GitHub
          %em
            (XX N2O)

      %li
        %a(_action="didClickInviteFirends")
          Invite Friends and Colleagues
          %em
            (XX N2O)

.modal-footer
  %button.btn(_action='didClickDone target="view"')
    OK
