.container
  {{view AIO.HeaderView}}

  %h2 Snapshots of {{ box.name }}

  %ul.dark-list
    =hb 'each content' do
      %li
        .title
          %h3.name {{ name }}

          =hb 'if requested' do
            %p.time started {{ humanizedCreatedAt }}
            %button.btn(disabled=true) Queued...
          =hb 'if initiated' do
            %p.time started {{ humanizedCreatedAt }}
            %button.btn(disabled=true) Creating snapshot...
          =hb 'if completed' do
            =hb 'if completed_at' do
              %p.time completed {{ humanizedCompletedAt }}
              =hb 'else'
              %p.time started {{ humanizedCreatedAt }}
            %button.btn.btn-danger(_action='didClickDelete this target="view"') Delete

    =hb 'unless length' do
      .dark-list
        .title
          %p You have not taken any snapshots of this box.

  .panel
    %button.btn.btn-primary(_action='didClickSnapshot target="view"')
      Take snapshot
    %button.btn(_action='didClickBack target="view"')
      Back
