.container
  {{view AIO.HeaderView}}

  %h2
    Create Snapshot

  %form.form-horizontal
    %div{ bind: { class: ':control-group errors.name:error' } }
      %label.control-label(for='snapshot_name') Name
      .controls
        {{view Ember.TextField id="snapshot_name" placeholder="box-snapshot" valueBinding="name" disabledBinding="saving"}}
        %span.help-inline {{ firstErrors.name }}

    %div{ bind: { class: ':control-group errors.description:error' } }
      %label.control-label(for='snapshot_description') Description
      .controls
        {{view Ember.TextArea id="snapshot_description" valueBinding="description" disabledBinding="saving"}}
        %span.help-inline {{ firstErrors.description }}

    %div{ bind: { class: ':control-group errors.base:error' } }
      .controls
        %button.btn.btn-primary(_action='save'){ bind: { disabled: 'isSaving' } }
          Create Snapshot
        %button.btn(_action='cancel'){ bind: { disabled: 'isSaving' } }
          Cancel
        %span.help-inline {{ firstErrors.base }}
