.container
  {{view AIO.HeaderView}}

  %h2 Fill Station

  %ul.fills
    %li.fillbar#invites
      %a
        %span.pull-right
          10
          %i.icon-bolt
        %i.icon-group.ftype
        Invite Friends &amp; Colleagues

    /* Give li "connected" class right after connecting, transitions to completed */
    %li.fillbar.connected#github
      %a
        %span.pull-right
          %i.icon-ok
        %i.icon-github.ftype
        Connect Github

    %li.fillbar#google
      %a
        %span.pull-right
          5
          %i.icon-bolt
        %i.icon-google-plus.ftype
        Connect Google

    %li.fillbar#twitter
      %a
        %span.pull-right
          5
          %i.icon-bolt
        %i.icon-twitter.ftype
        Connect Twitter

    %li.fillbar#facebook
      %a
        %span.pull-right
          5
          %i.icon-bolt
        %i.icon-facebook.ftype
        Connect Facebook

    %li.fillbar#linkedin
      %a
        %span.pull-right
          5
          %i.icon-bolt
        %i.icon-linkedin.ftype
        Connect LinkedIn
