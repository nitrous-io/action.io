=hb 'if content.region.enabled' do
  =hb 'if content.region.goingDown' do
    #ide_going_down
      Nitrous is going into maintenance mode soon. Please save your work now and come back later.


  .div.alert.slide.alert-info{ style: 'margin-bottom: 0px; border-radius: 0px;'}
    Nitrous Lite will be shut down completely on
    = succeed "." do
      %strong July 15th, 2015
    %a(href="https://pro.nitrous.io") Nitrous Pro
    now has an unlimited free tier.  Please
    = hb 'if App.subscription.active' do
      Please
      %a(href="http://docs.nitrous.io/v1.0/docs/migrate-your-box-to-nitrous-pro") click here
      to read more about migration options.

  {{view App.IdeMainMenuView controllerBinding="App.router.ideMainMenuController"}}

  #ide_body
    -#TODO: this should really be done using outlets and route#renderTemplate
    {{view App.IdeEditorView controllerBinding="App.router.ideEditorController"}}
    {{view App.IdeSidebarView controllerBinding="App.router.ideSidebarController"}}
    {{view App.IdeCollaborationPaneView controllerBinding="App.router.ideCollaborationPaneController"}}
    {{view App.IdeConsoleView controllerBinding="App.router.ideConsoleController"}}
    {{view App.IdeManageCollaboratorsDialogView controllerBinding="App.router.ideCollaborationPaneController"}}
    {{view App.IdeManageAuthDialogView controllerBinding="App.router.ideBasicAuthController"}}

    {{view App.IdeManageAutopartsDialogView controllerBinding="App.router.ideAutopartsController"}}
    {{view App.IdeFindInProjectDialogView controllerBinding="controllers.ideFindInProject"}}
    {{view App.IdeFileFinderDialogView controllerBinding="controllers.ideFileFinder"}}

  {{view App.IdeRegionNoticeView}}

{{view App.IdeMaintenanceNoticeView}}
{{view App.FlashMessageView}}

=hb 'unless controller.sftpSocketReady' do
  =hb 'if controller.sftpConnectionLost' do
    {{view App.IdeConnectionLostView}}
    =hb 'else'
    #ide_connecting
      Connecting...
