= hb 'with view.document' do
  .summary
    %h4 {{ status }}
  .search-results-container
    .search-results
      =hb 'each result in results' do
        %h4.result-title
          %i.fa.fa-file-text-o
          {{ result.filename }}&nbsp;<span class="match-count">({{ result.matchCount }})</span>
        =hb 'each line in result.lines' do
          %a.search-line(_action='didClickResult result.filename line target="view"')
            %span.line-number
              {{ line.lineNumber }}
            = # TODO fix when Handlebars whitespace control is in place
            = # https://github.com/emberjs/ember.js/issues/4305
            :plain
              <span class="line-text">{{!
                }}{{#each line.lineParts }}{{#if match }}{{!
                  }}<span class="search-match">{{ text }}</span>{{!
                  }}{{else}}{{!
                  }}<span>{{ text }}</span>{{!
                  }}{{/if}}{{!
                }}{{/each}}{{!
              }}</span>
