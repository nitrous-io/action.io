=hb 'if view.hideMainMenu' do
  %h2 {{ App.router.boxIdeController.content.name }}
  =hb 'else'
  .primary-nav
    %ul.nav
      =hb 'each view.menu' do
        %li.dropdown
          %a.dropdown-toggle(data-toggle='dropdown')
            %span {{ name }}
          {{view App.IdeMenuView contentBinding="this"}}
.secondary-nav
  %ul.nav
    %li
      %a(href='#/invites') Invites
    %li
      %a(href='#/boxes')
        Boxes
    %li
      %a(href='#/public_keys')
        Public Keys
    %li.dropdown
      %a.dropdown-toggle(data-toggle='dropdown')
        %span {{ App.currentUser.username }}
        %span.caret
      %ul.dropdown-menu
        %li
          %a(href='#/account')
            Account Settings
        %li
          %a(href='/users/sign_out' data-method='delete' rel='nofollow')
            Sign Out

=hb 'if view.hideMainMenu' do
  .alt-nav
    %ul.nav
      =hb 'each view.altMenu' do
        %li.dropdown
          %a.dropdown-toggle(data-toggle='dropdown')
            %span {{ name }}
          %ul.dropdown-menu
            =hb 'each items' do
              {{view App.IdeMenuItemView contentBinding="this"}}

#about_nitrousio.modal.hide.fade
  .modal-header
    %h3 About Nitrous.IO
  .modal-body
    %p Nitrous.IO
    %p
      Copyright &copy; 2012-{{ view.currentYear }}
      Irrational Industries Inc. d.b.a. Nitrous.IO.
      %br
      All Rights Reserved.
  .modal-footer
    %button.btn(data-dismiss='modal') Close
