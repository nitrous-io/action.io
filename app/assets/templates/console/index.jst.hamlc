.container
  #sidebar
    %header
      %h3 Your Boxes (4)
      .actions
        %button.btn.btn-success New Box
    %div
      %ul
        %li
          %a(href='#')
            .status_orb.suspended(title='suspended')
              %span (Suspended)
            %p twilight-wolf-27
            %span.label.notification_count(title='17 unread notifications')
              17
        %li.active
          %a(href='#')
            .status_orb.running(title='Running')
              %span (Running)
            %p fragrant-wind-69
        %li
          %a(href='#')
            .status_orb.new(title='New')
              %span (New)
            %p patient-wildflower-56
        %li
          %a(href='#')
            .status_orb.shutdown(title='Shut Down')
              %span (Shut Down)
            %p morning-calm-17
  #content
    %header
      %h3
        fragrant-wind-69
      .actions
        %button.btn Settings
        %button.btn Suspend
        %button.btn.btn-danger Shut Down
    %div
      something goes here.
