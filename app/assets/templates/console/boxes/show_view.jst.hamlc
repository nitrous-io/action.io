%header
  %h2
    = @name
  .actions
    - switch @state
      - when 'stopped'
        %button#start_box_button.btn Start
        -#%button#terminate_box_button.btn.btn-danger Terminate
      - when 'running'
        %button#terminal_button.btn.btn-primary Open Terminal
        %button#suspend_box_button.btn Suspend
        %button#stop_box_button.btn.btn-danger Shut Down
      - when 'suspended'
        %button#resume_box_button.btn Resume

.table-view
  %ul
    %li
      %p
        %span.title
          State
        %span.status-orb{ class: @state, title: @state }
          %span
            (#{@state})
        = @state
    %li
      %p
        %span.title
          Host
        = @host
    %li
      %p
        %span.title
          Port
        = @port
    %li
      %p
        %span.title
          Region
        = @region.description
    %li
      %p
        %span.title
          Template
        = @boxTemplate.name

