%header
  %h2
    = @name
  .actions
    %button.btn Settings
    %button.btn Suspend
    %button.btn.btn-danger Shut Down
.table-view
  %ul
    %li
      %p
        %span.title
          Status
        %span.status-orb{ class: @status, title: @status }
          %span
            (#{@status})
        = @status
    %li
      %p
        %span.title
          Host
        = @host
    %li
      %p
        %span.title
          Port
        = @port
    %li
      %p
        %span.title
          Region
        = @region.description
    %li
      %p
        %span.title
          Template
        = @boxTemplate.name

