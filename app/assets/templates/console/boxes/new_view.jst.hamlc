%header
  %h2
    New Box
%div
  %form.form-inline
    %fieldset
      .control-group
        %label.control-label(for='box_name') Name
        .controls
          %input(type='text' id='box_name' name='name')
      .control-group
        %label.control-label(for='box_region_id') Region
        .controls
          %select(id='box_region_id' name='region_id')
            - for region in @regions
              %option{ value: region.id }
                = region.description
      .control-group
        %label.control-label(for='box_box_template_id') Template
        .controls
          %select(id='box_box_template_id' name='box_template_id')
            - for box_template in @box_templates
              %option{ value: box_template.id }
                = box_template.name
      .control-group
        .controls
          %button.submit.btn.btn-primary Create Box

