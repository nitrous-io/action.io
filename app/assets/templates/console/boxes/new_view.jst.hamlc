%header
  %h2
    New Box
%div
  %form.form-inline
    %fieldset
      .control-group
        %label.control-label(for='box_name') Name
        .controls
          %input(type='text' id='box_name' name='name')
      .control-group
        %label.control-label(for='box_region_id') Region
        .controls
          %select(id='box_region_id' name='region_id')
            - for region in @regions
              %option{ value: region.id }
                = region.description
      .control-group
        %label.control-label(for='box_box_template_id') Template
        .controls
          %select(id='box_box_template_id' name='box_template_id')
            - for box_template in @box_templates
              %option{ value: box_template.id }
                = box_template.name
          %button#customize_button.btn Customize...
      #customize_form
        .control-group
          %label.control-label Operating System
          .controls
            %select
              %option Ubuntu 11.10 Oneiric 64-bit
              %option Ubuntu 11.10 Oneiric 32-bit
              %option Ubuntu 10.04 Lucid 64-bit
              %option Ubuntu 10.04 Lucid 32-bit
        .control-group.packages
          .controls
            %h4 Languages &amp; Frameworks
            .checkbox
              %input(type='checkbox' checked='checked')
              Ruby
              %select
                %option 1.9.3-p194
                %option 1.9.2-p320
                %option 1.8.7-p358
              .checkbox
                %input(type='checkbox' checked='checked')
                Rails
                %select
                  %option 3.2.3
                  %option 3.1.4
                  %option 3.0.12
                  %option 2.3.14
              .checkbox
                %input(type='checkbox')
                Sinatra
                %select
                  %option 1.3.2
                  %option 1.2.8
            .checkbox
              %input(type='checkbox')
              Node.js
              %select
                %option 0.6.15
                %option 0.5.9
                %option 0.4.9
              .checkbox
                %input(type='checkbox')
                Express
                %select
                  %option 2.5.9
                  %option 2.4.7
              .checkbox
                %input(type='checkbox')
                Coffee-Script
                %select
                  %option 1.3.1
            .checkbox
              %input(type='checkbox')
              Python
              %select
                %option 3.2.3
                %option 3.1.5
                %option 3.0.1
                %option 2.7.3
                %option 2.6.8
              .checkbox
                %input(type='checkbox')
                Django
                %select
                  %option 1.4
              .checkbox
                %input(type='checkbox')
                web2py
                %select
                  %option 1.99.7
              .checkbox
                %input(type='checkbox')
                Tornado
                %select
                  %option 2.1.1
            %h4 Databases
            .checkbox
              %input(type='checkbox' checked='checked')
              PostgreSQL
              %select
                %option 9.1.3
            .checkbox
              %input(type='checkbox')
              MySQL
              %select
                %option 5.2.2
            .checkbox
              %input(type='checkbox' checked='checked')
              SQLite
              %select
                %option 3.7.11
            .checkbox
              %input(type='checkbox')
              MongoDB
              %select
                %option 2.0.3
            .checkbox
              %input(type='checkbox')
              CouchDB
              %select
                %option 1.1.1
            .checkbox
              %input(type='checkbox')
              Redis
              %select
                %option 2.4.8
            .checkbox
              %input(type='checkbox')
              Memcached
              %select
                %option 1.4.13
            %h4 Libraries
            .checkbox
              %input(type='checkbox')
              ImageMagick
              %select
                %option 6.7.5-7
            .checkbox
              %input(type='checkbox')
              Qt
              %select
                %option 4.8.1
            %h4 Tools
            .checkbox
              %input(type='checkbox' checked='checked')
              Git
              %select
                %option 1.7.10
            .checkbox
              %input(type='checkbox')
              Mercurial
              %select
                %option 2.1.2
      .control-group
        .controls
          %button.submit.btn.btn-primary Create Box

